<View
    x:Class="AxeDemo.Demos.StyleDemos.RadiusView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AxeDemo.Demos.StyleDemos"
    x:DataType="local:RadiusView_Model" Design.DataContext="{x:Static local:RadiusView_Model.Design}">
    <ScrollViewer>
        <PanelExt Classes="DemoPan">
            <TextBlock Classes="DemoInfo" Text="Radius" />
            <PanelExt Classes="DemoPanChild" Mode="Wrap">
                <Border Width="100" Height="100" BorderThickness="1" CornerRadius="{ThemeRadius XS}" Background="{ThemeBrush Black, Opacity=0.3}">
                    <TextBlock Text="XS" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush Black, Opacity=0.3}">
                    <TextBlock Text="MD" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" CornerRadius="{ThemeRadius LG}" Background="{ThemeBrush Black, Opacity=0.3}">
                    <TextBlock Text="LG" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" CornerRadius="{ThemeRadius XL}" Background="{ThemeBrush Black, Opacity=0.3}">
                    <TextBlock Text="XL" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" CornerRadius="{ThemeRadius XL2}" Background="{ThemeBrush Black, Opacity=0.3}">
                    <TextBlock Text="XL2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" CornerRadius="{ThemeRadius XL3}" Background="{ThemeBrush Black, Opacity=0.3}">
                    <TextBlock Text="XL3" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" CornerRadius="{ThemeRadius XL4}" Background="{ThemeBrush Black, Opacity=0.3}">
                    <TextBlock Text="XL4" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
            </PanelExt>
        </PanelExt>
    </ScrollViewer>
</View>
