                    <Border Classes="Color" Background="{ThemeBrush Blue950}" />
                    <!-- Indigo -->
                    <Border Classes="Color" Background="{ThemeBrush Indigo50}" />
                    <Border Classes="Color" Background="{ThemeBrush Indigo100}" />
                    <Border Classes="Color" Background="{ThemeBrush Indigo200}" />
                    <Border Classes="Color" Background="{ThemeBrush Indigo300}" />
                    <Border Classes="Color" Background="{ThemeBrush Indigo400}" />
                    <Border Classes="Color" Background="{ThemeBrush Indigo500}" />
