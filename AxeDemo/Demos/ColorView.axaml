                    <Border Classes="Color" Background="{ThemeBrush Purple950}" />
                    <!-- Fuchsia -->
                    <Border Classes="Color" Background="{ThemeBrush Fuchsia50}" />
                    <Border Classes="Color" Background="{ThemeBrush Fuchsia100}" />
                    <Border Classes="Color" Background="{ThemeBrush Fuchsia200}" />
                    <Border Classes="Color" Background="{ThemeBrush Fuchsia300}" />
