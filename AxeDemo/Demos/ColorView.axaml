<View
    x:Class="AxeDemo.Demos.ColorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AxeDemo.Demos"
    xmlns:lang="clr-namespace:Axe.I18N.Core;assembly=Axe.I18N"
    x:DataType="local:ColorView_Model" Design.DataContext="{x:Static local:ColorView_Model.Design}">
    <View.Styles>
        <Style Selector="StackPanel.Boxs">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Spacing" Value="5" />
        </Style>
        <Style Selector="WrapPanel.ColorBox">
            <Setter Property="ItemSpacing" Value="5" />
            <Setter Property="LineSpacing" Value="5" />
        </Style>
        <Style Selector="Border.Color">
            <Setter Property="BorderBrush" Value="{ThemeBrush Black, Opacity=0.1}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeRadius MD}" />
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="Border.Shadow">
            <Setter Property="BorderBrush" Value="{ThemeBrush Black, Opacity=0.1}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeRadius MD}" />
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="60" />
        </Style>
    </View.Styles>
    <Grid RowDefinitions="Auto *">
        <ScrollViewer Grid.Row="1" Width="660">
            <StackPanel Classes="Boxs">
                <!-- Langs -->
                <StackPanel Spacing="12" Margin="12">
                    <TextBlock Text="Native Name" FontWeight="Bold" />
                    <TextBlock Text="{LangName {x:Static lang:LangType.en}}" />
                    <TextBlock Text="{LangName {x:Static lang:LangType.zh_Hans}}" />
                    <TextBlock Text="Lang Key" FontWeight="Bold" />
                    <TextBlock Text="{Lang NotKey}" />
                </StackPanel>
                <!-- Refs -->
                <WrapPanel Classes="ColorBox">
                    <Border Classes="Color" CornerRadius="{ThemeRadius XS}" Background="{ThemeBrush Window_Background}" />
                </WrapPanel>
                <!-- Radius -->
                <WrapPanel Classes="ColorBox">
                    <Border Classes="Color" CornerRadius="{ThemeRadius XS}" Background="{ThemeBrush Black, Opacity=0.3}" />
                    <Border Classes="Color" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush Black, Opacity=0.3}" />
                    <Border Classes="Color" CornerRadius="{ThemeRadius LG}" Background="{ThemeBrush Black, Opacity=0.3}" />
                    <Border Classes="Color" CornerRadius="{ThemeRadius XL}" Background="{ThemeBrush Black, Opacity=0.3}" />
                    <Border Classes="Color" CornerRadius="{ThemeRadius XL2}" Background="{ThemeBrush Black, Opacity=0.3}" />
                    <Border Classes="Color" CornerRadius="{ThemeRadius XL3}" Background="{ThemeBrush Black, Opacity=0.3}" />
                    <Border Classes="Color" CornerRadius="{ThemeRadius XL4}" Background="{ThemeBrush Black, Opacity=0.3}" />
                </WrapPanel>
                <!-- Shadows -->
                <WrapPanel Classes="ColorBox">
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow XS2, BrushKey=Teal400}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White, Opacity=0.1}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow XS, BrushKey=Teal400}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White, Opacity=0.1}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow MD, BrushKey=Teal400}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White, Opacity=0.1}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow LG, BrushKey=Teal400}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White, Opacity=0.1}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow XL, BrushKey=Teal400}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White, Opacity=0.1}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow XL2, BrushKey=Teal400}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White, Opacity=0.1}" />
                </WrapPanel>
                <WrapPanel Classes="ColorBox">
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow XS2}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow XS}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow MD}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow LG}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow XL}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow XL2}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                </WrapPanel>
                <WrapPanel Classes="ColorBox">
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow InsetXS2}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow InsetXS}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow InsetSM}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                </WrapPanel>
                <WrapPanel Classes="ColorBox">
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow DropXS}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow DropMD}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow DropLG}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow DropXL}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                    <Border Classes="Shadow" BoxShadow="{ThemeShadow DropXL2}" CornerRadius="{ThemeRadius MD}" Background="{ThemeBrush White}" />
                </WrapPanel>
                <!-- Fonts -->
                <TextBlock FontFamily="{ThemeFont Sans}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Serif}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Mono}" Text="The quick brown fox jumps over the lazy dog" />
                <!-- FontTracking -->
                <TextBlock FontFamily="{ThemeFont Sans}" LetterSpacing="{ThemeFontTracking Tighter}" FontWeight="{ThemeFontWeight Normal}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" LetterSpacing="{ThemeFontTracking Tight}" FontWeight="{ThemeFontWeight Normal}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" LetterSpacing="{ThemeFontTracking Normal}" FontWeight="{ThemeFontWeight Normal}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" LetterSpacing="{ThemeFontTracking Wide}" FontWeight="{ThemeFontWeight Normal}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" LetterSpacing="{ThemeFontTracking Wider}" FontWeight="{ThemeFontWeight Normal}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" LetterSpacing="{ThemeFontTracking Widest}" FontWeight="{ThemeFontWeight Normal}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <!-- FontWeights -->
                <TextBlock FontFamily="{ThemeFont Sans}" FontWeight="{ThemeFontWeight Thin}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontWeight="{ThemeFontWeight Extralight}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontWeight="{ThemeFontWeight Light}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontWeight="{ThemeFontWeight Normal}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontWeight="{ThemeFontWeight Medium}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontWeight="{ThemeFontWeight Semibold}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontWeight="{ThemeFontWeight Bold}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontWeight="{ThemeFontWeight Extrabold}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontWeight="{ThemeFontWeight Black}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <!-- FontSizes -->
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize SM}" LineHeight="{ThemeFontHeight SM}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize LG}" LineHeight="{ThemeFontHeight LG}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize XL}" LineHeight="{ThemeFontHeight XL}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize XL2}" LineHeight="{ThemeFontHeight XL2}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize XL3}" LineHeight="{ThemeFontHeight XL3}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize XL4}" LineHeight="{ThemeFontHeight XL4}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize XL5}" LineHeight="{ThemeFontHeight XL5}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize XL6}" LineHeight="{ThemeFontHeight XL6}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize XL7}" LineHeight="{ThemeFontHeight XL7}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize XL8}" LineHeight="{ThemeFontHeight XL8}" Text="The quick brown fox jumps over the lazy dog" />
                <TextBlock FontFamily="{ThemeFont Sans}" FontSize="{ThemeFontSize XL9}" LineHeight="{ThemeFontHeight XL9}" Text="The quick brown fox jumps over the lazy dog" />
                <!-- Colors -->
                <WrapPanel Classes="ColorBox">
                    <!-- Red -->
                    <Border Classes="Color" Background="{ThemeBrush Red50}" />
                    <Border Classes="Color" Background="{ThemeBrush Red100}" />
                    <Border Classes="Color" Background="{ThemeBrush Red200}" />
                    <Border Classes="Color" Background="{ThemeBrush Red300}" />
                    <Border Classes="Color" Background="{ThemeBrush Red400}" />
                    <Border Classes="Color" Background="{ThemeBrush Red500}" />
                    <Border Classes="Color" Background="{ThemeBrush Red600}" />
                    <Border Classes="Color" Background="{ThemeBrush Red700}" />
                    <Border Classes="Color" Background="{ThemeBrush Red800}" />
                    <Border Classes="Color" Background="{ThemeBrush Red900}" />
                    <Border Classes="Color" Background="{ThemeBrush Red950}" />
                    <!-- Orange -->
                    <Border Classes="Color" Background="{ThemeBrush Orange50}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange100}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange200}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange300}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange400}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange500}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange600}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange700}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange800}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange900}" />
                    <Border Classes="Color" Background="{ThemeBrush Orange950}" />
                    <!-- Amber -->
                    <Border Classes="Color" Background="{ThemeBrush Amber50}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber100}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber200}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber300}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber400}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber500}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber600}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber700}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber800}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber900}" />
                    <Border Classes="Color" Background="{ThemeBrush Amber950}" />
                    <!-- Yellow -->
                    <Border Classes="Color" Background="{ThemeBrush Yellow50}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow100}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow200}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow300}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow400}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow500}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow600}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow700}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow800}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow900}" />
                    <Border Classes="Color" Background="{ThemeBrush Yellow950}" />
                    <!-- Lime -->
                    <Border Classes="Color" Background="{ThemeBrush Lime50}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime100}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime200}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime300}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime400}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime500}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime600}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime700}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime800}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime900}" />
                    <Border Classes="Color" Background="{ThemeBrush Lime950}" />
                    <!-- Green -->
                    <Border Classes="Color" Background="{ThemeBrush Green50}" />
                    <Border Classes="Color" Background="{ThemeBrush Green100}" />
                    <Border Classes="Color" Background="{ThemeBrush Green200}" />
                    <Border Classes="Color" Background="{ThemeBrush Green300}" />
                    <Border Classes="Color" Background="{ThemeBrush Green400}" />
                    <Border Classes="Color" Background="{ThemeBrush Green500}" />
                    <Border Classes="Color" Background="{ThemeBrush Green600}" />
                    <Border Classes="Color" Background="{ThemeBrush Green700}" />
                    <Border Classes="Color" Background="{ThemeBrush Green800}" />
                    <Border Classes="Color" Background="{ThemeBrush Green900}" />
                    <Border Classes="Color" Background="{ThemeBrush Green950}" />
                    <!-- Emerald -->
                    <Border Classes="Color" Background="{ThemeBrush Emerald50}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald100}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald200}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald300}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald400}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald500}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald600}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald700}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald800}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald900}" />
                    <Border Classes="Color" Background="{ThemeBrush Emerald950}" />
                    <!-- Teal -->
                    <Border Classes="Color" Background="{ThemeBrush Teal50}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal100}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal200}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal300}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal400}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal500}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal600}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal700}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal800}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal900}" />
                    <Border Classes="Color" Background="{ThemeBrush Teal950}" />
                    <!-- Cyan -->
                    <Border Classes="Color" Background="{ThemeBrush Cyan50}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan100}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan200}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan300}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan400}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan500}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan600}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan700}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan800}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan900}" />
                    <Border Classes="Color" Background="{ThemeBrush Cyan950}" />
                    <!-- Sky -->
                    <Border Classes="Color" Background="{ThemeBrush Sky50}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky100}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky200}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky300}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky400}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky500}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky600}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky700}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky800}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky900}" />
                    <Border Classes="Color" Background="{ThemeBrush Sky950}" />
                    <!-- Blue -->
                    <Border Classes="Color" Background="{ThemeBrush Blue50}" />
                    <Border Classes="Color" Background="{ThemeBrush Blue100}" />
