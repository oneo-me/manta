                    <Border Classes="Color" Background="{ThemeBrush Fuchsia950}" />
                    <!-- Pink -->
                    <Border Classes="Color" Background="{ThemeBrush Pink50}" />
                    <Border Classes="Color" Background="{ThemeBrush Pink100}" />
                    <Border Classes="Color" Background="{ThemeBrush Pink200}" />
                    <Border Classes="Color" Background="{ThemeBrush Pink300}" />
