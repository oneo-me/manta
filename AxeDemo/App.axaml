<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AxeDemo.App"
    RequestedThemeVariant="Default">
    <Application.Styles>
        <AxeVariables />
        <AxeReactive />
        <AxeControls />
        <StyleInclude Source="Styles/@Styles.axaml" />
        <Style>
            <Style.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <MergeResourceInclude Source="/Controls/IconControl.axaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Style.Resources>
        </Style>
    </Application.Styles>
</Application>
