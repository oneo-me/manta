<View
    x:Class="AxeDemo.Views.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AxeDemo.Views"
    x:DataType="local:Main_Model">
    <Design.DataContext>
        <local:Main_Model />
    </Design.DataContext>
    <Grid RowDefinitions="Auto *">
        <Border Grid.Row="0" x:Name="TitleBar" Background="{ThemeBrush Background, Opacity=0.4}" BorderBrush="{ThemeBrush BorderBrush}" BorderThickness="{ThemeThickness Normal, Filter=Bottom}">
            <Grid ColumnDefinitions="* Auto">
                <TitleBarButtons x:Name="TitleBarButtons" Grid.Column="1" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{ThemeBrush Background}" />
    </Grid>
</View>
