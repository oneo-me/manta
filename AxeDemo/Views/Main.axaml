<View
    x:Class="AxeDemo.Views.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AxeDemo.Views"
    x:DataType="local:Main_Model" Design.DataContext="{x:Static local:Main_Model.Design}">
    <Grid RowDefinitions="Auto *">
        <ViewModelHost Grid.Row="1" Background="{ThemeBrush Background}" ViewModel="{Binding RegionManager.SelectedItem}" />
        <Border Grid.Row="0" x:Name="TitleBar" Background="{ThemeBrush Primary, Opacity=0.03}" BorderBrush="{ThemeBrush BorderBrush}" BorderThickness="{ThemeThickness Normal, Filter=Bottom}">
            <Grid ColumnDefinitions="* Auto Auto">
                <TabStrip Classes="RootTab" Grid.Column="0" ItemsSource="{Binding RegionManager.Items}" SelectedItem="{Binding RegionManager.SelectedItem}">
                    <TabStrip.ItemTemplate>
                        <DataTemplate>
                            <PanelExt Mode="Horizontal" Spacing="8">
                                <IconControl IconSize="18" IconSource="{Binding Icon}" Margin="0 -10" VerticalAlignment="Center" />
                                <TextBlock Text="{Lang {Binding Header}}" VerticalAlignment="Center" />
                            </PanelExt>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
                <PanelExt Grid.Column="1" Mode="Horizontal">
                    <TitleBarButton>
                        <PanelExt Mode="Horizontal" Spacing="8">
                            <IconControl IconSize="18" IconSource="{Binding ThemeSystemIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </PanelExt>
                    </TitleBarButton>
                    <TitleBarButton Command="{Binding OpenSettings}">
                        <PanelExt Mode="Horizontal" Spacing="8">
                            <IconControl IconSize="18" IconSource="{Binding SettingsIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </PanelExt>
                    </TitleBarButton>
                </PanelExt>
                <TitleBarButtons x:Name="TitleBarButtons" Grid.Column="2" />
            </Grid>
        </Border>
    </Grid>
</View>
