<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:Manta.NodeEditor.Rendering"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Width="400" Height="300">
            <r:NodeCanvas />
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type r:NodeCanvas}" TargetType="r:NodeCanvas">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel ClipToBounds="True">
                    <MCanvas Name="PART_Canvas"
                             MinZoom="0.1"
                             MaxZoom="5.0"
                             Background="{MBrush Background, Type=Dark1}"
                             GridBrush="{MBrush Border, Opacity=0.3}">
                        <Canvas Name="PART_NodeLayer" />
                    </MCanvas>
                    <!-- Connection overlay renders in screen space, on top of nodes -->
                    <r:ConnectionRenderer Name="PART_Connections"
                                          IsHitTestVisible="False"
                                          ConnectionBrush="{MBrush MutedForeground}"
                                          SelectedBrush="{MBrush Ring}"
                                          DragBrush="{MBrush Primary}"
                                          IncompatibleBrush="{MBrush Destructive}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
