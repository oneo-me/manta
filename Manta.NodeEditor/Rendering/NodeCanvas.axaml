<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:Manta.NodeEditor.Rendering"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Width="400" Height="300">
            <r:NodeCanvas />
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type r:NodeCanvas}" TargetType="r:NodeCanvas">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel ClipToBounds="True" Background="Transparent">
                    <r:GridRenderer Name="PART_Grid"
                                    Zoom="{Binding Zoom, RelativeSource={RelativeSource TemplatedParent}}"
                                    BackgroundBrush="{MBrush Background, Type=Dark1}"
                                    MinorGridBrush="{MBrush Border, Opacity=0.3}"
                                    MajorGridBrush="{MBrush Border, Opacity=0.6}" />
                    <!-- Transform container for nodes only -->
                    <Panel Name="PART_Transform">
                        <Canvas Name="PART_NodeLayer" />
                    </Panel>
                    <!-- Connection overlay renders in screen space (outside transform) -->
                    <r:ConnectionRenderer Name="PART_Connections"
                                          IsHitTestVisible="False"
                                          ConnectionBrush="{MBrush MutedForeground}"
                                          SelectedBrush="{MBrush Ring}"
                                          DragBrush="{MBrush Primary}"
                                          IncompatibleBrush="{MBrush Destructive}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
