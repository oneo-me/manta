<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:r="clr-namespace:Manta.NodeEditor.Rendering"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Padding="20" Background="{MBrush Background}">
            <StackPanel Spacing="8">
                <r:PortView />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type r:PortView}" TargetType="r:PortView">
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Input -->
                    <StackPanel Name="PART_In" Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding Port.IsInput, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border Name="PART_Connector"
                                Width="12" Height="12"
                                Background="{MBrush Muted}"
                                BorderBrush="{MBrush Border}"
                                BorderThickness="1.5" CornerRadius="6"
                                VerticalAlignment="Center" Cursor="Hand" />
                        <TextBlock Text="{Binding Port.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{MBrush MutedForeground}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <ContentPresenter Content="{Binding Editor, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsVisible="{Binding ShowEditor, RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Output -->
                    <StackPanel Name="PART_Out" Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding Port.IsOutput, RelativeSource={RelativeSource TemplatedParent}}">
                        <TextBlock Text="{Binding Port.Label, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{MBrush MutedForeground}" FontSize="11"
                                   VerticalAlignment="Center" />
                        <Border Name="PART_OutputConnector"
                                Width="12" Height="12"
                                Background="{MBrush Muted}"
                                BorderBrush="{MBrush Border}"
                                BorderThickness="1.5" CornerRadius="6"
                                VerticalAlignment="Center" Cursor="Hand" />
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Hover -->
        <Style Selector="^:hovered /template/ Border#PART_Connector">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
            <Setter Property="Background" Value="{MBrush Primary}" />
        </Style>
        <Style Selector="^:hovered /template/ Border#PART_OutputConnector">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
            <Setter Property="Background" Value="{MBrush Primary}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
