<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Manta.NodeEditor.Controls"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Padding="20" Background="#2d2d2d">
            <StackPanel Spacing="8">
                <controls:MNodeEditorPort />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:MNodeEditorPort}" TargetType="controls:MNodeEditorPort">
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Input port layout: connector | name | inline editor -->
                    <StackPanel Name="PART_InputLayout" Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding Port.IsInput, RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="0,0,8,0">
                        <Border Name="PART_InputConnector"
                                Width="12" Height="12"
                                Background="#505050" BorderBrush="#707070"
                                BorderThickness="1.5" CornerRadius="6"
                                VerticalAlignment="Center"
                                Cursor="Hand" />
                        <TextBlock Text="{Binding Port.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="#a0a0a0" FontSize="11"
                                   VerticalAlignment="Center" />
                        <ContentPresenter Name="PART_InlineEditor"
                                          Content="{Binding InlineEditor, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsVisible="{Binding ShowInlineEditor, RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Output port layout: name | connector -->
                    <StackPanel Name="PART_OutputLayout" Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right"
                                IsVisible="{Binding Port.IsOutput, RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="8,0,0,0">
                        <TextBlock Text="{Binding Port.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="#a0a0a0" FontSize="11"
                                   VerticalAlignment="Center" />
                        <Border Name="PART_OutputConnector"
                                Width="12" Height="12"
                                Background="#505050" BorderBrush="#707070"
                                BorderThickness="1.5" CornerRadius="6"
                                VerticalAlignment="Center"
                                Cursor="Hand" />
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- Connected input: filled connector -->
        <Style Selector="^[ShowInlineEditor=False] /template/ Border#PART_InputConnector">
            <Setter Property="Background" Value="#707070" />
        </Style>

        <!-- Hover: scale connector -->
        <Style Selector="^:pointerover /template/ Border#PART_InputConnector">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_OutputConnector">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
        </Style>

        <!-- Compatible state: green -->
        <Style Selector="^:compatible /template/ Border#PART_InputConnector">
            <Setter Property="BorderBrush" Value="#22c55e" />
            <Setter Property="Background" Value="#166534" />
        </Style>

        <!-- Incompatible state: red -->
        <Style Selector="^:incompatible /template/ Border#PART_InputConnector">
            <Setter Property="BorderBrush" Value="#ef4444" />
            <Setter Property="Background" Value="#7f1d1d" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
