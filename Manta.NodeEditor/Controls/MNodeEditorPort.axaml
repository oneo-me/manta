<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Manta.NodeEditor.Controls"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Padding="20" Background="#2d2d2d">
            <StackPanel Spacing="8">
                <controls:MNodeEditorPort />
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type controls:MNodeEditorPort}" TargetType="controls:MNodeEditorPort">
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Input port layout: connector on left -->
                    <StackPanel Name="PART_InputLayout" Orientation="Horizontal" IsVisible="{Binding IsInput, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border Name="PART_Connector"
                                Width="12"
                                Height="12"
                                Background="#606060"
                                BorderBrush="#808080"
                                BorderThickness="1"
                                CornerRadius="6"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <TextBlock Text="{Binding DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="#b0b0b0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="6,0,6,0" />
                    </StackPanel>
                    <!-- Output port layout: connector on right -->
                    <StackPanel Name="PART_OutputLayout" Orientation="Horizontal" IsVisible="{Binding IsOutput, RelativeSource={RelativeSource TemplatedParent}}">
                        <TextBlock Text="{Binding DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="#b0b0b0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="6,0,6,0" />
                        <Border Name="PART_OutputConnector"
                                Width="12"
                                Height="12"
                                Background="#606060"
                                BorderBrush="#808080"
                                BorderThickness="1"
                                CornerRadius="6"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Transitions>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <!-- Hover state for input connector -->
        <Style Selector="^[IsHovered=True] /template/ Border#PART_Connector">
            <Setter Property="RenderTransform" Value="scale(1.2)" />
            <Setter Property="Background" Value="#808080" />
        </Style>
        <!-- Hover state for output connector -->
        <Style Selector="^[IsHovered=True] /template/ Border#PART_OutputConnector">
            <Setter Property="RenderTransform" Value="scale(1.2)" />
            <Setter Property="Background" Value="#808080" />
        </Style>
        <!-- Compatible state for input connector (during drag) -->
        <Style Selector="^[IsCompatible=True] /template/ Border#PART_Connector">
            <Setter Property="BorderBrush" Value="#22c55e" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#166534" />
        </Style>
        <!-- Compatible state for output connector (during drag) -->
        <Style Selector="^[IsCompatible=True] /template/ Border#PART_OutputConnector">
            <Setter Property="BorderBrush" Value="#22c55e" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#166534" />
        </Style>
        <!-- Incompatible state for input connector (during drag) -->
        <Style Selector="^[IsIncompatible=True] /template/ Border#PART_Connector">
            <Setter Property="BorderBrush" Value="#ef4444" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#7f1d1d" />
        </Style>
        <!-- Incompatible state for output connector (during drag) -->
        <Style Selector="^[IsIncompatible=True] /template/ Border#PART_OutputConnector">
            <Setter Property="BorderBrush" Value="#ef4444" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#7f1d1d" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
