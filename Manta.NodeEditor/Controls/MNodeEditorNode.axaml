<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Manta.NodeEditor.Controls"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Padding="20" Background="#1a1a1a">
            <controls:MNodeEditorNode Width="200" />
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:MNodeEditorNode}" TargetType="controls:MNodeEditorNode">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="#2d2d2d" BorderBrush="#404040"
                        BorderThickness="1" CornerRadius="6"
                        Padding="0">
                    <DockPanel>
                        <!-- Title bar -->
                        <Border Name="PART_TitleBar" DockPanel.Dock="Top"
                                Background="#383838" CornerRadius="6,6,0,0"
                                Padding="10,6,6,6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding NodeData.DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontWeight="SemiBold" Foreground="#e0e0e0" FontSize="12"
                                           VerticalAlignment="Center" />
                                <Button Name="PART_DeleteButton" Grid.Column="1"
                                        Width="18" Height="18" Padding="0" Margin="4,0,0,0"
                                        Background="Transparent" BorderThickness="0"
                                        CornerRadius="2" Cursor="Hand"
                                        IsVisible="False">
                                    <TextBlock Text="x" FontSize="12" Foreground="#808080"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content area -->
                        <StackPanel Margin="0,4,0,4" Spacing="1">
                            <!-- Input ports with inline editors -->
                            <ItemsControl Name="PART_InputPorts">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Custom content view (optional) -->
                            <ContentPresenter Name="PART_ContentView"
                                              Content="{Binding ContentView, RelativeSource={RelativeSource TemplatedParent}}"
                                              Margin="8,2,8,2" />

                            <!-- Output port -->
                            <ContentPresenter Name="PART_OutputPort"
                                              HorizontalAlignment="Right" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Selected state: blue border -->
        <Style Selector="^[IsSelected=True] /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="#3b82f6" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- Hover: show delete button -->
        <Style Selector="^:pointerover /template/ Button#PART_DeleteButton">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Delete button hover -->
        <Style Selector="^ /template/ Button#PART_DeleteButton:pointerover">
            <Setter Property="Background" Value="#4a4a4a" />
        </Style>
        <Style Selector="^ /template/ Button#PART_DeleteButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="#ef4444" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
