<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Manta.NodeEditor.Controls"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <controls:MNodeEditor Width="800" Height="600" />
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:MNodeEditor}" TargetType="controls:MNodeEditor">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <!-- Grid background (renders behind everything) -->
                    <controls:MNodeEditorGrid Name="PART_Grid" />
                    <!-- Transform container (zoomed/panned content) -->
                    <Panel Name="PART_TransformContainer" RenderTransformOrigin="0,0">
                        <!-- Connection lines -->
                        <controls:MNodeEditorConnectionLayer Name="PART_ConnectionLayer" />
                        <!-- Node canvas -->
                        <Canvas Name="PART_Canvas" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
