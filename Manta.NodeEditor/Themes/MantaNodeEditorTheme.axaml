<Styles
    x:Class="Manta.NodeEditor.Themes.MantaNodeEditorTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="../Rendering/NodeCanvas.axaml" />
                <MergeResourceInclude Source="../Rendering/NodeFrame.axaml" />
                <MergeResourceInclude Source="../Rendering/PortView.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
