<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:ClassModifier="internal">
    <!-- ReSharper disable InconsistentNaming -->
    <SolidColorBrush x:Key="Background" Color="#ffffff" />
    <SolidColorBrush x:Key="Foreground" Color="#333333" />
    <SolidColorBrush x:Key="BorderBrush" Color="#333333" Opacity="0.12" />
    <system:Double x:Key="FontSize">12</system:Double>
    <SolidColorBrush x:Key="Window_Background" Color="#eeeeee" />
    <Thickness x:Key="Titlebar_BorderThickness">0 0 0 1</Thickness>
    <SolidColorBrush x:Key="Titlebar_Background" Color="#ffffff" Opacity="0.9" />
    <SolidColorBrush x:Key="Titlebar_BorderBrush" Color="#333333" Opacity="0.12" />
    <SolidColorBrush x:Key="Titlebar_Button_Background" Color="#333333" Opacity="0" />
    <SolidColorBrush x:Key="Titlebar_Button_Background_Hover" Color="#333333" Opacity="0.1" />
    <SolidColorBrush x:Key="Titlebar_Button_Foreground" Color="#333333" />
    <SolidColorBrush x:Key="Titlebar_Button_Foreground_Hover" Color="#333333" />
    <SolidColorBrush x:Key="Titlebar_Button_Close_Background" Color="#ef4444" Opacity="0" />
    <SolidColorBrush x:Key="Titlebar_Button_Close_Background_Hover" Color="#ef4444" Opacity="1" />
    <SolidColorBrush x:Key="Titlebar_Button_Close_Foreground" Color="#333333" />
    <SolidColorBrush x:Key="Titlebar_Button_Close_Foreground_Hover" Color="#ffffff" />
</ResourceDictionary>
