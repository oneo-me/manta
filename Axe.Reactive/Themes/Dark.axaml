<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <!-- ReSharper disable InconsistentNaming -->
    <SolidColorBrush x:Key="Background" Color="#222222" />
    <SolidColorBrush x:Key="Foreground" Color="#ffffff" />
    <SolidColorBrush x:Key="BorderBrush" Color="#ffffff" Opacity="0.12" />
    <SolidColorBrush x:Key="Window_Background" Color="#111111" />
    <SolidColorBrush x:Key="Titlebar_Background" Color="#ffffff" Opacity="0.1" />
    <SolidColorBrush x:Key="Titlebar_BorderBrush" Color="#ffffff" Opacity="0.12" />
    <SolidColorBrush x:Key="Titlebar_Button_Background" Color="#ffffff" Opacity="0" />
    <SolidColorBrush x:Key="Titlebar_Button_Background_Hover" Color="#ffffff" Opacity="0.1" />
    <SolidColorBrush x:Key="Titlebar_Button_Foreground" Color="#ffffff" />
    <SolidColorBrush x:Key="Titlebar_Button_Foreground_Hover" Color="#ffffff" />
    <SolidColorBrush x:Key="Titlebar_Button_Close_Background" Color="#CE3B3B" Opacity="0" />
    <SolidColorBrush x:Key="Titlebar_Button_Close_Background_Hover" Color="#CE3B3B" Opacity="1" />
    <SolidColorBrush x:Key="Titlebar_Button_Close_Foreground" Color="#ffffff" />
    <SolidColorBrush x:Key="Titlebar_Button_Close_Foreground_Hover" Color="#ffffff" />
</ResourceDictionary>
