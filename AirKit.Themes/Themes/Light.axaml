<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <!-- 其他 -->
    <SolidColorBrush x:Key="{ThemeBrushKey Shadow}" Color="#000000" />
    <SolidColorBrush x:Key="{ThemeBrushKey MaskBrush}" Color="#000000" Opacity="0.1" />
    <!-- 窗口 -->
    <SolidColorBrush x:Key="{ThemeBrushKey Window_Background}" Color="#EEEEEE" Opacity="0.7" />
    <!-- 通用 -->
    <SolidColorBrush x:Key="{ThemeBrushKey Background}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{ThemeBrushKey Foreground}" Color="#333333" />
    <SolidColorBrush x:Key="{ThemeBrushKey BorderBrush}" Color="#333333" Opacity="0.12" />
    <SolidColorBrush x:Key="{ThemeBrushKey Dialog_Background}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{ThemeBrushKey Dialog_Foreground}" Color="#333333" />
    <SolidColorBrush x:Key="{ThemeBrushKey Dialog_BorderBrush}" Color="#333333" Opacity="0.12" />
    <SolidColorBrush x:Key="{ThemeBrushKey Flyout_Background}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{ThemeBrushKey Flyout_Foreground}" Color="#333333" />
    <SolidColorBrush x:Key="{ThemeBrushKey Flyout_BorderBrush}" Color="#333333" Opacity="0.12" />
    <SolidColorBrush x:Key="{ThemeBrushKey Success}" Color="#22c55e" />
    <SolidColorBrush x:Key="{ThemeBrushKey Warning}" Color="#f59e0b" />
    <SolidColorBrush x:Key="{ThemeBrushKey Error}" Color="#ef4444" />
    <SolidColorBrush x:Key="{ThemeBrushKey Primary_Foreground}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{ThemeBrushKey Success_Foreground}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{ThemeBrushKey Warning_Foreground}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{ThemeBrushKey Error_Foreground}" Color="#FFFFFF" />
</ResourceDictionary>
