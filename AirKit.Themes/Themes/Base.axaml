<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:ClassModifier="internal">
    <!-- 系统配色 -->
    <SolidColorBrush x:Key="{ThemeBrushKey Primary}" Color="{DynamicResource SystemAccentColor}" />
    <!-- 颜色 -->
    <system:Double x:Key="{ThemeNumberKey FontSize}">12</system:Double>
    <!-- 配置 -->
    <system:Double x:Key="{ThemeThicknessKey Normal}">1</system:Double>
    <system:Double x:Key="{ThemeThicknessKey Flyout}">1</system:Double>
    <system:Double x:Key="{ThemeThicknessKey Dialog}">1</system:Double>
    <system:Double x:Key="{ThemeThicknessKey Padding}">7</system:Double>
    <system:Double x:Key="{ThemeThicknessKey Menu_Padding}">4</system:Double>
    <Thickness x:Key="{ThemeThicknessKey Button_Padding}">12 7</Thickness>
    <Thickness x:Key="{ThemeThicknessKey TextBox_Padding}">8 7</Thickness>
    <Thickness x:Key="{ThemeThicknessKey TabItem_Padding}">8 6</Thickness>
    <system:Double x:Key="{ThemeRadiusKey Normal}">8</system:Double>
    <system:Double x:Key="{ThemeRadiusKey Flyout}">8</system:Double>
    <system:Double x:Key="{ThemeRadiusKey Dialog}">12</system:Double>
</ResourceDictionary>
