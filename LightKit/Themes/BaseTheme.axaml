<Styles
    x:Class="LightKit.Themes.BaseTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Default" Source="@Light.axaml" />
                <ResourceInclude x:Key="Light" Source="@Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="@Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design -->
                <MergeResourceInclude Source="../Controls/Design/Window.axaml" />
                <!-- Unsupported Controls -->
                <MergeResourceInclude Source="../Controls/Base/Unsupported/AutoCompleteBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Button.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ButtonSpinner.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Calendar.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/CalendarButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/CalendarDatePicker.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/CalendarDayButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/CalendarItem.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Carousel.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/CheckBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ComboBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ComboBoxItem.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ContentControl.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ContextMenu.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/DataValidationErrors.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/DatePicker.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/DropDownButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/EmbeddableControlRoot.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Expander.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/FlyoutPresenter.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/HeaderedContentControl.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/HyperlinkButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ItemsControl.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ListBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ManagedFileChooser.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Menu.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/MenuFlyoutPresenter.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/NotificationCard.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/NumericUpDown.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/PathIcon.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ProgressBar.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/RadioButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/RepeatButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ScrollViewer.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Separator.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Slider.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/SplitButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/SplitView.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TabControl.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TextBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TimePicker.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ToggleButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ToggleSwitch.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TransitioningContentControl.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TreeView.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/WindowNotificationManager.axaml" />
                <!-- Base Controls -->
                <MergeResourceInclude Source="../Controls/Base/AdornerLayer.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Border.axaml" />
                <MergeResourceInclude Source="../Controls/Base/GridSplitter.axaml" />
                <MergeResourceInclude Source="../Controls/Base/OverlayPopupHost.axaml" />
                <MergeResourceInclude Source="../Controls/Base/PopupRoot.axaml" />
                <MergeResourceInclude Source="../Controls/Base/RefreshContainer.axaml" />
                <MergeResourceInclude Source="../Controls/Base/RefreshVisualizer.axaml" />
                <MergeResourceInclude Source="../Controls/Base/ThemeVariantScope.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Thumb.axaml" />
                <MergeResourceInclude Source="../Controls/Base/ToolTip.axaml" />
                <!-- Controls -->
                <MergeResourceInclude Source="../Controls/LightButton.axaml" />
                <MergeResourceInclude Source="../Controls/LightClipContentControl.axaml" />
                <MergeResourceInclude Source="../Controls/LightIcon.axaml" />
                <MergeResourceInclude Source="../Controls/LightItems.axaml" />
                <MergeResourceInclude Source="../Controls/LightLabel.axaml" />
                <MergeResourceInclude Source="../Controls/LightListBox.axaml" />
                <MergeResourceInclude Source="../Controls/LightPixelGrid.axaml" />
                <MergeResourceInclude Source="../Controls/LightProgressRing.axaml" />
                <MergeResourceInclude Source="../Controls/LightRing.axaml" />
                <MergeResourceInclude Source="../Controls/LightScrollViewer.axaml" />
                <MergeResourceInclude Source="../Controls/LightSelectableText.axaml" />
                <MergeResourceInclude Source="../Controls/LightTabStrip.axaml" />
                <MergeResourceInclude Source="../Controls/LightText.axaml" />
                <MergeResourceInclude Source="../Controls/LightTextBox.axaml" />
                <MergeResourceInclude Source="../Controls/LightTitleBarButton.axaml" />
                <MergeResourceInclude Source="../Controls/LightTitleBarButtons.axaml" />
                <MergeResourceInclude Source="../Controls/LightWindow.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
