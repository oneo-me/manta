<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Horizontal" Spacing="12" Margin="12">
            <LightPanel Mode="Vertical" Spacing="12" Width="180">
                <Slider IsDirectionReversed="False" Value="50" />
                <Slider IsDirectionReversed="True" Value="50" />
                <Slider Value="50" TickPlacement="TopLeft" TickFrequency="10" />
                <Slider Value="50" IsSnapToTickEnabled="True" TickPlacement="BottomRight" TickFrequency="10" />
                <Slider Value="50" TickPlacement="Outside" TickFrequency="10" />
                <Slider IsEnabled="False" Value="50" />
            </LightPanel>
            <LightPanel Mode="Horizontal" Spacing="12" Height="120" VerticalAlignment="Top">
                <Slider Value="50" Orientation="Vertical" />
                <Slider IsDirectionReversed="True" Value="50" Orientation="Vertical" />
                <Slider IsEnabled="False" Orientation="Vertical" Value="50" />
                <Slider Value="50" TickPlacement="TopLeft" TickFrequency="10" Orientation="Vertical" />
                <Slider Value="50" IsSnapToTickEnabled="True" TickPlacement="BottomRight" TickFrequency="10" Orientation="Vertical" />
                <Slider Value="50" TickPlacement="Outside" TickFrequency="10" Orientation="Vertical" />
            </LightPanel>
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="SliderRepeatButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="{ThemeColorSet Background}" />
        <Setter Property="BorderBrush" Value="{ThemeColorSet BorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeColorSet Foreground}" />
        <Setter Property="BorderThickness" Value="{ThemeThickness Normal}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="33 11" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="#00000000">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CornerRadius="{TemplateBinding CornerRadius}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="Background" Value="{ThemeColorSet Background}" />
        <Setter Property="BorderBrush" Value="{ThemeColorSet BorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeColorSet Foreground}" />
        <Setter Property="BorderThickness" Value="{ThemeThickness Normal}" />
        <Setter Property="CornerRadius" Value="100" />
        <Setter Property="Template">
            <ControlTemplate>
                <LightPanel x:Name="Root" Background="#00000000">
                    <TickBar
                        x:Name="TopTickBar"
                        Ticks="{TemplateBinding Ticks}"
                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                        Orientation="{TemplateBinding Slider.Orientation}"
                        Minimum="{TemplateBinding Slider.Minimum}"
                        Maximum="{TemplateBinding Slider.Maximum}" />
                    <Panel x:Name="TrackPanel">
                        <Border x:Name="TrackBackground"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Track
                            x:Name="PART_Track"
                            Minimum="{TemplateBinding Minimum}"
                            Maximum="{TemplateBinding Maximum}"
                            Value="{TemplateBinding Value, Mode=TwoWay}"
                            IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                            Orientation="Horizontal">
                            <Track.DecreaseButton>
                                <RepeatButton x:Name="PART_DecreaseButton" Focusable="False"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Theme="{StaticResource SliderRepeatButton}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton x:Name="PART_IncreaseButton" Focusable="False"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Theme="{StaticResource SliderRepeatButton}" />
                            </Track.IncreaseButton>
                            <Thumb Padding="{TemplateBinding Padding}"
                                   Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   CornerRadius="{TemplateBinding CornerRadius}"
                                   DataContext="{TemplateBinding Value}" />
                        </Track>
                    </Panel>
                    <TickBar
                        x:Name="BottomTickBar"
                        Ticks="{TemplateBinding Ticks}"
                        TickFrequency="{TemplateBinding Slider.TickFrequency}"
                        Orientation="{TemplateBinding Slider.Orientation}"
                        Minimum="{TemplateBinding Slider.Minimum}"
                        Maximum="{TemplateBinding Slider.Maximum}" />
                </LightPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ LightPanel#Root">
            <Setter Property="Spacing" Value="10" />
        </Style>
        <Style Selector="^ /template/ TickBar">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Fill" Value="{ThemeColorSet Foreground, Opacity=0.3}" />
        </Style>
        <Style Selector="^[TickPlacement=Outside]/template/ TickBar">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^[TickPlacement=TopLeft]/template/ TickBar#TopTickBar">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^[TickPlacement=BottomRight]/template/ TickBar#BottomTickBar">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ Border#TrackBackground">
            <Setter Property="Background" Value="{ThemeColorSet Foreground, Opacity=0.05}" />
        </Style>
        <Style Selector="^ /template/ Track#PART_Track">
            <Style Selector="^ Thumb">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
            </Style>
            <Style Selector="^ RepeatButton">
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style Selector="^#PART_DecreaseButton">
                    <Setter Property="Background" Value="{ThemeColorSet Primary}" />
                </Style>
                <Style Selector="^#PART_IncreaseButton">
                    <Setter Property="Background" Value="#00000000" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^ /template/ LightPanel#Root">
            <Setter Property="Mode" Value="Vertical" />
            <Setter Property="Margin" Value="9 0" />
        </Style>
        <Style Selector="^:horizontal">
            <Style Selector="^ /template/ LightPanel#Root">
                <Setter Property="Mode" Value="Vertical" />
                <Setter Property="Margin" Value="9 0" />
            </Style>
            <Style Selector="^ /template/ TickBar">
                <Setter Property="Height" Value="6" />
            </Style>
            <Style Selector="^ /template/ TickBar#TopTickBar">
                <Setter Property="Placement" Value="Top" />
            </Style>
            <Style Selector="^ /template/ TickBar#BottomTickBar">
                <Setter Property="Placement" Value="Bottom" />
            </Style>
            <Style Selector="^ /template/ Border#TrackBackground">
                <Setter Property="Height" Value="8" />
            </Style>
            <Style Selector="^ /template/ Track#PART_Track">
                <Setter Property="Margin" Value="0 -20" />
                <Style Selector="^ Thumb">
                    <Setter Property="Margin" Value="-9 0" />
                </Style>
                <Style Selector="^ RepeatButton">
                    <Setter Property="Padding" Value="0 20" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^:vertical">
            <Style Selector="^ /template/ LightPanel#Root">
                <Setter Property="Mode" Value="Horizontal" />
                <Setter Property="Margin" Value="0 9" />
            </Style>
            <Style Selector="^ /template/ TickBar">
                <Setter Property="Width" Value="6" />
            </Style>
            <Style Selector="^ /template/ TickBar#TopTickBar">
                <Setter Property="Placement" Value="Left" />
            </Style>
            <Style Selector="^ /template/ TickBar#BottomTickBar">
                <Setter Property="Placement" Value="Right" />
            </Style>
            <Style Selector="^ /template/ Border#TrackBackground">
                <Setter Property="Width" Value="8" />
            </Style>
            <Style Selector="^ /template/ Track#PART_Track">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Margin" Value="-20 0" />
                <Style Selector="^ Thumb">
                    <Setter Property="Margin" Value="0 -9" />
                </Style>
                <Style Selector="^ RepeatButton">
                    <Setter Property="Padding" Value="20 0" />
                </Style>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
