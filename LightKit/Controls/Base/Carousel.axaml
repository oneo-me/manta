<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <Carousel Width="100" Height="100">
                <Carousel.PageTransition>
                    <PageSlide Duration="0:0:0.1" />
                </Carousel.PageTransition>
                <Border Background="{ThemeColorSet Primary}" TextElement.Foreground="{ThemeColorSet ColorForeground}">
                    <LightText Text="Page 1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="{ThemeColorSet Success}" TextElement.Foreground="{ThemeColorSet ColorForeground}">
                    <LightText Text="Page 2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="{ThemeColorSet Error}" TextElement.Foreground="{ThemeColorSet ColorForeground}">
                    <LightText Text="Page 3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Carousel>
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type Carousel}" TargetType="Carousel">
        <Setter Property="BorderBrush" Value="{ThemeColorSet BorderBrush}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <ScrollViewer x:Name="PART_ScrollViewer"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              BringIntoViewOnFocusChange="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsPresenter x:Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    Margin="{TemplateBinding Padding}" />
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
