<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <LightDismissOverlayLayer />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type LightDismissOverlayLayer}" TargetType="LightDismissOverlayLayer">
    </ControlTheme>
</ResourceDictionary>
