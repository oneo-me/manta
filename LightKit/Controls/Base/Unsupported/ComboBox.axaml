<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <ComboBox />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <LightSelectableText Theme.ColorScheme="Danger" Text="Not supported ComboBox" />
                    <Popup x:Name="PART_Popup" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
