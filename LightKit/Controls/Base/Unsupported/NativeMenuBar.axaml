<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <NativeMenuBar />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type NativeMenuBar}" TargetType="NativeMenuBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <LightSelectableText Theme.ColorScheme="Danger" Text="The control 'NativeMenuBar' is not supported" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
