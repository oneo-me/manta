<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <TabControl />
            <TabItem />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Theme.ColorScheme="Danger" Text="Not supported TabControl" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Theme.ColorScheme="Danger" Text="Not supported TabItem" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
