<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <Menu />
            <MenuItem />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Theme.ColorScheme="Danger" Text="Not supported Menu" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Theme.ColorScheme="Danger" Text="Not supported MenuItem" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
