<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <DateTimePickerPanel />
        </LightPanel>
    </Design.PreviewWith>
    <!-- The control 'DateTimePickerPanel' is not supported -->
    <ControlTheme x:Key="{x:Type DateTimePickerPanel}" TargetType="DateTimePickerPanel">
        <Setter Property="Theme.ColorScheme" Value="Danger" />
    </ControlTheme>
</ResourceDictionary>
