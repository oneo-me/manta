<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <Grid ColumnDefinitions="*,*" Width="300" Height="300">
                <LightText Grid.Column="0" Text="LightTextLightTextLightTextLightText" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="1" BorderThickness="1 0 0 0">
                    <LightText Text="LightTextLightTextLightTextLightText" TextTrimming="CharacterEllipsis" />
                </Border>
                <GridSplitter Grid.Column="0" Width="4" HorizontalAlignment="Right" />
            </Grid>
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Margin" Value="-4" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Background" Value="{ThemeBrush Foreground, Opacity=0}" />
        <Setter Property="PreviewContent">
            <Template>
                <Rectangle Fill="{ThemeBrush Foreground, Opacity=0.15}" Margin="2" />
            </Template>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Rectangle Fill="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
