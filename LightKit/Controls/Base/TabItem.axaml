<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Horizontal" Spacing="12" Margin="12">
            <LightAutoGrid Definitions="*,*" Spacing="12">
                <TabControl TabStripPlacement="Top" BorderThickness="{ThemeThickness Normal}" CornerRadius="11">
                    <TabItem Header="TabItem 1">
                        <TextBlock Text="Content 1" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 2">
                        <TextBlock Text="Content 2" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 3">
                        <TextBlock Text="Content 3" Margin="12 50" />
                    </TabItem>
                </TabControl>
                <TabControl TabStripPlacement="Bottom" BorderThickness="{ThemeThickness Normal}" CornerRadius="11">
                    <TabItem Header="TabItem 1">
                        <TextBlock Text="Content 1" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 2">
                        <TextBlock Text="Content 2" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 3">
                        <TextBlock Text="Content 3" Margin="12 50" />
                    </TabItem>
                </TabControl>
                <TabControl TabStripPlacement="Left" BorderThickness="{ThemeThickness Normal}" CornerRadius="11">
                    <TabItem Header="TabItem 1">
                        <TextBlock Text="Content 1" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 2">
                        <TextBlock Text="Content 2" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 3">
                        <TextBlock Text="Content 3" Margin="12 50" />
                    </TabItem>
                </TabControl>
                <TabControl TabStripPlacement="Bottom" BorderThickness="{ThemeThickness Normal}" CornerRadius="11">
                    <TabItem Header="TabItem 1">
                        <TextBlock Text="Content 1" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 2">
                        <TextBlock Text="Content 2" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 3">
                        <TextBlock Text="Content 3" Margin="12 50" />
                    </TabItem>
                </TabControl>
            </LightAutoGrid>
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  RecognizesAccessKey="True" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
