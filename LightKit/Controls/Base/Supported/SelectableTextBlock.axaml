<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <SelectableTextBlock />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
        <Setter Property="Theme.ColorScheme" Value="Danger" />
        <Setter Property="Text" Value="Please use the 'LightSelectableText'" />
    </ControlTheme>
</ResourceDictionary>
