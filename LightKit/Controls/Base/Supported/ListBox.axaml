<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <ListBox />
            <ListBoxItem />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Theme.ColorScheme="Danger" Text="Please use the 'LightListBox'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ListBoxItem}" TargetType="ListBoxItem">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Theme.ColorScheme="Danger" Text="Please use the 'LightListBoxItem'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
