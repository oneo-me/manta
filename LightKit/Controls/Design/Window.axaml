<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightText Text="Design Model" Margin="30" />
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
        <Setter Property="Title" Value="LightKit" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeColorSet Foreground}" />
        <Setter Property="Background" Value="{ThemeColorSet Background}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <LightPixelGrid />
                    <VisualLayerManager>
                        <ContentPresenter Name="PART_ContentPresenter" ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" />
                    </VisualLayerManager>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
