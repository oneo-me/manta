<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <Ring Value="0" />
            <Ring Value="50" />
            <Ring Value="100" />
        </PanelExt>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type Ring}" TargetType="Ring">
        <Setter Property="Foreground" Value="{ThemeBrush Primary}" />
        <Setter Property="Background" Value="{ThemeBrush BorderBrush, Opacity=0.6}" />
        <Setter Property="Size" Value="60" />
        <Setter Property="StrokeSize" Value="5" />
        <Setter Property="Value" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                    <Ellipse StrokeThickness="{TemplateBinding StrokeSize}" Stroke="{TemplateBinding Background}" />
                    <Arc x:Name="PART_Arc" StartAngle="90" StrokeThickness="{TemplateBinding StrokeSize}" Stroke="{TemplateBinding Foreground}"
                         StrokeLineCap="Round" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
