<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <StackPanel Orientation="Vertical" Spacing="12" Margin="12">
            <LightTitleBarButtons />
        </StackPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type LightTitleBarButtons}" TargetType="LightTitleBarButtons">
        <Setter Property="Height" Value="38" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel x:Name="PART_Buttons" Orientation="Horizontal">
                    <LightTitleBarButton Type="FullScreen" IsVisible="False" />
                    <LightTitleBarButton Type="Minimize" />
                    <LightTitleBarButton Type="Maximize" />
                    <LightTitleBarButton Type="Close" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
