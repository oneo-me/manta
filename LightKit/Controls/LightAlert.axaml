<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <LightAlert Header="Success! Your changes have been saved">
                <LightAlert.Icon>
                    <LightPathIcon Size="16" UseStroke="True" Data="M9.388 4.29a4.302 4.302 0 0 0-6.127-.016c-1.688 1.705-1.68 4.476.016 6.189l6.277 6.34c.26.263.682.263.942 0l6.245-6.304a4.408 4.408 0 0 0-.017-6.187 4.305 4.305 0 0 0-6.135-.015l-.596.603-.605-.61Z M 0 0 M 20 20" />
                </LightAlert.Icon>
                <LightText Text="This is an alert with icon, title and description." Opacity="0.5" />
            </LightAlert>
            <LightAlert Header="This Alert has a title and an icon. No description.">
                <LightAlert.Icon>
                    <LightPathIcon Size="16" UseStroke="True" Data="M9.388 4.29a4.302 4.302 0 0 0-6.127-.016c-1.688 1.705-1.68 4.476.016 6.189l6.277 6.34c.26.263.682.263.942 0l6.245-6.304a4.408 4.408 0 0 0-.017-6.187 4.305 4.305 0 0 0-6.135-.015l-.596.603-.605-.61Z M 0 0 M 20 20" />
                </LightAlert.Icon>
            </LightAlert>
            <LightAlert Variant="Destructive" Header="Unable to process your payment.">
                <LightAlert.Icon>
                    <LightPathIcon Size="16" UseStroke="True" Data="M9.388 4.29a4.302 4.302 0 0 0-6.127-.016c-1.688 1.705-1.68 4.476.016 6.189l6.277 6.34c.26.263.682.263.942 0l6.245-6.304a4.408 4.408 0 0 0-.017-6.187 4.305 4.305 0 0 0-6.135-.015l-.596.603-.605-.61Z M 0 0 M 20 20" />
                </LightAlert.Icon>
                <LightPanel Mode="Vertical" Spacing="4">
                    <LightText Text="Please verify your billing information and try again." />
                    <LightPanel Mode="Vertical">
                        <LightText Text="•  Check your card details" />
                        <LightText Text="•  Ensure sufficient funds" />
                        <LightText Text="•  Verify billing address" />
                    </LightPanel>
                </LightPanel>
            </LightAlert>
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type LightAlert}" TargetType="LightAlert">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto *" RowDefinitions="Auto *">
                        <ContentPresenter Grid.Column="0" Grid.Row="0" Name="PART_IconPresenter"
                                          ContentTemplate="{TemplateBinding IconTemplate}"
                                          Content="{TemplateBinding Icon}" />
                        <ContentPresenter Grid.Column="1" Grid.Row="0" Name="PART_HeaderPresenter"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Content="{TemplateBinding Header}" />
                        <ContentPresenter Grid.Column="1" Grid.Row="1" Name="PART_ContentPresenter"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Content="{TemplateBinding Content}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{ThemeColorSet BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0 0 12 0" />
            <Style Selector="^:empty">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Padding" Value="0 4 0 0" />
            <Style Selector="^:empty">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Style Selector="^[Variant=Destructive]">
            <Setter Property="Foreground" Value="{ThemeColorSet Danger}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
