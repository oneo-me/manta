<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <StackPanel Orientation="Horizontal" Margin="12">
            <LightTitleBarButton Content="Custom" />
            <LightTitleBarButton Type="FullScreen">
                <system:Boolean>True</system:Boolean>
            </LightTitleBarButton>
            <LightTitleBarButton Type="FullScreen">
                <system:Boolean>False</system:Boolean>
            </LightTitleBarButton>
            <LightTitleBarButton Type="Minimize" />
            <LightTitleBarButton Type="Maximize">
                <system:Boolean>True</system:Boolean>
            </LightTitleBarButton>
            <LightTitleBarButton Type="Maximize">
                <system:Boolean>False</system:Boolean>
            </LightTitleBarButton>
            <LightTitleBarButton Type="Close" />
        </StackPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type LightTitleBarButton}" TargetType="LightTitleBarButton">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="InnerMargin" Value="0 4 4 4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="#00000000">
                    <Panel Margin="{TemplateBinding InnerMargin}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Background="{TemplateBinding Background}"
                                          CornerRadius="{TemplateBinding CornerRadius}"
                                          Padding="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                <BrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <Setter Property="Background" Value="{ThemeColorSet Foreground, Opacity=0}" />
        <Setter Property="Foreground" Value="{ThemeColorSet Foreground}" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{ThemeColorSet Foreground, Opacity=0.1}" />
        </Style>
        <Style Selector="^[Type=None]">
            <Setter Property="Padding" Value="8 0" />
        </Style>
        <Style Selector="^[Type=FullScreen]">
            <Setter Property="ContentTemplate">
                <DataTemplate DataType="x:Boolean">
                    <Panel>
                        <LightPathIcon Foreground="{Binding $parent[LightTitleBarButton].Foreground}"
                                       Size="10" Data="M2048 2048v-819h-205v469l-1493 -1493h469v-205h-819v819h205v-469l1493 1493h-469v205h819z"
                                       IsVisible="{Binding !.}" />
                        <LightPathIcon Foreground="{Binding $parent[LightTitleBarButton].Foreground}"
                                       Size="10" Data="M205 1024h819v-819h-205v469l-674 -674l-145 145l674 674h-469v205zM1374 1229h469v-205h-819v819h205v-469l674 674l145 -145z"
                                       IsVisible="{Binding .}" />
                    </Panel>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="^[Type=Minimize]">
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <LightPathIcon Foreground="{Binding $parent[LightTitleBarButton].Foreground}"
                                   Size="10" Margin="0 5 0 0" Data="M2048 1229v-205h-2048v205h2048z" />
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="^[Type=Maximize]">
            <Setter Property="ContentTemplate">
                <DataTemplate DataType="x:Boolean">
                    <Panel>
                        <LightPathIcon Foreground="{Binding $parent[LightTitleBarButton].Foreground}"
                                       Size="10" Data="M2048 2048v-2048h-2048v2048h2048zM1843 1843h-1638v-1638h1638v1638z"
                                       IsVisible="{Binding !.}" />
                        <LightPathIcon Foreground="{Binding $parent[LightTitleBarButton].Foreground}"
                                       Size="10" Data="M2048 410h-410v-410h-1638v1638h410v410h1638v-1638zM1434 1434h-1229v-1229h1229v1229zM1843 1843h-1229v-205h1024v-1024h205v1229z"
                                       IsVisible="{Binding .}" />
                    </Panel>
                </DataTemplate>
            </Setter>
        </Style>
        <Style Selector="^[Type=Close]">
            <Setter Property="ContentTemplate">
                <DataTemplate>
                    <LightPathIcon Foreground="{Binding $parent[LightTitleBarButton].Foreground}"
                                   Size="10" Data="M1169 1024l879 -879l-145 -145l-879 879l-879 -879l-145 145l879 879l-879 879l145 145l879 -879l879 879l145 -145z" />
                </DataTemplate>
            </Setter>
            <Setter Property="Background" Value="{ThemeColorSet Danger, Opacity=0}" />
            <Setter Property="Foreground" Value="{ThemeColorSet Foreground}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{ThemeColorSet Danger}" />
                <Setter Property="Foreground" Value="{ThemeColorSet ColorForeground}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
