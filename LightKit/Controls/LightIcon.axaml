<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightIcon IconSource="Controls" IconSize="72" />
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type LightIcon}" TargetType="LightIcon">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Viewbox Name="PART_ViewBox" ClipToBounds="False" />
            </ControlTemplate>
        </Setter>
        <Setter Property="Foreground" Value="{ThemeColorSet Foreground, Opacity=0.6}" />
        <Style Selector="^[(Theme.ColorScheme)=Normal]">
            <Setter Property="Background" Value="{ThemeColorSet Foreground, Opacity=0.2}" />
        </Style>
        <Style Selector="^[(Theme.ColorScheme)=Primary]">
            <Setter Property="Background" Value="{ThemeColorSet Primary, Opacity=0.2}" />
        </Style>
        <Style Selector="^[(Theme.ColorScheme)=Success]">
            <Setter Property="Background" Value="{ThemeColorSet Success, Opacity=0.2}" />
        </Style>
        <Style Selector="^[(Theme.ColorScheme)=Warning]">
            <Setter Property="Background" Value="{ThemeColorSet Warning, Opacity=0.2}" />
        </Style>
        <Style Selector="^[(Theme.ColorScheme)=Danger]">
            <Setter Property="Background" Value="{ThemeColorSet Danger, Opacity=0.2}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
