<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightText Text="Design Model" Margin="30" />
    </Design.PreviewWith>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MacBackground" Color="#00000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MacBackground" Color="#00000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MacBackground" Color="#666666" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <ControlTheme x:Key="{x:Type LightWindow}" TargetType="LightWindow">
        <Setter Property="Title" Value="LightKit" />
        <Setter Property="Foreground" Value="{ThemeBrush Foreground}" />
        <Setter Property="Background" Value="{ThemeBrush Background, ResetOpacity=True, Opacity=1}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel x:Name="Root">
                    <Border x:Name="Background" Background="{TemplateBinding Background}" />
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="{ TemplateBinding OffScreenMargin}">
                        <VisualLayerManager>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Background="{ThemeBrush Primary, Opacity=0.05}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}" />
                        </VisualLayerManager>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <!-- Windows -->
        <Style Selector="^[(CurrentSystem.IsWindows)=True]">
            <Setter Property="BorderThickness" Value="1" />
            <Style Selector="^[WindowState=Maximized]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^[WindowState=FullScreen]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Setter Property="TransparencyLevelHint" Value="AcrylicBlur,Blur,Mica,None" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="3" />
            <Setter Property="ExtendClientAreaChromeHints" Value="SystemChrome" />
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="Opacity" Value="0.8" />
            </Style>
        </Style>
        <!-- macOS -->
        <Style Selector="^[(CurrentSystem.IsMacOS)=True]">
            <Setter Property="TransparencyLevelHint" Value="AcrylicBlur,Blur,Mica,None" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />
            <Setter Property="ExtendClientAreaChromeHints" Value="PreferSystemChrome,OSXThickTitleBar" />
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="Opacity" Value="0.7" />
            </Style>
            <Style Selector="^[IsActive=False] /template/ Panel#Root">
                <Setter Property="Background" Value="{DynamicResource MacBackground}" />
            </Style>
        </Style>
        <!-- Linux -->
        <Style Selector="^[(CurrentSystem.IsLinux)=True]">
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaChromeHints" Value="NoChrome" />
            <Setter Property="SystemDecorations" Value="None" />
            <Setter Property="BorderThickness" Value="1" />
            <Style Selector="^[WindowState=Maximized]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^[WindowState=FullScreen]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
