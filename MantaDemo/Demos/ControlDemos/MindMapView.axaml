<MView
    x:Class="MantaDemo.Demos.ControlDemos.MindMapView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ControlDemos"
    xmlns:mindmap="clr-namespace:Manta.MindMap.Controls;assembly=Manta.MindMap"
    x:DataType="local:MindMapView_Model" Design.DataContext="{x:Static local:MindMapView_Model.Design}">
    <mindmap:MMindMap x:Name="MindMap" MindMap="{Binding MindMap}" />
</MView>
