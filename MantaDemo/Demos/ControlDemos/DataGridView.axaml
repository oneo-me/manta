<MView
    x:Class="MantaDemo.Demos.ControlDemos.DataGridView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ControlDemos"
    x:DataType="local:DataGridView_Model" Design.DataContext="{x:Static local:DataGridView_Model.Design}"
    Design.Width="800" Design.Height="600">
    <Grid RowDefinitions="Auto *">
        <!-- Toolbar -->
        <MPanel Grid.Row="0" Mode="Horizontal" Spacing="8" Margin="8" VerticalAlignment="Center">
            <MButton Content="Add Row"
                     Command="{Binding AddRowCommand}"
                     Variant="Secondary" />
            <MButton Content="Remove Row"
                     Command="{Binding RemoveRowCommand}"
                     Variant="Destructive" />
            <TextBlock VerticalAlignment="Center" Foreground="{MBrush MutedForeground}">
                <Run Text="Selected: " />
                <Run Text="{Binding SelectedUser.Name, FallbackValue='(none)'}"
                     FontWeight="SemiBold"
                     Foreground="{MBrush Foreground}" />
            </TextBlock>
        </MPanel>
        <!-- DataGrid -->
        <MDataGrid Grid.Row="1" ItemsSource="{Binding Users}"
                   SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                   BorderThickness="{MThickness Px, Filter=Top}">
            <MDataGrid.Columns>
                <MDataGridTextColumn Header="Name" Width="*" Binding="{ReflectionBinding Name}" />
                <MDataGridTextColumn Header="Email" Width="2*" Binding="{ReflectionBinding Email}" />
                <MDataGridTextColumn Header="Age" Width="60" Binding="{ReflectionBinding Age}" />
                <MDataGridTemplateColumn Header="Status" Width="100">
                    <MDataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:UserItem">
                            <Panel Margin="8,0" VerticalAlignment="Center">
                                <MBadge Content="Active"
                                        IsVisible="{Binding Active}" />
                                <MBadge Content="Inactive"
                                        Variant="Destructive"
                                        IsVisible="{Binding Inactive}" />
                            </Panel>
                        </DataTemplate>
                    </MDataGridTemplateColumn.CellTemplate>
                </MDataGridTemplateColumn>
            </MDataGrid.Columns>
        </MDataGrid>
    </Grid>
</MView>
