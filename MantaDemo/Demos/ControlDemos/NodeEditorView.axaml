<MView
    x:Class="MantaDemo.Demos.ControlDemos.NodeEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ControlDemos"
    xmlns:r="clr-namespace:Manta.NodeEditor.Rendering;assembly=Manta.NodeEditor"
    x:DataType="local:NodeEditorView_Model" Design.DataContext="{x:Static local:NodeEditorView_Model.Design}"
    Design.Width="800" Design.Height="600">
    <MPanel Mode="Vertical" Spacing="12" Margin="12">
        <MCard>
            <MPanel Mode="Horizontal" Spacing="8">
                <MButton Content="Number" Command="{Binding AddNumberNodeCommand}" Variant="Secondary" />
                <MButton Content="Add" Command="{Binding AddAddNodeCommand}" Variant="Secondary" />
                <MButton Content="Multiply" Command="{Binding AddMultiplyNodeCommand}" Variant="Secondary" />
                <MButton Content="Text" Command="{Binding AddTextNodeCommand}" Variant="Secondary" />
                <MButton Content="Concat" Command="{Binding AddConcatNodeCommand}" Variant="Secondary" />
                <MButton Content="Execute" Command="{Binding ExecuteCommand}" />
            </MPanel>
        </MCard>
        <MCard Height="500">
            <r:NodeCanvas Graph="{Binding Graph}" />
        </MCard>
        <MCard>
            <MPanel Mode="Vertical" Spacing="4">
                <TextBlock Text="Instructions:" FontWeight="Bold" />
                <TextBlock Text="- Mouse wheel to zoom in/out" />
                <TextBlock Text="- Middle mouse button or Space+Left click to pan" />
                <TextBlock Text="- Drag from output port (right) to input port (left) to connect" />
                <TextBlock Text="- Press Delete to remove selected node or connection" />
                <TextBlock Text="- Click on a connection line to select it" />
                <TextBlock Text="- Ctrl+C / Ctrl+V to copy/paste nodes" />
                <TextBlock Text="- Press Escape to cancel connection or clear selection" />
            </MPanel>
        </MCard>
    </MPanel>
</MView>
