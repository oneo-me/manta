<MView
    x:Class="MantaDemo.Demos.ControlDemos.NodeEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ControlDemos"
    x:DataType="local:NodeEditorView_Model" Design.DataContext="{x:Static local:NodeEditorView_Model.Design}"
    Design.Width="800" Design.Height="600">
    <MPanel Mode="Vertical" Spacing="12" Margin="12">
        <MCard>
            <MPanel Mode="Horizontal" Spacing="8">
                <MButton Content="Add Number Node" Command="{Binding AddNumberNodeCommand}" />
                <MButton Content="Add Add Node" Command="{Binding AddAddNodeCommand}" />
                <MButton Content="Add Multiply Node" Command="{Binding AddMultiplyNodeCommand}" />
                <MButton Content="Execute" Command="{Binding ExecuteCommand}" />
                <MButton Content="Reset View" Command="{Binding ResetViewCommand}" />
            </MPanel>
        </MCard>
        <MCard Height="500">
            <MNodeEditor
                x:Name="NodeEditor"
                Graph="{Binding Graph}"
                Registry="{Binding Registry}" />
        </MCard>
        <MCard>
            <MPanel Mode="Vertical" Spacing="4">
                <TextBlock Text="Instructions:" FontWeight="Bold" />
                <TextBlock Text="- Mouse wheel to zoom in/out" />
                <TextBlock Text="- Middle mouse button or click on empty canvas to pan" />
                <TextBlock Text="- Drag from output port to input port to create connections" />
                <TextBlock Text="- Press Delete to remove selected node or connection" />
                <TextBlock Text="- Press F5 or click Execute to run the graph" />
            </MPanel>
        </MCard>
    </MPanel>
</MView>
