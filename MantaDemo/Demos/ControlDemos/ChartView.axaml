<MView
    x:Class="MantaDemo.Demos.ControlDemos.ChartView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ControlDemos"
    x:DataType="local:ChartView_Model" Design.DataContext="{x:Static local:ChartView_Model.Design}"
    Design.Width="500">
    <MView.Styles>
        <Style Selector="MChart">
            <Setter Property="Height" Value="300" />
        </Style>
    </MView.Styles>
    <MScrollViewer>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MCard>
                <MChart Data="{Binding BarData}" Title="Bar Chart" ShowLegend="True" />
            </MCard>
            <MCard>
                <MChart Data="{Binding LineData}" Title="Line Chart" ShowLegend="True" />
            </MCard>
            <MCard>
                <MChart Data="{Binding PieData}" Title="Pie Chart" ShowLegend="True" />
            </MCard>
        </MPanel>
    </MScrollViewer>
</MView>
