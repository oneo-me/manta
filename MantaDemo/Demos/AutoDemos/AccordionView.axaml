<MView
    x:Class="MantaDemo.Demos.AutoDemos.AccordionView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:AccordionView_Model">
    <Design.DataContext>
        <local:AccordionView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12" Height="300">
            <Border Width="320"
                    Background="{MBrush Background}"
                    BorderBrush="{MBrush Border}"
                    BorderThickness="{MThickness Px}"
                    CornerRadius="{MRadius XL}"
                    Padding="{MThickness S3}"
                    BoxShadow="{MShadow MD}">
                <MAccordion>
                    <MAccordionItem Header="Product Information">
                        <MPanel Mode="Vertical" Spacing="3">
                            <TextBlock Text="Our flagship product combines cutting-edge technology with sleek design. Built with premium materials, it offers unparalleled performance and reliability." TextWrapping="Wrap" />
                            <TextBlock Text="Key features include advanced processing capabilities, and an intuitive user interface designed for both beginners and experts." TextWrapping="Wrap" />
                        </MPanel>
                    </MAccordionItem>
                    <MAccordionItem Header="Shipping Details">
                        <MPanel Mode="Vertical" Spacing="3">
                            <TextBlock Text="We offer worldwide shipping through trusted courier partners. Standard delivery takes 3-5 business days, while express shipping ensures delivery within 1-2 business days." TextWrapping="Wrap" />
                            <TextBlock Text="All orders are carefully packaged and fully insured. Track your shipment in real-time through our dedicated tracking portal." TextWrapping="Wrap" />
                        </MPanel>
                    </MAccordionItem>
                    <MAccordionItem Header="Return Policy">
                        <MPanel Mode="Vertical" Spacing="3">
                            <TextBlock Text="We stand behind our products with a comprehensive 30-day return policy. If you&apos;re not completely satisfied, simply return the item in its original condition." TextWrapping="Wrap" />
                            <TextBlock Text="Our hassle-free return process includes free return shipping and full refunds processed within 48 hours of receiving the returned item." TextWrapping="Wrap" />
                        </MPanel>
                    </MAccordionItem>
                </MAccordion>
            </Border>
        </MPanel>
    </Panel>
</MView>
