<MView
    x:Class="MantaDemo.Demos.AutoDemos.MRepeatButtonView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MRepeatButtonView_Model">
    <Design.DataContext>
        <local:MRepeatButtonView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel Mode="Wrap" Spacing="12">
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Content="Button" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="Secondary" Content="Secondary" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="Destructive" Content="Destructive" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="Outline" Content="Outline" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="Ghost" Content="Ghost" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="NoStyle" Content="NoStyle" />
                </MPanel>
            </MPanel>
            <TextBlock Text="Disabled" />
            <MPanel Mode="Wrap" Spacing="12" IsEnabled="False">
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Content="Button" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="Secondary" Content="Secondary" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="Destructive" Content="Destructive" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="Outline" Content="Outline" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="Ghost" Content="Ghost" />
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MRepeatButton Variant="NoStyle" Content="NoStyle" />
                </MPanel>
            </MPanel>
        </MPanel>
    </Panel>
</MView>
