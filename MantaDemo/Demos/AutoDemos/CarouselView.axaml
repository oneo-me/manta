<MView
    x:Class="MantaDemo.Demos.AutoDemos.CarouselView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:CarouselView_Model">
    <Design.DataContext>
        <local:CarouselView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Text="PageSlide" />
            <MPanel Mode="Vertical" Spacing="12">
                <MCarousel Name="Carousel1" Width="300" Height="120">
                    <MCarousel.PageTransition>
                        <PageSlide Duration="0:00:0.3" Orientation="Horizontal" />
                    </MCarousel.PageTransition>
                    <MCard>
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MCard>
                    <MCard>
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MCard>
                    <MCard>
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MCard>
                </MCarousel>
                <MPanel Mode="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <MButton Variant="Outline" Content="Previous" Command="{Binding ElementName=Carousel1, Path=Previous}" />
                    <MButton Variant="Outline" Content="Next" Command="{Binding ElementName=Carousel1, Path=Next}" />
                </MPanel>
            </MPanel>
            <TextBlock Text="Rotate3DTransition" />
            <MPanel Mode="Vertical" Spacing="12">
                <MCarousel Name="Carousel2" Width="300" Height="120">
                    <MCarousel.PageTransition>
                        <Rotate3DTransition Duration="0:0:0.3" />
                    </MCarousel.PageTransition>
                    <MCard>
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MCard>
                    <MCard>
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MCard>
                    <MCard>
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MCard>
                </MCarousel>
                <MPanel Mode="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <MButton Variant="Outline" Content="Previous" Command="{Binding ElementName=Carousel2, Path=Previous}" />
                    <MButton Variant="Outline" Content="Next" Command="{Binding ElementName=Carousel2, Path=Next}" />
                </MPanel>
            </MPanel>
        </MPanel>
    </Panel>
</MView>
