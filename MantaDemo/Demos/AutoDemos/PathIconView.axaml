<MView
    x:Class="MantaDemo.Demos.AutoDemos.PathIconView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:PathIconView_Model">
    <Design.DataContext>
        <local:PathIconView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPathIcon Data="m6 9 6 6 6-6" />
            <MPathIcon Data="m6 9 6 6 6-6" UseStroke="True" />
        </MPanel>
    </Panel>
</MView>
