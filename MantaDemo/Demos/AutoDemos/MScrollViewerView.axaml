<MView
    x:Class="MantaDemo.Demos.AutoDemos.MScrollViewerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MScrollViewerView_Model">
    <Design.DataContext>
        <local:MScrollViewerView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Horizontal" Spacing="12" Margin="12">
            <MScrollViewer Width="100" Height="100" BorderThickness="10" CornerRadius="10" BorderBrush="Red">
                <Border Background="Aquamarine" Width="300" Height="300" />
            </MScrollViewer>
            <MScrollViewer Width="100" Height="100" BorderThickness="10" CornerRadius="10" BorderBrush="Red" HorizontalScrollBarVisibility="Auto">
                <Border Background="Aquamarine" Width="300" Height="300" />
            </MScrollViewer>
            <MScrollViewer Width="100" Height="100" BorderThickness="10" CornerRadius="10" BorderBrush="Red" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Border Background="Aquamarine" Width="300" Height="300" />
            </MScrollViewer>
            <MScrollViewer Padding="30" Width="100" Height="100" BorderThickness="10" CornerRadius="10" BorderBrush="Red">
                <Border Background="Aquamarine" Width="300" Height="300" />
            </MScrollViewer>
        </MPanel>
    </Panel>
</MView>
