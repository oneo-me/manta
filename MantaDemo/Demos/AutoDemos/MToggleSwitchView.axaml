<MView
    x:Class="MantaDemo.Demos.AutoDemos.MToggleSwitchView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MToggleSwitchView_Model">
    <Design.DataContext>
        <local:MToggleSwitchView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12" HorizontalAlignment="Left">
            <TextBlock Text="Default" />
            <MPanel Mode="Horizontal" Spacing="12">
                <MToggleSwitch IsChecked="True" />
                <MToggleSwitch IsChecked="False" />
            </MPanel>
            <TextBlock Text="Diabled" />
            <MPanel Mode="Horizontal" Spacing="12">
                <MToggleSwitch IsChecked="True" IsEnabled="False" />
                <MToggleSwitch IsChecked="False" IsEnabled="False" />
            </MPanel>
            <TextBlock Text="With OnContent/OffContent" />
            <MPanel Mode="Horizontal" Spacing="12">
                <MToggleSwitch OnContent="On" OffContent="Off" IsChecked="True" />
                <MToggleSwitch OnContent="On" OffContent="Off" IsChecked="False" />
            </MPanel>
            <TextBlock Text="Full Example" />
            <MToggleSwitch Content="Auto-save" OnContent="Enabled" OffContent="Disabled" IsChecked="True" />
            <MToggleSwitch Content="Sync settings" OnContent="Enabled" OffContent="Disabled" IsChecked="False" />
        </MPanel>
    </Panel>
</MView>
