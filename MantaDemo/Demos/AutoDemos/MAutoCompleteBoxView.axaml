<MView
    x:Class="MantaDemo.Demos.AutoDemos.MAutoCompleteBoxView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MAutoCompleteBoxView_Model">
    <Design.DataContext>
        <local:MAutoCompleteBoxView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12" MinHeight="320">
            <MAutoCompleteBox Width="220">
                <MAutoCompleteBox.ItemsSource>
                    <generic:List x:TypeArguments="x:String">
                        Alabama
                        Alaska
                        Arizona
                        Arkansas
                        California
                        Colorado
                        Connecticut
                        Delaware
                    </generic:List>
                </MAutoCompleteBox.ItemsSource>
            </MAutoCompleteBox>
        </MPanel>
    </Panel>
</MView>
