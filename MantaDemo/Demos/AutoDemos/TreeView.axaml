<MView
    x:Class="MantaDemo.Demos.AutoDemos.TreeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:TreeView_Model">
    <Design.DataContext>
        <local:TreeView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <Border Width="280"
                    Background="{MBrush Background}"
                    BorderBrush="{MBrush Border}"
                    BorderThickness="{MThickness Px}"
                    CornerRadius="{MRadius XL}"
                    Padding="{MThickness S3}"
                    BoxShadow="{MShadow MD}">
                <MTree>
                    <MTreeItem Header="Documents" IsExpanded="True">
                        <MTreeItem Header="Work">
                            <MTreeItem Header="Reports" />
                            <MTreeItem Header="Presentations" />
                        </MTreeItem>
                        <MTreeItem Header="Personal">
                            <MTreeItem Header="Photos" />
                            <MTreeItem Header="Music" />
                        </MTreeItem>
                    </MTreeItem>
                    <MTreeItem Header="Downloads" IsExpanded="True">
                        <MTreeItem Header="Software" />
                        <MTreeItem Header="Movies" />
                    </MTreeItem>
                    <MTreeItem Header="Desktop" />
                </MTree>
            </Border>
        </MPanel>
    </Panel>
</MView>
