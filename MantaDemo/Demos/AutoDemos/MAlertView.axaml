<MView
    x:Class="MantaDemo.Demos.AutoDemos.MAlertView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MAlertView_Model">
    <Design.DataContext>
        <local:MAlertView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MAlert Header="Success! Your changes have been saved">
                <MAlert.Icon>
                    <MPathIcon Size="16" UseStroke="True" Data="M9.388 4.29a4.302 4.302 0 0 0-6.127-.016c-1.688 1.705-1.68 4.476.016 6.189l6.277 6.34c.26.263.682.263.942 0l6.245-6.304a4.408 4.408 0 0 0-.017-6.187 4.305 4.305 0 0 0-6.135-.015l-.596.603-.605-.61Z M 0 0 M 20 20" />
                </MAlert.Icon>
                <TextBlock Text="This is an alert with icon, title and description." Opacity="0.5" />
            </MAlert>
            <MAlert Header="This Alert has a title and an icon. No description.">
                <MAlert.Icon>
                    <MPathIcon Size="16" UseStroke="True" Data="M9.388 4.29a4.302 4.302 0 0 0-6.127-.016c-1.688 1.705-1.68 4.476.016 6.189l6.277 6.34c.26.263.682.263.942 0l6.245-6.304a4.408 4.408 0 0 0-.017-6.187 4.305 4.305 0 0 0-6.135-.015l-.596.603-.605-.61Z M 0 0 M 20 20" />
                </MAlert.Icon>
            </MAlert>
            <MAlert Variant="Destructive" Header="Unable to process your payment.">
                <MAlert.Icon>
                    <MPathIcon Size="16" UseStroke="True" Data="M9.388 4.29a4.302 4.302 0 0 0-6.127-.016c-1.688 1.705-1.68 4.476.016 6.189l6.277 6.34c.26.263.682.263.942 0l6.245-6.304a4.408 4.408 0 0 0-.017-6.187 4.305 4.305 0 0 0-6.135-.015l-.596.603-.605-.61Z M 0 0 M 20 20" />
                </MAlert.Icon>
                <MPanel Mode="Vertical" Spacing="4">
                    <TextBlock Text="Please verify your billing information and try again." />
                    <MPanel Mode="Vertical">
                        <TextBlock Text="•  Check your card details" />
                        <TextBlock Text="•  Ensure sufficient funds" />
                        <TextBlock Text="•  Verify billing address" />
                    </MPanel>
                </MPanel>
            </MAlert>
        </MPanel>
    </Panel>
</MView>
