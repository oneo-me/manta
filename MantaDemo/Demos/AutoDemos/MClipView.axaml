<MView
    x:Class="MantaDemo.Demos.AutoDemos.MClipView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MClipView_Model">
    <Design.DataContext>
        <local:MClipView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Horizontal" Spacing="12" Margin="12">
            <MClip BorderThickness="10" Padding="20" CornerRadius="100" BoxShadow="0 0 30 #19000000">
                <Border Background="Bisque" Width="300" Height="300" />
            </MClip>
        </MPanel>
    </Panel>
</MView>
