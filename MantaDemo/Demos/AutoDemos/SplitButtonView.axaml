<MView
    x:Class="MantaDemo.Demos.AutoDemos.SplitButtonView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:SplitButtonView_Model">
    <Design.DataContext>
        <local:SplitButtonView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel Mode="Wrap" Spacing="12">
                <MSplitButton Content="Default" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Copy" />
                            <MMenuItem Header="Paste" />
                            <MMenuItem Header="-" />
                            <MMenuItem Header="Delete" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
                <MSplitButton Variant="Outline" Content="Outline" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
                <MSplitButton Variant="Secondary" Content="Secondary" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
                <MSplitButton Variant="Ghost" Content="Ghost" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
                <MSplitButton Variant="Destructive" Content="Destructive" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
            </MPanel>
            <TextBlock Text="Disabled" />
            <MPanel Mode="Wrap" Spacing="12" IsEnabled="False">
                <MSplitButton Content="Default" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Copy" />
                            <MMenuItem Header="Paste" />
                            <MMenuItem Header="-" />
                            <MMenuItem Header="Delete" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
                <MSplitButton Variant="Outline" Content="Outline" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
                <MSplitButton Variant="Secondary" Content="Secondary" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
                <MSplitButton Variant="Ghost" Content="Ghost" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
                <MSplitButton Variant="Destructive" Content="Destructive" HorizontalAlignment="Left">
                    <MSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MSplitButton.Flyout>
                </MSplitButton>
            </MPanel>
        </MPanel>
    </Panel>
</MView>
