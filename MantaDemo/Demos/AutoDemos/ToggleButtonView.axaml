<MView
    x:Class="MantaDemo.Demos.AutoDemos.ToggleButtonView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:ToggleButtonView_Model">
    <Design.DataContext>
        <local:ToggleButtonView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel.Styles>
                <Style Selector="MPathIcon.Checked">
                    <Setter Property="Foreground" Value="{MBrush Primary}" />
                </Style>
            </MPanel.Styles>
            <MPanel Mode="Wrap" Spacing="12">
                <MToggleButton Content="Bookmark" HorizontalAlignment="Left" IsChecked="True" />
                <MToggleButton HorizontalAlignment="Left" IsChecked="True">
                    <MPanel Mode="Horizontal" Spacing="8">
                        <MPathIcon Classes.Checked="{Binding $parent[MToggleButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" VerticalAlignment="Center" />
                        <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                    </MPanel>
                </MToggleButton>
                <MToggleButton HorizontalAlignment="Left">
                    <MPathIcon Classes.Checked="{Binding $parent[MToggleButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" />
                </MToggleButton>
            </MPanel>
            <TextBlock Text="Ghost" />
            <MPanel Mode="Wrap" Spacing="12">
                <MToggleButton Variant="Ghost" Content="Bookmark" HorizontalAlignment="Left" IsChecked="True" />
                <MToggleButton Variant="Ghost" HorizontalAlignment="Left" IsChecked="True">
                    <MPanel Mode="Horizontal" Spacing="8">
                        <MPathIcon Classes.Checked="{Binding $parent[MToggleButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" VerticalAlignment="Center" />
                        <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                    </MPanel>
                </MToggleButton>
                <MToggleButton Variant="Ghost" HorizontalAlignment="Left">
                    <MPathIcon Classes.Checked="{Binding $parent[MToggleButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" />
                </MToggleButton>
            </MPanel>
            <TextBlock Text="Disabled" />
            <MPanel Mode="Wrap" Spacing="12" IsEnabled="False">
                <MToggleButton Content="Bookmark" HorizontalAlignment="Left" IsChecked="True" />
                <MToggleButton HorizontalAlignment="Left" IsChecked="True">
                    <MPanel Mode="Horizontal" Spacing="8">
                        <MPathIcon Classes.Checked="{Binding $parent[MToggleButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" VerticalAlignment="Center" />
                        <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                    </MPanel>
                </MToggleButton>
                <MToggleButton HorizontalAlignment="Left">
                    <MPathIcon Classes.Checked="{Binding $parent[MToggleButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" />
                </MToggleButton>
            </MPanel>
            <TextBlock Text="Ghost Disabled" />
            <MPanel Mode="Wrap" Spacing="12" IsEnabled="False">
                <MToggleButton Variant="Ghost" Content="Bookmark" HorizontalAlignment="Left" IsChecked="True" />
                <MToggleButton Variant="Ghost" HorizontalAlignment="Left" IsChecked="True">
                    <MPanel Mode="Horizontal" Spacing="8">
                        <MPathIcon Classes.Checked="{Binding $parent[MToggleButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" VerticalAlignment="Center" />
                        <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                    </MPanel>
                </MToggleButton>
                <MToggleButton Variant="Ghost" HorizontalAlignment="Left">
                    <MPathIcon Classes.Checked="{Binding $parent[MToggleButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" />
                </MToggleButton>
            </MPanel>
        </MPanel>
    </Panel>
</MView>
