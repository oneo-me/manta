<MView
    x:Class="MantaDemo.Demos.AutoDemos.MTabStripView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MTabStripView_Model">
    <Design.DataContext>
        <local:MTabStripView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MTabStrip>
                <MTabStripItem Content="TabItem 1" IsSelected="True" />
                <MTabStripItem Content="TabItem 2" />
                <MTabStripItem Content="TabItem 3" />
            </MTabStrip>
            <MTabStrip Variant="Outline">
                <MTabStripItem Content="TabItem 1" IsSelected="True" />
                <MTabStripItem Content="TabItem 2" />
                <MTabStripItem Content="TabItem 3" />
            </MTabStrip>
        </MPanel>
    </Panel>
</MView>
