<MView
    x:Class="MantaDemo.Demos.AutoDemos.ViewHostView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:ViewHostView_Model">
    <Design.DataContext>
        <local:ViewHostView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MViewHost Width="300" Height="300" BorderThickness="1" />
        </MPanel>
    </Panel>
</MView>
