<MView
    x:Class="MantaDemo.Demos.AutoDemos.ProgressBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:ProgressBarView_Model">
    <Design.DataContext>
        <local:ProgressBarView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Text="Variant" />
            <MPanel Mode="Vertical" Spacing="12" Width="180" HorizontalAlignment="Left">
                <MProgressBar Variant="Default" IsIndeterminate="True" />
                <MProgressBar Variant="Destructive" IsIndeterminate="True" />
            </MPanel>
            <TextBlock Text="Vertical" />
            <MPanel Mode="Vertical" Spacing="12" Width="180" HorizontalAlignment="Left">
                <MProgressBar Value="50" Maximum="100" />
                <MProgressBar IsIndeterminate="True" />
                <MProgressBar ShowProgressText="True" Value="50" Maximum="100" />
                <MProgressBar ShowProgressText="True" IsIndeterminate="True" />
            </MPanel>
            <TextBlock Text="Horizontal" />
            <MPanel Mode="Horizontal" Spacing="12" Height="120" HorizontalAlignment="Left">
                <MProgressBar Orientation="Vertical" Value="50" Maximum="100" />
                <MProgressBar Orientation="Vertical" IsIndeterminate="True" />
                <MProgressBar ShowProgressText="True" Orientation="Vertical" Value="50" Maximum="100" />
                <MProgressBar ShowProgressText="True" Orientation="Vertical" IsIndeterminate="True" />
            </MPanel>
        </MPanel>
    </Panel>
</MView>
