<MView
    x:Class="MantaDemo.Demos.AutoDemos.MSeparatorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MSeparatorView_Model">
    <Design.DataContext>
        <local:MSeparatorView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MItems>
                <MItems.ItemsPanel>
                    <ItemsPanelTemplate>
                        <MPanel Mode="Vertical" Spacing="8" />
                    </ItemsPanelTemplate>
                </MItems.ItemsPanel>
                <MItem Content="Item 1" Width="120" HorizontalContentAlignment="Center" />
                <MSeparator />
                <MItem Content="Item 2" Width="120" HorizontalContentAlignment="Center" />
                <MItem Content="Item 3" Width="120" HorizontalContentAlignment="Center" />
            </MItems>
            <MItems>
                <MItems.ItemsPanel>
                    <ItemsPanelTemplate>
                        <MPanel Mode="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </MItems.ItemsPanel>
                <MItem Content="Item 1" Height="120" VerticalContentAlignment="Center" />
                <MSeparator Orientation="Vertical" />
                <MItem Content="Item 2" Height="120" VerticalContentAlignment="Center" />
                <MItem Content="Item 3" Height="120" VerticalContentAlignment="Center" />
            </MItems>
        </MPanel>
    </Panel>
</MView>
