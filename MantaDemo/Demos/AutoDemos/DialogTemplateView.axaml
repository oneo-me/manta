<MView
    x:Class="MantaDemo.Demos.AutoDemos.DialogTemplateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:DialogTemplateView_Model">
    <Design.DataContext>
        <local:DialogTemplateView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel.Styles>
                <Style Selector="MCard">
                    <Setter Property="MaxWidth" Value="520" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </MPanel.Styles>
            <MCard>
                <MDialogTemplate Header="Are you absolutely sure?">
                    <SelectableTextBlock Text="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
                                         TextWrapping="Wrap"
                                         Foreground="{MBrush MutedForeground}" />
                </MDialogTemplate>
            </MCard>
            <MCard>
                <MDialogTemplate Header="Are you absolutely sure?">
                    <MDialogTemplate.Footer>
                        <SelectableTextBlock Text="This Footer is custom!"
                                             Foreground="{MBrush MutedForeground}" />
                    </MDialogTemplate.Footer>
                    <SelectableTextBlock Text="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
                                         TextWrapping="Wrap"
                                         Foreground="{MBrush MutedForeground}" />
                </MDialogTemplate>
            </MCard>
            <MCard>
                <MDialogTemplate Header="Are you absolutely sure?" CancelButton="" ContinueButton="Delete Account" ContinueButtonVariant="Destructive">
                    <SelectableTextBlock Text="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
                                         TextWrapping="Wrap"
                                         Foreground="{MBrush MutedForeground}" />
                </MDialogTemplate>
            </MCard>
        </MPanel>
    </Panel>
</MView>
