<MView
    x:Class="MantaDemo.Demos.AutoDemos.MBackgroundView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MBackgroundView_Model">
    <Design.DataContext>
        <local:MBackgroundView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MBackground BorderThickness="1" Width="100" Height="100" />
        </MPanel>
    </Panel>
</MView>
