<MView
    x:Class="MantaDemo.Demos.AutoDemos.MCommandPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MCommandPanelView_Model">
    <Design.DataContext>
        <local:MCommandPanelView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MCard Width="320" Padding="0" CornerRadius="{MRadius LG}">
                <MCommandPanel Text="Test Search">
                    <MCommandPanelItem Variant="NoResults" Content="No results found." />
                </MCommandPanel>
            </MCard>
            <MCard Width="320" Padding="0" CornerRadius="{MRadius LG}">
                <MCommandPanel PlaceholderText="Type a command or search...">
                    <MCommandPanelItem Variant="Group" Content="Suggestions" />
                    <MCommandPanelItem>
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MPathIcon Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="Calendar" VerticalAlignment="Center" />
                        </MPanel>
                    </MCommandPanelItem>
                    <MCommandPanelItem>
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MPathIcon Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="Search Emoji" VerticalAlignment="Center" />
                        </MPanel>
                    </MCommandPanelItem>
                    <MCommandPanelItem IsEnabled="False">
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MPathIcon Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" Opacity="0.6" VerticalAlignment="Center" />
                            <TextBlock Text="Calculator" VerticalAlignment="Center" />
                        </MPanel>
                    </MCommandPanelItem>
                    <MCommandPanelItem Variant="Separator" />
                    <MCommandPanelItem Variant="Group" Content="Settings" />
                    <MCommandPanelItem>
                        <Grid ColumnDefinitions="* Auto">
                            <MPanel Grid.Column="0" Mode="Horizontal" Spacing="8">
                                <MPathIcon Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock Text="Profile" VerticalAlignment="Center" />
                            </MPanel>
                            <TextBlock Grid.Column="1" Text="⌘ P" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                    </MCommandPanelItem>
                    <MCommandPanelItem>
                        <Grid ColumnDefinitions="* Auto">
                            <MPanel Grid.Column="0" Mode="Horizontal" Spacing="8">
                                <MPathIcon Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock Text="Billing" VerticalAlignment="Center" />
                            </MPanel>
                            <TextBlock Grid.Column="1" Text="⌘ B" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                    </MCommandPanelItem>
                    <MCommandPanelItem>
                        <Grid ColumnDefinitions="* Auto">
                            <MPanel Grid.Column="0" Mode="Horizontal" Spacing="8">
                                <MPathIcon Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" Opacity="0.6" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </MPanel>
                            <TextBlock Grid.Column="1" Text="⌘ S" Opacity="0.6" VerticalAlignment="Center" />
                        </Grid>
                    </MCommandPanelItem>
                </MCommandPanel>
            </MCard>
        </MPanel>
    </Panel>
</MView>
