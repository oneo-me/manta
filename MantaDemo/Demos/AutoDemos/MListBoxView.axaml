<MView
    x:Class="MantaDemo.Demos.AutoDemos.MListBoxView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:MListBoxView_Model">
    <Design.DataContext>
        <local:MListBoxView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Horizontal" Spacing="12" Margin="12">
            <MPanel Mode="Vertical" Spacing="12">
                <TextBlock Text="Normal" />
                <MListBox BorderThickness="1" SelectedIndex="0">
                    <MListBox.ItemsSource>
                        <generic:List x:TypeArguments="system:String">
                            <system:String>0: Test 0</system:String>
                            <system:String>1: Test 1</system:String>
                            <system:String>2: Test 2</system:String>
                        </generic:List>
                    </MListBox.ItemsSource>
                    <MListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </MListBox.ItemTemplate>
                </MListBox>
            </MPanel>
            <MPanel Mode="Vertical" Spacing="12">
                <TextBlock Text="Sidebar" />
                <MListBox Variant="Sidebar" BorderThickness="1" SelectedIndex="0">
                    <MListBox.ItemsSource>
                        <generic:List x:TypeArguments="system:String">
                            <system:String>0: Test 0</system:String>
                            <system:String>1: Test 1</system:String>
                            <system:String>2: Test 2</system:String>
                        </generic:List>
                    </MListBox.ItemsSource>
                    <MListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </MListBox.ItemTemplate>
                </MListBox>
            </MPanel>
            <MPanel Mode="Vertical" Spacing="12">
                <TextBlock Text="NoStyle" />
                <MListBox Variant="NoStyle" BorderThickness="1" SelectedIndex="0">
                    <MListBox.ItemsSource>
                        <generic:List x:TypeArguments="system:String">
                            <system:String>0: Test 0</system:String>
                            <system:String>1: Test 1</system:String>
                            <system:String>2: Test 2</system:String>
                        </generic:List>
                    </MListBox.ItemsSource>
                    <MListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </MListBox.ItemTemplate>
                </MListBox>
            </MPanel>
        </MPanel>
    </Panel>
</MView>
