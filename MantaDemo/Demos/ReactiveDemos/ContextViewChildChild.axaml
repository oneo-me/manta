<MView
    x:Class="MantaDemo.Demos.ReactiveDemos.ContextViewChildChild"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ReactiveDemos"
    x:DataType="local:ContextViewChildChild_Model">
    <Design.DataContext>
        <local:ContextViewChildChild_Model />
    </Design.DataContext>
    <MPanel Mode="Vertical" Spacing="{MSize S3}" Margin="{MThickness S3}" HorizontalAlignment="Left">
        <TextBlock Text="Context Child Child" />
        <Border BorderThickness="{MThickness Px}"
                CornerRadius="{MRadius MD}"
                Background="{MBrush Primary, Opacity=0.1}">
            <MPanel Mode="Vertical" Spacing="{MSize S2}" Margin="{MThickness S3}" HorizontalAlignment="Left">
                <Grid ColumnSpacing="{MSize S2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TestBool" FontWeight="SemiBold" />
                    <MCheckBox Grid.Column="1" IsChecked="{Binding TestBool.Value.Value}" />
                </Grid>
                <Grid ColumnSpacing="{MSize S2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Source" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Data1" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Data1.Value}" />
                    <TextBlock Grid.Column="2" Text="{Binding Data1.Source}" Foreground="{MBrush MutedForeground}" />
                </Grid>
                <Grid ColumnSpacing="{MSize S2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Source" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Data2" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Data2.Value}" />
                    <TextBlock Grid.Column="2" Text="{Binding Data2.Source}" Foreground="{MBrush MutedForeground}" />
                </Grid>
                <Grid ColumnSpacing="{MSize S2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Source" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Data3" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Data3.Value}" />
                    <TextBlock Grid.Column="2" Text="{Binding Data3.Source}" Foreground="{MBrush MutedForeground}" />
                </Grid>
            </MPanel>
        </Border>
    </MPanel>
</MView>
