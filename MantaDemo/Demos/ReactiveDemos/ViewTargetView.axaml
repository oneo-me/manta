<MView
    x:Class="MantaDemo.Demos.ReactiveDemos.ViewTargetView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ReactiveDemos"
    x:DataType="local:ViewTargetView_Model">
    <Design.DataContext>
        <local:ViewTargetView_Model />
    </Design.DataContext>
    <MPanel Mode="Horizontal" Spacing="{MSize S3}" Margin="{MThickness S3}" HorizontalAlignment="Left" VerticalAlignment="Top">
        <MViewHost ViewModelType="local:ViewTargetViewChild_Model" Data="{Binding Current}"
                   Width="{MSize S52}" />
        <MListBox Variant="Sidebar"
                  Width="{MSize S32}"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Current}"
                  SelectionMode="AlwaysSelected" />
    </MPanel>
</MView>
