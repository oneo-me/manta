<MView
    x:Class="MantaDemo.Demos.ReactiveDemos.ContextView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ReactiveDemos"
    x:DataType="local:ContextView_Model" Design.DataContext="{x:Static local:ContextView_Model.Design}">
    <MPanel Mode="Vertical" Spacing="{MSize S3}" Margin="{MThickness S3}" HorizontalAlignment="Left">
        <TextBlock Text="Context" />
        <Border BorderThickness="{MThickness Px}"
                CornerRadius="{MRadius MD}"
                Background="{MBrush Primary, Opacity=0.1}">
            <MPanel Mode="Vertical" Spacing="{MSize S2}" Margin="{MThickness S3}" HorizontalAlignment="Left">
                <Grid ColumnSpacing="{MSize S2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TestBool" FontWeight="SemiBold" />
                    <MCheckBox Grid.Column="1" IsChecked="{Binding TestBool.Value}" />
                </Grid>
                <Grid ColumnSpacing="{MSize S2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Data1" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Data1}" />
                </Grid>
                <Grid ColumnSpacing="{MSize S2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Key" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Data2" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Data2}" />
                </Grid>
            </MPanel>
        </Border>
        <MViewHost ViewModelType="local:ContextViewChild_Model"
                   BorderThickness="{MThickness Px}"
                   CornerRadius="{MRadius MD}" />
    </MPanel>
</MView>
