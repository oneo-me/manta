<MView
    x:Class="MantaDemo.Demos.ReactiveDemos.ViewTargetViewChild"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ReactiveDemos"
    x:DataType="local:ViewTargetViewChild_Model" Design.DataContext="{x:Static local:ViewTargetViewChild_Model.Design}">
    <Border BorderThickness="{MThickness Px}"
            CornerRadius="{MRadius MD}"
            Background="{MBrush Primary, Opacity=0.1}">
        <MPanel Mode="Vertical" Spacing="{MSize S2}" Margin="{MThickness S2}">
            <TextBlock Text="{Binding Time, StringFormat=Time: {0}}" />
            <TextBlock Text="{Binding Data}" />
        </MPanel>
    </Border>
</MView>
