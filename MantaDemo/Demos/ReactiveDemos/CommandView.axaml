<MView
    x:Class="MantaDemo.Demos.ReactiveDemos.CommandView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ReactiveDemos"
    x:DataType="local:CommandView_Model" Design.DataContext="{x:Static local:CommandView_Model.Design}">
    <MPanel Mode="Vertical" Spacing="12" Margin="12">
        <TextBlock Text="Bind to method" />
        <MPanel Mode="Horizontal" Spacing="12">
            <MButton Variant="Outline" Content="Sync" Command="{Binding Execute}" />
            <MButton Variant="Outline" Content="Async" Command="{Binding ExecuteAsync}" IsEnabled="{Binding !IsExecuting}" />
            <MButton Variant="Outline" Command="{Binding ExecuteAsync}" IsEnabled="{Binding !IsExecuting}">
                <MPanel Mode="Horizontal" Spacing="8">
                    <MProgressRing IsVisible="{Binding IsExecuting}"
                                   IsIndeterminate="{Binding IsExecuting}"
                                   RingSize="18" RingStrokeSize="2"
                                   Margin="0 -20" VerticalAlignment="Center"
                                   RingBackground="{MBrush Primary, Opacity=0.2}"
                                   RingForeground="{MBrush Primary}" />
                    <TextBlock Text="Executing" IsVisible="{Binding IsExecuting}" />
                    <TextBlock Text="Async (Animation)" IsVisible="{Binding !IsExecuting}" />
                </MPanel>
            </MButton>
        </MPanel>
        <TextBlock Text="Bind to command" />
        <MCheckBox Header="Can executed" IsChecked="{Binding CanExecuted}" />
        <MPanel Mode="Horizontal" Spacing="12">
            <MButton Variant="Outline" Content="Sync" Command="{Binding ExecuteCommand}" />
            <MButton Variant="Outline" Content="Async" Command="{Binding ExecuteAsyncCommand}" />
            <MButton Variant="Outline" Command="{Binding ExecuteAsyncCommand}">
                <MPanel Mode="Horizontal" Spacing="8">
                    <MProgressRing IsVisible="{Binding ExecuteAsyncCommand.IsExecuting}"
                                   IsIndeterminate="{Binding ExecuteAsyncCommand.IsExecuting}"
                                   RingSize="18" RingStrokeSize="2"
                                   Margin="0 -20" VerticalAlignment="Center"
                                   RingBackground="{MBrush Primary, Opacity=0.2}"
                                   RingForeground="{MBrush Primary}" />
                    <TextBlock Text="Executing" IsVisible="{Binding ExecuteAsyncCommand.IsExecuting}" />
                    <TextBlock Text="Async (Animation)" IsVisible="{Binding !ExecuteAsyncCommand.IsExecuting}" />
                </MPanel>
            </MButton>
        </MPanel>
    </MPanel>
</MView>
