<MView
    x:Class="MantaDemo.Demos.ReactiveDemos.CommandView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ReactiveDemos"
    x:DataType="local:CommandView_Model">
    <Design.DataContext>
        <local:CommandView_Model />
    </Design.DataContext>
    <MPanel Mode="Vertical" Spacing="12" Margin="12">
        <TextBlock Text="Bind to command" />
        <MCheckBox Header="Can executed" IsChecked="{Binding CanExecuted}" />
        <TextBlock Text="{Binding ClickCount, StringFormat=Click Count: {0}}" Foreground="{MBrush MutedForeground}" />
        <MPanel Mode="Horizontal" Spacing="12">
            <MButton Variant="Outline" Content="Sync" Command="{Binding ExecuteCommand}" />
            <MButton Variant="Outline" Content="Async" Command="{Binding ExecuteAsyncCommand}" />
            <MButton Variant="Outline" Command="{Binding ExecuteAsyncCommand}">
                <MPanel Mode="Horizontal" Spacing="8">
                    <MProgressRing IsVisible="{Binding ExecuteAsyncCommand.IsExecuting}"
                                   IsIndeterminate="{Binding ExecuteAsyncCommand.IsExecuting}"
                                   RingSize="18" RingStrokeSize="2"
                                   Margin="0 -20" VerticalAlignment="Center"
                                   RingBackground="{MBrush Primary, Opacity=0.2}"
                                   RingForeground="{MBrush Primary}" />
                    <TextBlock Text="Executing" IsVisible="{Binding ExecuteAsyncCommand.IsExecuting}" />
                    <TextBlock Text="Async (Animation)" IsVisible="{Binding !ExecuteAsyncCommand.IsExecuting}" />
                </MPanel>
            </MButton>
        </MPanel>
        <TextBlock Text="DragDropCommand" />
        <Border Background="{MBrush Muted}" BorderThickness="1" CornerRadius="6" Padding="8" Width="320" HorizontalAlignment="Left"
                DragDropCommand.Command="{Binding DragDropCommand}">
            <MPanel Mode="Vertical" VerticalAlignment="Center">
                <TextBlock Text="Drop something here" Foreground="{MBrush MutedForeground}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DropFile}" TextTrimming="PathSegmentEllipsis"
                           Foreground="{MBrush MutedForeground}" HorizontalAlignment="Center"
                           IsVisible="{Binding DropFile, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </MPanel>
        </Border>
        <TextBlock Text="DoubleTappedCommand" />
        <Border Background="{MBrush Muted}" BorderThickness="1" CornerRadius="6" Padding="8" Width="320" HorizontalAlignment="Left"
                DoubleTappedCommand.Command="{Binding DoubleTappedCommand}">
            <MPanel Mode="Vertical" VerticalAlignment="Center">
                <TextBlock Text="Double click here" Foreground="{MBrush MutedForeground}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DoubleClickCount}"
                           Foreground="{MBrush MutedForeground}" HorizontalAlignment="Center"
                           IsVisible="{Binding DoubleClickCount}" />
            </MPanel>
        </Border>
    </MPanel>
</MView>
