<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PublishAot>true</PublishAot>
        <NoWarn>IL2057;IL2026;IL2080;IL2104;IL3053</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <TrimmerRootDescriptor Include="Program.xml" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\Axe.Controls\Axe.Controls.csproj" />
        <ProjectReference Include="..\..\Axe.I18N.Avalonia\Axe.I18N.Avalonia.csproj" />
        <ProjectReference Include="..\..\Axe.Logging.Avalonia\Axe.Logging.Avalonia.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Bogus" Version="35.6.4" />
    </ItemGroup>
    <ItemGroup>
        <AvaloniaResource Include="Langs\*.yml" />
        <AdditionalFiles Include="Langs\*.yml" />
        <ProjectReference Include="..\..\Axe.I18N.Generator\Axe.I18N.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
