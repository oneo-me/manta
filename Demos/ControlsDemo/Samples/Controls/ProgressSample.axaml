<View
    x:Class="ControlsDemo.Samples.Controls.ProgressSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ControlsDemo.Samples.Controls"
    x:DataType="local:ProgressSample_Model">
    <Design.DataContext>
        <local:ProgressSample_Model />
    </Design.DataContext>
    <ScrollViewer>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Classes="Title" Text="ProgressRing" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <ProgressRing Value="0" />
                <ProgressRing Value="50" />
                <ProgressRing Value="100" />
                <ProgressRing IsIndeterminate="True" />
                <ProgressRing ShowProgressText="True" Value="50" Maximum="100" />
                <ProgressRing ShowProgressText="True" IsIndeterminate="True">
                    <Border Background="{ThemeCommonBrush Primary, Opacity=0.3}" Width="300" Height="300" />
                </ProgressRing>
            </PanelExt>
            <TextBlock Classes="Title" Text="ProgressBar" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <PanelExt Mode="Vertical" Spacing="12" Width="180">
                    <ProgressBar Value="50" Maximum="100" />
                    <ProgressBar IsIndeterminate="True" />
                    <ProgressBar ShowProgressText="True" Value="50" Maximum="100" />
                    <ProgressBar ShowProgressText="True" IsIndeterminate="True" />
                </PanelExt>
                <PanelExt Mode="Horizontal" Spacing="12" Height="120" HorizontalAlignment="Center">
                    <ProgressBar Orientation="Vertical" Value="50" Maximum="100" />
                    <ProgressBar Orientation="Vertical" IsIndeterminate="True" />
                    <ProgressBar ShowProgressText="True" Orientation="Vertical" Value="50" Maximum="100" />
                    <ProgressBar ShowProgressText="True" Orientation="Vertical" IsIndeterminate="True" />
                </PanelExt>
            </PanelExt>
            <TextBlock Classes="Title" Text="Slider" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <PanelExt Mode="Vertical" Spacing="12" Width="180">
                    <Slider IsDirectionReversed="False" Value="50" />
                    <Slider IsDirectionReversed="True" Value="50" />
                    <Slider Value="50" TickPlacement="TopLeft" TickFrequency="10" />
                    <Slider Value="50" IsSnapToTickEnabled="True" TickPlacement="BottomRight" TickFrequency="10" />
                    <Slider Value="50" TickPlacement="Outside" TickFrequency="10" />
                    <Slider IsEnabled="False" Value="50" />
                </PanelExt>
                <PanelExt Mode="Horizontal" Spacing="12" Height="120" VerticalAlignment="Top">
                    <Slider Value="50" Orientation="Vertical" />
                    <Slider IsDirectionReversed="True" Value="50" Orientation="Vertical" />
                    <Slider IsEnabled="False" Orientation="Vertical" Value="50" />
                    <Slider Value="50" TickPlacement="TopLeft" TickFrequency="10" Orientation="Vertical" />
                    <Slider Value="50" IsSnapToTickEnabled="True" TickPlacement="BottomRight" TickFrequency="10" Orientation="Vertical" />
                    <Slider Value="50" TickPlacement="Outside" TickFrequency="10" Orientation="Vertical" />
                </PanelExt>
            </PanelExt>
        </PanelExt>
    </ScrollViewer>
</View>
