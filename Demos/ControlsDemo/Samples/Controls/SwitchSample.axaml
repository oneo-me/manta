<View
    x:Class="ControlsDemo.Samples.Controls.SwitchSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ControlsDemo.Samples.Controls"
    x:DataType="local:SwitchSample_Model">
    <Design.DataContext>
        <local:SwitchSample_Model />
    </Design.DataContext>
    <ScrollViewer>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Classes="Title" Text="CheckBox" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <CheckBox Content="CheckBox" />
                <CheckBox Content="CheckBox" IsChecked="True" />
                <CheckBox Content="CheckBox" IsChecked="{x:Null}" />
            </PanelExt>
            <TextBlock Classes="Title" Text="RadioButton" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <RadioButton Content="RadioButton" />
                <RadioButton Content="RadioButton" IsChecked="True" />
            </PanelExt>
            <TextBlock Classes="Title" Text="ToggleSwitch" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <ToggleSwitch />
                <ToggleSwitch IsChecked="True" />
            </PanelExt>
            <PanelExt Mode="Horizontal" Spacing="12">
                <ToggleSwitch OffContent="Custom Off" OnContent="Custom On" />
                <ToggleSwitch OffContent="Custom Off" OnContent="Custom On" IsChecked="True" />
            </PanelExt>
            <PanelExt Mode="Horizontal" Spacing="12">
                <ToggleSwitch Content="Header Content" OffContent="Custom Off" OnContent="Custom On" />
                <ToggleSwitch Content="Header Content" OffContent="Custom Off" OnContent="Custom On" IsChecked="True" />
            </PanelExt>
            <TextBlock Classes="Title" Text="ToggleButton" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <ToggleButton Content="ToggleButton" />
                <ToggleButton Content="ToggleButton" IsChecked="True" />
            </PanelExt>
        </PanelExt>
    </ScrollViewer>
</View>
