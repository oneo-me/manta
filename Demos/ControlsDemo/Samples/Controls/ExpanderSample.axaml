<View
    x:Class="ControlsDemo.Samples.Controls.ExpanderSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ControlsDemo.Samples.Controls"
    x:DataType="local:ExpanderSample_Model">
    <Design.DataContext>
        <local:ExpanderSample_Model />
    </Design.DataContext>
    <ScrollViewer>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Classes="Title" Text="Expander" />
            <AutoGrid Definitions="*,*" Spacing="12">
                <Expander Header="Expanded Left" Content="Expanded Content" ExpandDirection="Left" IsExpanded="True" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius MD}" />
                <Expander Header="Expanded Right" Content="Expanded Content" ExpandDirection="Right" IsExpanded="True" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius MD}" />
                <Expander Header="Expanded Up" Content="Expanded Content" ExpandDirection="Up" IsExpanded="True" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius MD}" />
                <Expander Header="Expanded Down" Content="Expanded Content" ExpandDirection="Down" IsExpanded="True" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius MD}" />
            </AutoGrid>
        </PanelExt>
    </ScrollViewer>
</View>
