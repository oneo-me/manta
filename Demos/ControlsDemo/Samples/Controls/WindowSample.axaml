<View
    x:Class="ControlsDemo.Samples.Controls.WindowSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ControlsDemo.Samples.Controls"
    x:DataType="local:WindowSample_Model">
    <Design.DataContext>
        <local:WindowSample_Model />
    </Design.DataContext>
    <ScrollViewer>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Classes="Title" Text="Normal" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <Button Classes="Button-Primary" Content="Window" Command="{Binding OpenWindowAsync}" />
                <Button Classes="Button-Primary" Content="Mini Window" Command="{Binding OpenMiniWindowAsync}" />
                <Button Classes="Button-Primary" Content="OnlyBorder Window" Command="{Binding OpenOnlyBorderWindowAsync}" />
                <Button Classes="Button-Primary" Content="Native Window" Command="{Binding OpenNativeWindowAsync}" />
            </PanelExt>
        </PanelExt>
    </ScrollViewer>
</View>
