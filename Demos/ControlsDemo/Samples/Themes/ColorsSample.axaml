<View
    x:Class="ControlsDemo.Samples.Themes.ColorsSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ControlsDemo.Samples.Themes"
    x:DataType="local:ColorsSample_Model">
    <Design.DataContext>
        <local:ColorsSample_Model />
    </Design.DataContext>
    <View.Styles>
        <Style Selector="Border.ColorBlock">
            <Setter Property="Padding" Value="{ThemeThickness Padding}" />
            <Setter Property="CornerRadius" Value="{ThemeRadius Normal}" />
            <Setter Property="BorderThickness" Value="{ThemeThickness Normal}" />
            <Style Selector="^ PanelExt">
                <Setter Property="Mode" Value="Vertical" />
            </Style>
            <Style Selector="^ TextBlock">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
        </Style>
        <Style Selector="BackgroundBlur#BackgroundBlur">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
    </View.Styles>
    <Panel>
        <BackgroundBlur x:Name="BackgroundBlur" VerticalAlignment="Top" ZIndex="1" Background="{ThemeCommonBrush Background, Opacity=0.8}" BorderBrush="{ThemeCommonBrush BorderBrush}" BorderThickness="0 0 0 1"
                        IsHitTestVisible="False">
            <TextBlock Text="Colors" FontWeight="Bold" FontSize="14" Margin="12" HorizontalAlignment="Center" />
        </BackgroundBlur>
        <ScrollViewer x:Name="ScrollViewer">
            <PanelExt Mode="Vertical" Spacing="12" Margin="12">
                <TextBlock Classes="Title" Text="Primary Colors" />
                <PanelExt Mode="WrapFull" Spacing="12">
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Primary}" TextElement.Foreground="{ThemeCommonBrush Primary_Foreground}">
                        <PanelExt>
                            <TextBlock Text="Primary" />
                            <Label Content="{ThemeCommonBrush Primary}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Success}" TextElement.Foreground="{ThemeCommonBrush Success_Foreground}">
                        <PanelExt>
                            <TextBlock Text="Success" />
                            <Label Content="{ThemeCommonBrush Success}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Warning}" TextElement.Foreground="{ThemeCommonBrush Warning_Foreground}">
                        <PanelExt>
                            <TextBlock Text="Warning" />
                            <Label Content="{ThemeCommonBrush Warning}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Error}" TextElement.Foreground="{ThemeCommonBrush Error_Foreground}">
                        <PanelExt>
                            <TextBlock Text="Error" />
                            <Label Content="{ThemeCommonBrush Error}" />
                        </PanelExt>
                    </Border>
                </PanelExt>
                <TextBlock Classes="Title" Text="Other Colors" />
                <PanelExt Mode="WrapFull" Spacing="12">
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Shadow}" TextElement.Foreground="White">
                        <PanelExt>
                            <TextBlock Text="Shadow" />
                            <Label Content="{ThemeCommonBrush Shadow}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush MaskBrush}" TextElement.Foreground="{ThemeCommonBrush Foreground}">
                        <PanelExt>
                            <TextBlock Text="MaskBrush" />
                            <Label Content="{ThemeCommonBrush MaskBrush}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Window_Background}" TextElement.Foreground="{ThemeCommonBrush Foreground}">
                        <PanelExt>
                            <TextBlock Text="Window_Background" />
                            <Label Content="{ThemeCommonBrush Window_Background}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Background}" TextElement.Foreground="{ThemeCommonBrush Foreground}">
                        <PanelExt>
                            <TextBlock Text="Background" />
                            <Label Content="{ThemeCommonBrush Background}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Foreground}" TextElement.Foreground="{ThemeCommonBrush Background}">
                        <PanelExt>
                            <TextBlock Text="Foreground" />
                            <Label Content="{ThemeCommonBrush Foreground}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush BorderBrush}" TextElement.Foreground="{ThemeCommonBrush Foreground}">
                        <PanelExt>
                            <TextBlock Text="BorderBrush" />
                            <Label Content="{ThemeCommonBrush BorderBrush}" />
                        </PanelExt>
                    </Border>
                </PanelExt>
                <TextBlock Classes="Title" Text="Flyout Colors" />
                <PanelExt Mode="WrapFull" Spacing="12">
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Flyout_Background}" TextElement.Foreground="{ThemeCommonBrush Flyout_Foreground}">
                        <PanelExt>
                            <TextBlock Text="Flyout_Background" />
                            <Label Content="{ThemeCommonBrush Flyout_Background}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Flyout_Foreground}" TextElement.Foreground="{ThemeCommonBrush Flyout_Background}">
                        <PanelExt>
                            <TextBlock Text="Flyout_Foreground" />
                            <Label Content="{ThemeCommonBrush Flyout_Foreground}" />
                        </PanelExt>
                    </Border>
                    <Border Classes="ColorBlock" Background="{ThemeCommonBrush Flyout_BorderBrush}" TextElement.Foreground="{ThemeCommonBrush Flyout_Foreground}">
                        <PanelExt>
                            <TextBlock Text="Flyout_BorderBrush" />
                            <Label Content="{ThemeCommonBrush Flyout_BorderBrush}" />
                        </PanelExt>
                    </Border>
                </PanelExt>
            </PanelExt>
        </ScrollViewer>
    </Panel>
</View>
