<View
    x:Class="ControlsDemo.Samples.Themes.ThemeScopeSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ControlsDemo.Samples.Themes"
    x:DataType="local:ThemeScopeSample_Model" Design.Width="800">
    <Design.DataContext>
        <local:ThemeScopeSample_Model />
    </Design.DataContext>
    <Grid ColumnDefinitions="*,*" Margin="{ThemeThickness Normal}">
        <ThemeVariantScope Grid.Column="0" RequestedThemeVariant="Light">
            <ClipContentControl Background="{ThemeBrush Background}" Margin="{ThemeThickness Normal}" CornerRadius="{ThemeRadius MD}" BorderThickness="{ThemeThickness Normal}">
                <ViewModelHost />
            </ClipContentControl>
        </ThemeVariantScope>
        <ThemeVariantScope Grid.Column="1" RequestedThemeVariant="Dark">
            <ClipContentControl Background="{ThemeBrush Background}" Margin="{ThemeThickness Normal}" CornerRadius="{ThemeRadius MD}" BorderThickness="{ThemeThickness Normal}">
                <ViewModelHost />
            </ClipContentControl>
        </ThemeVariantScope>
    </Grid>
</View>
