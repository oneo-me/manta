<View
    x:Class="ControlsDemo.Samples.Reactive.RegionManagerSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ControlsDemo.Samples.Reactive"
    x:DataType="local:RegionManagerSample_Model" Design.Width="500">
    <Design.DataContext>
        <local:RegionManagerSample_Model />
    </Design.DataContext>
    <View.Styles>
        <Style Selector="Button.CloseButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <PathIcon Classes="Icon-Close" Width="6" Height="6" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.1" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
            <Setter Property="CornerRadius" Value="{ThemeRadius MD}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="{ThemeBrush Error, Opacity=0}" />
            <Setter Property="Foreground" Value="{ThemeBrush Foreground}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{ThemeBrush Error}" />
                <Setter Property="Foreground" Value="{ThemeBrush Error_Foreground}" />
            </Style>
        </Style>
        <Style Selector="TabStrip.TabStrip">
            <Setter Property="BorderThickness" Value="{ThemeThickness Normal, Filter=Bottom}" />
            <Style Selector="^ TabStripItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="{ThemeThickness Normal, Filter=Bottom}" />
                <Setter Property="BorderThickness" Value="{ThemeThickness Normal, Filter=Bottom}" />
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.1" />
                        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                    </Transitions>
                </Setter>
                <Setter Property="Background" Value="{ThemeBrush Primary, Opacity=0}" />
                <Setter Property="Foreground" Value="{ThemeBrush Foreground}" />
                <Setter Property="BorderBrush" Value="{ThemeBrush Primary, Opacity=0}" />
                <Style Selector="^:selected">
                    <Setter Property="Background" Value="{ThemeBrush Primary, Opacity=0.1}" />
                    <Setter Property="Foreground" Value="{ThemeBrush Primary}" />
                    <Setter Property="BorderBrush" Value="{ThemeBrush Primary}" />
                </Style>
            </Style>
        </Style>
    </View.Styles>
    <Grid RowDefinitions="Auto,*" Margin="12">
        <PanelExt Grid.Row="0" Mode="Horizontal" Margin="0 0 0 12">
            <Button Classes="Button-Primary" Content="{Binding Index, StringFormat=Add item (id: {0})}" Command="{Binding Add}" />
        </PanelExt>
        <PanelExt Grid.Row="1">
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding RegionManager.Items.Count}">
                <TabStrip Grid.Row="0" Classes="TabStrip" ItemsSource="{Binding RegionManager.Items}" SelectedItem="{Binding RegionManager.SelectedItem}">
                    <TabStrip.ItemTemplate>
                        <DataTemplate DataType="local:RegionItemView_Model">
                            <AutoGrid Definitions="*,Auto" Spacing="8">
                                <Button Classes="CloseButton" Command="{Binding Close}" VerticalAlignment="Center" />
                            </AutoGrid>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
                <ViewModelHost Grid.Row="1" ViewModel="{Binding RegionManager.SelectedItem}" />
            </Grid>
            <TextBlock Text="No ttripab opened" IsVisible="{Binding !RegionManager.Items.Count}" Margin="{ThemeThickness Normal}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </PanelExt>
    </Grid>
</View>
