<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="ControlsDemo.App" RequestedThemeVariant="Default">
    <Application.Styles>
        <AxeVariables />
        <AxeReactive />
        <AxeControls />
        <StyleInclude Source="Styles/_Icons.axaml" />
        <StyleInclude Source="Styles/SampleStyles.axaml" />
    </Application.Styles>
</Application>
