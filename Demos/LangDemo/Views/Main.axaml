<View
    x:Class="LangDemo.Views.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LangDemo.Views"
    xmlns:lang="clr-namespace:Axe.I18N.Core;assembly=Axe.I18N"
    x:DataType="local:Main_Model">
    <Design.DataContext>
        <local:Main_Model />
    </Design.DataContext>
    <Grid RowDefinitions="Auto *">
        <TitleBarExt Grid.Row="0" x:Name="TitleBar" />
        <Grid Grid.Row="1" ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Spacing="12" Margin="12">
                <TextBlock Text="Native Name" FontWeight="Bold" />
                <TextBlock Text="{LangName {x:Static lang:LangType.en}}" />
                <TextBlock Text="{LangName {x:Static lang:LangType.zh_Hans}}" />
                <TextBlock Text="Lang Key" FontWeight="Bold" />
                <TextBlock Text="{Lang {x:Static InnerLangKey.Test}}" />
                <TextBlock Text="{Lang NotKey}" />
            </StackPanel>
        </Grid>
    </Grid>
</View>
