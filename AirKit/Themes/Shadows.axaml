<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <BoxShadows x:Key="{ThemeShadowKey None}">0 0 0 0 #00000000</BoxShadows>
    <Thickness x:Key="{ThemeThicknessKey Shadow0}">0</Thickness>
    <BoxShadows x:Key="{ThemeShadowKey Shadow1}">0 1 2 0 #7F000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Shadow2}">0 1 3 0 #000000, 0 1 2 -1 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Shadow3}">0 4 6 -1 #000000, 0 2 4 -2 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Shadow4}">0 10 15 -3 #000000, 0 4 6 -4 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Shadow5}">0 20 25 -5 #000000, 0 8 10 -6 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Shadow6}">0 30 50 -7 #000000, 0 12 25 -8 #000000</BoxShadows>
    <Thickness x:Key="{ThemeThicknessKey Shadow1}">-2 -1 -2 -3</Thickness>
    <Thickness x:Key="{ThemeThicknessKey Shadow2}">-3 -2 -3 -4</Thickness>
    <Thickness x:Key="{ThemeThicknessKey Shadow3}">-5 -1 -5 -9</Thickness>
    <Thickness x:Key="{ThemeThicknessKey Shadow4}">-12 -2 -12 -22</Thickness>
    <Thickness x:Key="{ThemeThicknessKey Shadow5}">-20 -5 -20 -55</Thickness>
    <Thickness x:Key="{ThemeThicknessKey Shadow6}">-43 -13 -43 -73</Thickness>
    <BoxShadows x:Key="{ThemeShadowKey InnerShadow1}">inset 0 0 5 3 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerShadow2}">inset 0 0 10 5 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerShadow3}">inset 0 0 15 8 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerShadow4}">inset 0 0 25 12 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerShadow5}">inset 0 0 40 18 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerShadow6}">inset 0 0 35 22 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Border1}">0 0 0 1 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Border2}">0 0 0 2 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Border3}">0 0 0 3 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Border4}">0 0 0 4 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Border5}">0 0 0 5 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey Border6}">0 0 0 6 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerBorder1}">inset 0 0 0 1 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerBorder2}">inset 0 0 0 2 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerBorder3}">inset 0 0 0 3 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerBorder4}">inset 0 0 0 4 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerBorder5}">inset 0 0 0 5 #000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InnerBorder6}">inset 0 0 0 6 #000000</BoxShadows>
</ResourceDictionary>
