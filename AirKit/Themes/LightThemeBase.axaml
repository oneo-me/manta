<Styles
    x:Class="AirKit.Themes.LightThemeBase"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="/Controls/Base/Border.axaml" />
                <MergeResourceInclude Source="/Controls/Base/Window.axaml" />
                <MergeResourceInclude Source="/Controls/LightClip.axaml" />
                <MergeResourceInclude Source="/Controls/LightPath.axaml" />
                <MergeResourceInclude Source="/Controls/LightScrollBar.axaml" />
                <MergeResourceInclude Source="/Controls/LightScrollViewer.axaml" />
                <MergeResourceInclude Source="/Controls/LightThumb.axaml" />
                <MergeResourceInclude Source="/Controls/LightTitleBarButton.axaml" />
                <MergeResourceInclude Source="/Controls/LightTitleBarButtons.axaml" />
                <MergeResourceInclude Source="/Controls/LightViewHost.axaml" />
                <MergeResourceInclude Source="/Controls/LightWindow.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <DefaultTheme />
</Styles>
