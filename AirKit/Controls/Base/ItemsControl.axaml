<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <ItemsControl BorderThickness="1">
                <ItemsControl.ItemsSource>
                    <generic:List x:TypeArguments="system:String">
                        <system:String>0: Test 0</system:String>
                        <system:String>1: Test 1</system:String>
                        <system:String>2: Test 2</system:String>
                    </generic:List>
                </ItemsControl.ItemsSource>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </PanelExt>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type ItemsControl}" TargetType="ItemsControl">
        <Setter Property="Background" Value="{ThemeBrush Background, Opacity=0}" />
        <Setter Property="BorderBrush" Value="{ThemeBrush BorderBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ItemsPresenter x:Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
