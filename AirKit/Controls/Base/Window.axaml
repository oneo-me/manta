<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <TextBlock Text="Design Model" Margin="30" />
    </Design.PreviewWith>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MacBackground" Color="#00000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MacBackground" Color="#00000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MacBackground" Color="#666666" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <ControlTheme x:Key="{x:Type Window}" TargetType="Window">
        <Setter Property="Title" Value="AirKit" />
        <Setter Property="FontSize" Value="{ThemeNumber FontSize}" />
        <Setter Property="Foreground" Value="{ThemeBrush Foreground}" />
        <Setter Property="Background" Value="{ThemeBrush Window_Background}" />
        <Style Selector="^[(DesignMode.IsDesign)=False]">
            <Setter Property="WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="BorderBrush" Value="{ThemeBrush BorderBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel x:Name="Root">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" />
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Margin="{ TemplateBinding OffScreenMargin}">
                            <VisualLayerManager>
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Content="{TemplateBinding Content}" />
                            </VisualLayerManager>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <!-- Windows -->
            <Style Selector="^[(CurrentSystem.IsWindows)=True]">
                <Setter Property="BorderThickness" Value="1" />
                <Style Selector="^[WindowState=Maximized]">
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
                <Style Selector="^[WindowState=FullScreen]">
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
                <Setter Property="TransparencyLevelHint" Value="AcrylicBlur,Blur,Mica,None" />
                <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
                <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="3" />
                <Setter Property="ExtendClientAreaChromeHints" Value="SystemChrome" />
                <Style Selector="^ /template/ Border#Background">
                    <Setter Property="Opacity" Value="0.8" />
                </Style>
            </Style>
            <!-- macOS -->
            <Style Selector="^[(CurrentSystem.IsMacOS)=True]">
                <Setter Property="TransparencyLevelHint" Value="AcrylicBlur,Blur,Mica,None" />
                <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
                <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />
                <Setter Property="ExtendClientAreaChromeHints" Value="PreferSystemChrome,OSXThickTitleBar" />
                <Style Selector="^ /template/ Border#Background">
                    <Setter Property="Opacity" Value="0.7" />
                </Style>
                <Style Selector="^[IsActive=False] /template/ Panel#Root">
                    <Setter Property="Background" Value="{DynamicResource MacBackground}" />
                </Style>
            </Style>
            <!-- Linux -->
            <Style Selector="^[(CurrentSystem.IsLinux)=True]">
                <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
                <Setter Property="ExtendClientAreaChromeHints" Value="NoChrome" />
                <Setter Property="SystemDecorations" Value="None" />
                <Setter Property="BorderThickness" Value="1" />
                <Style Selector="^[WindowState=Maximized]">
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
                <Style Selector="^[WindowState=FullScreen]">
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^[(DesignMode.IsDesign)=True]">
            <Setter Property="Background" Value="{ThemeBrush Background}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <Panel Opacity="0.1">
                            <Panel.Background>
                                <VisualBrush TileMode="Tile" DestinationRect="0 0 20 20">
                                    <VisualBrush.Visual>
                                        <Grid ColumnDefinitions="10 10" RowDefinitions="10 10">
                                            <Border Grid.Column="0" Grid.Row="0" Background="{Binding ElementName=Black, Path=BorderBrush}" />
                                            <Border Grid.Column="1" Grid.Row="0" Background="{Binding ElementName=White, Path=BorderBrush}" />
                                            <Border Grid.Column="0" Grid.Row="1" Background="{Binding ElementName=White, Path=BorderBrush}" />
                                            <Border Grid.Column="1" Grid.Row="1" Background="{Binding ElementName=Black, Path=BorderBrush}" />
                                        </Grid>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Panel.Background>
                            <Border x:Name="Black" BorderBrush="{TemplateBinding Background}" />
                            <Border x:Name="White" BorderBrush="{TemplateBinding Foreground}" />
                        </Panel>
                        <VisualLayerManager>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}" />
                        </VisualLayerManager>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
