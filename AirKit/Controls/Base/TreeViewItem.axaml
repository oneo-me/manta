<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <TreeView>
                <TreeViewItem Header="Test Item 0">
                    <TreeViewItem Header="Test Item 0" />
                    <TreeViewItem Header="Test Item 1" />
                    <TreeViewItem Header="Test Item 2" />
                </TreeViewItem>
                <TreeViewItem Header="Test Item 1">
                    <TreeViewItem Header="Test Item 0" />
                    <TreeViewItem Header="Test Item 1">
                        <TreeViewItem Header="Test Item 0" />
                        <TreeViewItem Header="Test Item 1" />
                        <TreeViewItem Header="Test Item 2" />
                    </TreeViewItem>
                    <TreeViewItem Header="Test Item 2" />
                </TreeViewItem>
                <TreeViewItem Header="Test Item 2" />
            </TreeView>
        </PanelExt>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
        <Setter Property="Background" Value="{ThemeBrush Background, Opacity=0}" />
        <Setter Property="BorderBrush" Value="{ThemeBrush BorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeBrush Foreground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
                    <ToggleButton Grid.Column="0" Grid.Row="0"
                                  x:Name="PART_ExpandCollapseChevron"
                                  Focusable="False"
                                  IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                    <Border Grid.Column="1" Grid.Row="0"
                            x:Name="PART_Header"
                            Focusable="True" TemplatedControl.IsTemplateFocusTarget="True">
                        <ContentPresenter
                            x:Name="PART_HeaderPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalAlignment}"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Focusable="False" />
                    </Border>
                    <ItemsPresenter Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                    x:Name="PART_ItemsPresenter" Margin="10 0 0 0"
                                    IsVisible="{TemplateBinding IsExpanded}"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:empty">
            <Setter Property="IsExpanded" Value="False" />
        </Style>
        <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^ /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0 0 5 0" />
            <Setter Property="Background" Value="{ThemeBrush Background}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
