<Styles
    x:Class="AirKit.Reactive.Themes.LightThemeBase"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Default" Source="Light.axaml" />
                <ResourceInclude x:Key="Light" Source="Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="/Controls/Base/Window.axaml" />
                <MergeResourceInclude Source="/Controls/LightPath.axaml" />
                <MergeResourceInclude Source="/Controls/LightTitleBar.axaml" />
                <MergeResourceInclude Source="/Controls/LightTitleBarButton.axaml" />
                <MergeResourceInclude Source="/Controls/LightWindow.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
