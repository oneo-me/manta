<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <SolidColorBrush x:Key="{InnerResourceKey ThemeBrush}" Opacity="0.1" Color="#A660FF" />
    <SolidColorBrush x:Key="{InnerResourceKey Window_ThemeBrush}" Opacity="0.1" Color="#A660FF" />
    <SolidColorBrush x:Key="{InnerResourceKey Background}" Color="#222222" />
    <SolidColorBrush x:Key="{InnerResourceKey Foreground}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{InnerResourceKey BorderBrush}" Opacity="0.15" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{InnerResourceKey TitleBar_Button_Background}" Opacity="0" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{InnerResourceKey TitleBar_Button_Background_Hover}" Opacity="0.1" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{InnerResourceKey TitleBar_CloseButton_Background}" Opacity="0" Color="#FF5F57" />
    <SolidColorBrush x:Key="{InnerResourceKey TitleBar_CloseButton_Background_Hover}" Opacity="1" Color="#FF5F57" />
    <SolidColorBrush x:Key="{InnerResourceKey TitleBar_CloseButton_Foreground_Hover}" Opacity="1" Color="#FFFFFF" />
</ResourceDictionary>
