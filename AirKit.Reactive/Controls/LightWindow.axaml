<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Border Width="100" Height="100">
            <Button Content="Button" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type LightWindow}" TargetType="LightWindow">
        <Setter Property="WindowStartupLocation" Value="CenterScreen" />
        <Setter Property="Background" Value="{ThemeBrush Window_Background}" />
        <Setter Property="BackgroundThemeBrush" Value="{ThemeBrush Primary, Opacity=0.1}" />
        <Setter Property="Foreground" Value="{ThemeBrush Foreground}" />
        <Setter Property="BorderBrush" Value="{ThemeBrush BorderBrush}" />
        <Setter Property="FontSize" Value="{ThemeNumber FontSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <LightPanel>
                    <Border Background="{TemplateBinding Background}" />
                    <Border Background="{TemplateBinding BackgroundThemeBrush}" />
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <VisualLayerManager>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}" />
                        </VisualLayerManager>
                    </Border>
                </LightPanel>
            </ControlTemplate>
        </Setter>
        <!-- Windows Border -->
        <Style Selector="^:windows">
            <Setter Property="BorderThickness" Value="1" />
            <Style Selector="^[WindowState=Maximized]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^[WindowState=FullScreen]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Style>
        <!-- macOS Background -->
        <Style Selector="^[IsActive=False]">
            <Setter Property="Background" Value="{ThemeBrush Window_Background, ResetOpacity=True}" />
        </Style>
        <!-- Linux Background -->
        <Style Selector="^[ExtendClientAreaToDecorationsHint=False]">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
