<MView
    x:Class="Manta.DevTools.Views.ObjectPropertyDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.DevTools.Views"
    x:DataType="local:ObjectPropertyDialog_Model">
    <MView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Default" Source="../Themes/@Light.axaml" />
                <ResourceInclude x:Key="Light" Source="../Themes/@Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="../Themes/@Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </MView.Resources>
    <MBackground>
        <MDialogTemplate Header="{Binding Header}" CancelButton="" ContinueButton="Close" ContinueButtonCommand="{Binding CancelAsyncCommand}">
            <Border BorderThickness="{MThickness Px}" CornerRadius="{MRadius MD}">
                <Border Background="{MBrush Background}" CornerRadius="{MRadius MD, OffsetNegative=Px}" ClipToBounds="True">
                    <Grid Width="420" MinHeight="360" MaxHeight="620">
                        <MViewHost ViewModelType="local:PropertyListView_Model" Data="{Binding Value}" />
                    </Grid>
                </Border>
            </Border>
        </MDialogTemplate>
    </MBackground>
</MView>
