<MView
    x:Class="Manta.DevTools.Views.CollectionPropertyDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.DevTools.Views"
    x:DataType="local:CollectionPropertyDialog_Model">
    <MView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Default" Source="../Themes/@Light.axaml" />
                <ResourceInclude x:Key="Light" Source="../Themes/@Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="../Themes/@Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </MView.Resources>
    <MBackground>
        <MDialogTemplate Header="{Binding Header}" CancelButton="" ContinueButton="Close" ContinueButtonCommand="{Binding CancelAsyncCommand}">
            <Border BorderThickness="{MThickness Px}" CornerRadius="{MRadius MD}">
                <Border CornerRadius="{MRadius MD, OffsetNegative=Px}" ClipToBounds="True">
                    <Grid Width="720" MinHeight="360" MaxHeight="620">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="320" />
                            <ColumnDefinition MinWidth="320" Width="320" />
                        </Grid.ColumnDefinitions>
                        <MListBox Grid.Column="0" Variant="NoStyle"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem}"
                                  Background="{MBrush Background, Opacity=0.5}">
                            <MListBox.Styles>
                                <Style Selector="MListBox[Variant=NoStyle]">
                                    <Setter Property="Padding" Value="{MThickness S1}" />
                                    <Style Selector="^ MListBoxItem[Variant=NoStyle]">
                                        <Setter Property="Padding" Value="{MThickness S2, Vertical=S1}" />
                                        <Setter Property="CornerRadius" Value="{MRadius SM}" />
                                        <Setter Property="Background" Value="{MBrush Foreground, Opacity=0}" />
                                        <Style Selector="^:selected">
                                            <Setter Property="Background" Value="{MBrush Foreground, Opacity=0.08}" />
                                        </Style>
                                    </Style>
                                </Style>
                            </MListBox.Styles>
                            <MListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </MListBox.ItemTemplate>
                        </MListBox>
                        <MViewHost Grid.Column="1"
                                   ViewModelType="local:PropertyListView_Model"
                                   Data="{Binding SelectedItem}"
                                   Background="{MBrush Background}" BorderThickness="{MThickness Px, Filter=Left}" />
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Left" />
                    </Grid>
                </Border>
            </Border>
        </MDialogTemplate>
    </MBackground>
</MView>
