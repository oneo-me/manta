<MView
    x:Class="Manta.DevTools.Views.ViewModelTreeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.DevTools.Views"
    xmlns:commands="clr-namespace:Manta.DevTools.Commands"
    xmlns:models="clr-namespace:Manta.DevTools.Models"
    x:DataType="local:ViewModelTreeView_Model" Design.DataContext="{x:Static local:ViewModelTreeView_Model.Design}"
    Name="View">
    <MTree ItemsSource="{Binding Root.Value}" SelectedItem="{Binding SelectedNode.Value.Value}">
        <MTree.Styles>
            <Style Selector="MTreeItem">
                <Setter Property="IsExpanded" Value="True" />
                <Setter Property="commands:PointerCommands.EnterCommand" Value="{Binding UpdateAdorner}" x:DataType="models:TreeNode" />
                <Setter Property="commands:PointerCommands.EnterCommandParameter" Value="{Binding ElementName=View}" />
                <Setter Property="commands:PointerCommands.ExitCommand" Value="{Binding ClearAdorner}" x:DataType="models:TreeNode" />
            </Style>
        </MTree.Styles>
        <MTree.ItemTemplate>
            <TreeDataTemplate ItemsSource="{Binding}">
                <Grid ColumnDefinitions="Auto *" ColumnSpacing="{MSize S2}" HorizontalAlignment="Left">
                    <MIcon Grid.Column="0" IconSize="{MSize S3_5}" Margin="0 -10" IconSource="{Binding Icon}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </TreeDataTemplate>
        </MTree.ItemTemplate>
    </MTree>
</MView>
