<MView
    x:Class="Manta.DevTools.Views.PropertyListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.DevTools.Views"
    xmlns:propertyItems="clr-namespace:Manta.DevTools.Models.PropertyItems"
    x:DataType="local:PropertyListView_Model" Design.DataContext="{x:Static local:PropertyListView_Model.Design}"
    Name="View" Design.Width="300">
    <MView.Styles>
        <Style Selector="MListBox[Variant=NoStyle]">
            <Style Selector="^ MListBoxItem[Variant=NoStyle]">
                <Setter Property="BorderThickness" Value="{MThickness Px, Filter=Bottom}" />
                <Setter Property="BorderBrush" Value="{MBrush Border, Opacity=0.5}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Style>
    </MView.Styles>
    <MListBox Variant="NoStyle" ItemsSource="{Binding Items}">
        <MListBox.DataTemplates>
            <DataTemplate DataType="propertyItems:GroupHeaderItem">
                <Border Background="{MBrush Muted}">
                    <TextBlock Text="{Binding Name}" Margin="{MThickness S2, Vertical=S1_5}"
                               Foreground="{MBrush MutedForeground}" FontWeight="SemiBold" />
                </Border>
            </DataTemplate>
            <DataTemplate DataType="propertyItems:ItemBase">
                <Border Height="{Binding Height}">
                    <Grid Margin="{MThickness S1_5, Vertical=S0_5}" ColumnSpacing="{MSize S2}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Text="{Binding Name}"
                                   ToolTip.Tip="{Binding PropertyType}" />
                        <ContentControl Grid.Column="1" ClipToBounds="False" Width="{Binding Width}" MaxWidth="160"
                                        Content="{Binding}"
                                        ContentTemplate="{Binding ElementName=View, Path=DataContext.ItemTemplate}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </MListBox.DataTemplates>
    </MListBox>
</MView>
