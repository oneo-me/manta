<MView
    x:Class="Manta.DevTools.Views.PropertyViews.ImageSourcePropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.DevTools.Views.PropertyViews"
    x:DataType="local:ImageSourcePropertyView_Model" Design.DataContext="{x:Static local:ImageSourcePropertyView_Model.Design}"
    ClipToBounds="False" Margin="{MThickness S0, Vertical=S1}">
    <Border BorderThickness="{MThickness Px}" CornerRadius="{MRadius MD}">
        <Border CornerRadius="{MRadius MD, OffsetNegative=Px}" ClipToBounds="True">
            <Panel>
                <MPixelGrid />
                <MImage Name="Image" MaxHeight="120" Margin="{MThickness S2}" />
            </Panel>
        </Border>
    </Border>
</MView>
