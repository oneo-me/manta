<MView
    x:Class="Manta.DevTools.Views.PropertyViews.CollectionPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.DevTools.Views.PropertyViews"
    x:DataType="local:CollectionPropertyView_Model" Design.DataContext="{x:Static local:CollectionPropertyView_Model.Design}">
    <MButton Variant="Ghost" Padding="6" Margin="4"
             HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
             Command="{Binding OpenCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding TypeName}" Foreground="Gray" />
            <TextBlock Text="{Binding CountText}" Foreground="DodgerBlue" />
        </StackPanel>
    </MButton>
</MView>
