<MView
    x:Class="Manta.DevTools.Views.PropertyViews.EnumPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.DevTools.Views.PropertyViews"
    x:DataType="local:EnumPropertyView_Model" Design.DataContext="{x:Static local:EnumPropertyView_Model.Design}"
    ClipToBounds="False">
    <Panel>
        <MTextBox Name="TextBox" IsReadOnly="True" Padding="{MThickness S1_5, Vertical=S1}" VerticalAlignment="Center" />
        <MComboBox Name="ComboBox" Padding="{MThickness S1_5, Vertical=S1}" VerticalAlignment="Center" />
    </Panel>
</MView>
