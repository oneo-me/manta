<MView
    x:Class="Manta.DevTools.Views.PropertyViews.UnknownPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.DevTools.Views.PropertyViews"
    x:DataType="local:UnknownPropertyView_Model" Design.DataContext="{x:Static local:UnknownPropertyView_Model.Design}">
    <TextBlock Text="{Binding Message}" Foreground="{MBrush Destructive}" VerticalAlignment="Center" />
</MView>
