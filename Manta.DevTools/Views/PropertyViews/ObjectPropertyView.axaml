<MView
    x:Class="Manta.DevTools.Views.PropertyViews.ObjectPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:root="clr-namespace:Manta.DevTools"
    xmlns:local="clr-namespace:Manta.DevTools.Views.PropertyViews"
    x:DataType="local:ObjectPropertyView_Model" Design.DataContext="{x:Static local:ObjectPropertyView_Model.Design}"
    ClipToBounds="False">
    <MButton Variant="Ghost" Padding="{MThickness S1_5, Vertical=S1}" VerticalAlignment="Center"
             Command="{Binding OpenCommand}">
        <MPanel Mode="Horizontal" Spacing="{MSize S1_5}">
            <MIcon IconSize="14" Margin="0 -20" VerticalAlignment="Center"
                   IconSource="{x:Static root:Icons.Info}" />
            <TextBlock Text="Details" />
        </MPanel>
    </MButton>
</MView>
