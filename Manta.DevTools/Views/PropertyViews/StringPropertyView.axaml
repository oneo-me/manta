<MView
    x:Class="Manta.DevTools.Views.PropertyViews.StringPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.DevTools.Views.PropertyViews"
    x:DataType="local:StringPropertyView_Model" Design.DataContext="{x:Static local:StringPropertyView_Model.Design}">
    <Panel>
        <TextBlock Name="ReadOnlyText" VerticalAlignment="Center" Padding="8,0,0,0" />
        <MTextBox Name="EditBox" Padding="5" Margin="4" />
    </Panel>
</MView>
