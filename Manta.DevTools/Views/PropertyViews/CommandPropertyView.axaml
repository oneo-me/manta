<MView
    x:Class="Manta.DevTools.Views.PropertyViews.CommandPropertyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:root="clr-namespace:Manta.DevTools"
    xmlns:local="clr-namespace:Manta.DevTools.Views.PropertyViews"
    x:DataType="local:CommandPropertyView_Model" Design.DataContext="{x:Static local:CommandPropertyView_Model.Design}"
    ClipToBounds="False">
    <MButton Name="Button" Variant="Ghost"
             Padding="{MThickness S1_5, Vertical=S1}" VerticalAlignment="Center">
        <MPanel Mode="Horizontal" Spacing="{MSize S1_5}">
            <MIcon IconSize="12" Margin="0 -20" VerticalAlignment="Center"
                   IconSource="{x:Static root:Icons.Play}" />
            <TextBlock Text="Execute" />
        </MPanel>
    </MButton>
</MView>
