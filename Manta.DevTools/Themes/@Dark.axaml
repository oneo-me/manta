<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:values="clr-namespace:Manta.Themes.Values;assembly=Manta">
    <values:OklchColor x:Key="{MBrushKey Background}" L="0.145" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey Foreground}" L="0.985" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey Card}" L="0.205" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey CardForeground}" L="0.985" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey Popover}" L="0.269" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey PopoverForeground}" L="0.985" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey PrimaryForeground}" L="0.985" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey Secondary}" L="0.269" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey SecondaryForeground}" L="0.985" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey Muted}" L="0.269" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey MutedForeground}" L="0.708" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey Accent}" L="0.371" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey AccentForeground}" L="0.985" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey Destructive}" L="0.704" C="0.191" H="22.216" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey DestructiveForeground}" L="0.985" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey Border}" L="0.985" C="0" H="0" Opacity="0.15" />
    <values:OklchColor x:Key="{MBrushKey Input}" L="0.325" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey Ring}" L="0.556" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey SidebarBackground}" L="0.205" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey SidebarForeground}" L="0.985" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey SidebarAccent}" L="0.269" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey SidebarAccentForeground}" L="0.985" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey SidebarBorder}" L="0.275" C="0" H="0" Opacity="1" />
    <values:OklchColor x:Key="{MBrushKey SidebarRing}" L="0.439" C="0" H="0" Opacity="1" />
</ResourceDictionary>
