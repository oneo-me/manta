<LightView
    x:Class="AirKit.Reactive.Demo.Samples.TabManagerSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKit.Reactive.Demo.Samples"
    x:DataType="local:TabManagerSampleModel">
    <Design.DataContext>
        <local:TabManagerSampleModel />
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*" Margin="12">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 12">
            <Button Classes="Button-Mini" Content="{Binding Index, StringFormat=Add item (id: {0})}" Command="{Binding Add}" />
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{ThemeBrush BorderBrush}" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius Normal}" ClipToBounds="True">
            <Panel>
                <Grid RowDefinitions="Auto,*" IsVisible="{Binding TabManager.Items.Count}">
                    <ListBox Grid.Row="0" Classes="List-Tab" ItemsSource="{Binding TabManager.Items}" SelectedItem="{Binding TabManager.SelectedItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="local:TabItemView_Model">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                    <Button Classes="Button-Tab-Close" Command="{Binding Close}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <LightViewHost Grid.Row="1" ViewModel="{Binding TabManager.SelectedItem}" />
                </Grid>
                <TextBlock Text="No tab opened" IsVisible="{Binding !TabManager.Items.Count}" Margin="{ThemeThickness Padding, Offset=30}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Panel>
        </Border>
    </Grid>
</LightView>
