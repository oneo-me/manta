<LightView
    x:Class="AirKit.Reactive.Demo.Views.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKit.Reactive.Demo.Views"
    x:DataType="local:Main_Model" Design.Width="600">
    <Design.DataContext>
        <local:Main_Model />
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*">
        <LightTitleBar Grid.Row="0">
            <LightTitleBar.InnerRightContent>
                <StackPanel Orientation="Horizontal">
                    <LightTitleBarButton Content="Dispose" Command="{Binding DisposeCommand}" />
                </StackPanel>
            </LightTitleBar.InnerRightContent>
        </LightTitleBar>
            <ScrollViewer>
                <StackPanel Spacing="12" Margin="12">
                    <TextBlock Text="Welcome to Avalonia!" />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
            </ScrollViewer>
        <Border Grid.Row="1" Background="{InnerResource Background}" BorderBrush="{InnerResource BorderBrush}" BorderThickness="0 1 0 0">
        </Border>
    </Grid>
</LightView>
