<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PublishAot>true</PublishAot>
        <NoWarn>IL2057;IL2026;IL2080;IL2104;IL3053</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <TrimmerRootDescriptor Include="Program.xml" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\AirKit.Desktop\AirKit.Desktop.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AirKit.I18N" Version="2.2024.163" />
        <PackageReference Include="AirKit.I18N.Generator" Version="2.2024.163" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Bogus" Version="35.6.1" />
        <PackageReference Include="YamlDotNet" Version="16.2.1" />
    </ItemGroup>
</Project>
