<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <PublishAot>true</PublishAot>
        <NoWarn>IL2057;IL2026;IL2080;IL2104;IL3053</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <TrimmerRootDescriptor Include="Program.xml" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\AirKit\AirKit.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Bogus" Version="35.6.3" />
        <PackageReference Include="Lumira" Version="2.2025.3" />
        <PackageReference Include="Lumira.Generator" Version="2.2025.3" PrivateAssets="all" />
    </ItemGroup>
</Project>
