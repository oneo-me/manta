<View
    x:Class="AirKitDemo.Views.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKitDemo.Views"
    xmlns:models="clr-namespace:AirKitDemo.Models"
    x:DataType="local:Main_Model" Design.Width="600" Design.Height="600">
    <Design.DataContext>
        <local:Main_Model />
    </Design.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" MinWidth="160" MaxWidth="360" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0" x:Name="OffsetBorder" />
            <Border Grid.Row="0" Grid.RowSpan="2" x:Name="EventBorder" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                <ListBox.Theme>
                    <ControlTheme TargetType="ListBox">
                        <Setter Property="Padding" Value="{ThemeThickness Padding}" />
                        <Setter Property="Template">
                            <ControlTemplate>
                                <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                Margin="{TemplateBinding Padding}" />
                            </ControlTemplate>
                        </Setter>
                        <Setter Property="ItemContainerTheme">
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding !IsGroup}" x:DataType="models:SampleItem" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Padding="{TemplateBinding Padding}"
                                                          Background="{TemplateBinding Background}"
                                                          CornerRadius="{TemplateBinding CornerRadius}" />
                                    </ControlTemplate>
                                </Setter>
                                <Setter Property="Transitions">
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.1" />
                                        <BrushTransition Property="Foreground" Duration="0:0:0.1" />
                                    </Transitions>
                                </Setter>
                                <Setter Property="Padding" Value="{ThemeThickness Padding, LeftRightOffset=4, TopBottomOffset=-1}" />
                                <Setter Property="CornerRadius" Value="{ThemeRadius Normal}" />
                                <Setter Property="Background" Value="{ThemeBrush Primary, Opacity=0}" />
                                <Style Selector="^:selected">
                                    <Setter Property="Background" Value="{ThemeBrush Primary}" />
                                    <Setter Property="Foreground" Value="{ThemeBrush Primary_Foreground}" />
                                </Style>
                                <Style Selector="^:disabled">
                                    <Setter Property="Opacity" Value="0.5" />
                                    <Setter Property="Padding" Value="{ThemeThickness Padding, Offset=-3}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </ControlTheme>
                        </Setter>
                    </ControlTheme>
                </ListBox.Theme>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:SampleItem">
                        <TextBlock Text="{Lang {Binding NameKey}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Border Grid.Column="1" Background="{ThemeBrush Background}" BorderThickness="{ThemeThickness Normal, Filter=Left}">
            <Grid RowDefinitions="Auto,*">
                <TitleBarExt Grid.Row="0" x:Name="TitleBar" Title="{Lang {Binding SelectedItem.NameKey}}" UseWindowTitle="False"
                             Background="{ThemeBrush Foreground, Opacity=0.03}"
                             BorderThickness="{ThemeThickness Normal, Filter=Bottom}">
                    <PanelExt Mode="Horizontal">
                        <TitleBarButton Content="{LangName {x:Static LangType.zh_Hans}}" Command="{Binding SetLangType}" CommandParameter="{x:Static LangType.zh_Hans}" />
                        <TitleBarButton Content="{LangName {x:Static LangType.en}}" Command="{Binding SetLangType}" CommandParameter="{x:Static LangType.en}" />
                    </PanelExt>
                </TitleBarExt>
                <ViewModelHost Grid.Row="1" ViewModel="{Binding ViewManager.Current}" />
            </Grid>
        </Border>
        <!-- Splitters -->
        <GridSplitter Grid.Column="0" HorizontalAlignment="Right" />
    </Grid>
</View>
