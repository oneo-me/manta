<View
    x:Class="AirKitDemo.Samples.Reactive.RegionManagerSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKitDemo.Samples.Reactive"
    x:DataType="local:RegionManagerSample_Model" Design.Width="500">
    <Design.DataContext>
        <local:RegionManagerSample_Model />
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*" Margin="12">
        <PanelExt Grid.Row="0" Mode="Horizontal" Margin="0 0 0 12">
            <Button Classes="Button-Mini" Content="{Binding Index, StringFormat=Add item (id: {0})}" Command="{Binding Add}" />
        </PanelExt>
        <PanelExt Grid.Row="1">
            <Grid RowDefinitions="Auto,*" IsVisible="{Binding RegionManager.Items.Count}">
                <ListBox Grid.Row="0" Classes="List-Tab" ItemsSource="{Binding RegionManager.Items}" SelectedItem="{Binding RegionManager.SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="local:RegionItemView_Model">
                            <AutoGrid Definitions="*,Auto" Spacing="8">
                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                <Button Classes="Button-Tab-Close" Command="{Binding Close}" VerticalAlignment="Center" />
                            </AutoGrid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ViewModelHost Grid.Row="1" ViewModel="{Binding RegionManager.SelectedItem}" />
            </Grid>
            <TextBlock Text="No tab opened" IsVisible="{Binding !RegionManager.Items.Count}" Margin="{ThemeThickness Padding, Offset=30}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </PanelExt>
    </Grid>
</View>
