<View
    x:Class="AirKitDemo.Samples.Themes.ThemeScopeSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKitDemo.Samples.Themes"
    x:DataType="local:ThemeScopeSample_Model" Design.Width="800">
    <Design.DataContext>
        <local:ThemeScopeSample_Model />
    </Design.DataContext>
    <Grid ColumnDefinitions="*,*" Margin="{ThemeThickness Padding}">
        <ThemeVariantScope Grid.Column="0" RequestedThemeVariant="Light">
            <ViewModelHost ViewModelType="local:ColorsSample_Model" Background="{ThemeBrush Background}" Margin="{ThemeThickness Padding}" CornerRadius="{ThemeRadius Normal}" BorderThickness="{ThemeThickness Normal}" />
        </ThemeVariantScope>
        <ThemeVariantScope Grid.Column="1" RequestedThemeVariant="Dark">
            <ViewModelHost ViewModelType="local:ColorsSample_Model" Background="{ThemeBrush Background}" Margin="{ThemeThickness Padding}" CornerRadius="{ThemeRadius Normal}" BorderThickness="{ThemeThickness Normal}" />
        </ThemeVariantScope>
    </Grid>
</View>
