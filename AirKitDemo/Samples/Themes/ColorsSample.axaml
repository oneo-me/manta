<View
    x:Class="AirKitDemo.Samples.Themes.ColorsSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKitDemo.Samples.Themes"
    x:DataType="local:ColorsSample_Model">
    <Design.DataContext>
        <local:ColorsSample_Model />
    </Design.DataContext>
    <View.Styles>
        <Style Selector="Border.ColorBlock">
            <Setter Property="Padding" Value="{ThemeThickness Padding}" />
            <Setter Property="CornerRadius" Value="{ThemeRadius Normal}" />
            <Setter Property="BorderThickness" Value="{ThemeThickness Normal}" />
            <Style Selector="^ PanelExt">
                <Setter Property="Mode" Value="Vertical" />
            </Style>
            <Style Selector="^ TextBlock">
                <Setter Property="Opacity" Value="0.5" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
        </Style>
    </View.Styles>
    <ScrollViewer>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Classes="Title" Text="Primary Colors" />
            <PanelExt Mode="WrapFull" Spacing="12">
                <Border Classes="ColorBlock" Background="{ThemeBrush Primary}" TextElement.Foreground="{ThemeBrush Primary_Foreground}">
                    <PanelExt>
                        <TextBlock Text="Primary" />
                        <Label Content="{ThemeBrush Primary}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Success}" TextElement.Foreground="{ThemeBrush Success_Foreground}">
                    <PanelExt>
                        <TextBlock Text="Success" />
                        <Label Content="{ThemeBrush Success}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Warning}" TextElement.Foreground="{ThemeBrush Warning_Foreground}">
                    <PanelExt>
                        <TextBlock Text="Warning" />
                        <Label Content="{ThemeBrush Warning}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Error}" TextElement.Foreground="{ThemeBrush Error_Foreground}">
                    <PanelExt>
                        <TextBlock Text="Error" />
                        <Label Content="{ThemeBrush Error}" />
                    </PanelExt>
                </Border>
            </PanelExt>
            <TextBlock Classes="Title" Text="Other Colors" />
            <PanelExt Mode="WrapFull" Spacing="12">
                <Border Classes="ColorBlock" Background="{ThemeBrush Shadow}" TextElement.Foreground="White">
                    <PanelExt>
                        <TextBlock Text="Shadow" />
                        <Label Content="{ThemeBrush Shadow}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush MaskBrush}" TextElement.Foreground="{ThemeBrush Foreground}">
                    <PanelExt>
                        <TextBlock Text="MaskBrush" />
                        <Label Content="{ThemeBrush MaskBrush}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Window_Background}" TextElement.Foreground="{ThemeBrush Foreground}">
                    <PanelExt>
                        <TextBlock Text="Window_Background" />
                        <Label Content="{ThemeBrush Window_Background}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Background}" TextElement.Foreground="{ThemeBrush Foreground}">
                    <PanelExt>
                        <TextBlock Text="Background" />
                        <Label Content="{ThemeBrush Background}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Foreground}" TextElement.Foreground="{ThemeBrush Background}">
                    <PanelExt>
                        <TextBlock Text="Foreground" />
                        <Label Content="{ThemeBrush Foreground}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush BorderBrush}" TextElement.Foreground="{ThemeBrush Foreground}">
                    <PanelExt>
                        <TextBlock Text="BorderBrush" />
                        <Label Content="{ThemeBrush BorderBrush}" />
                    </PanelExt>
                </Border>
            </PanelExt>
            <TextBlock Classes="Title" Text="Dialog Colors" />
            <PanelExt Mode="WrapFull" Spacing="12">
                <Border Classes="ColorBlock" Background="{ThemeBrush Dialog_Background}" TextElement.Foreground="{ThemeBrush Dialog_Foreground}">
                    <PanelExt>
                        <TextBlock Text="Dialog_Background" />
                        <Label Content="{ThemeBrush Dialog_Background}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Dialog_Foreground}" TextElement.Foreground="{ThemeBrush Dialog_Background}">
                    <PanelExt>
                        <TextBlock Text="Dialog_Foreground" />
                        <Label Content="{ThemeBrush Dialog_Foreground}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Dialog_BorderBrush}" TextElement.Foreground="{ThemeBrush Dialog_Foreground}">
                    <PanelExt>
                        <TextBlock Text="Dialog_BorderBrush" />
                        <Label Content="{ThemeBrush Dialog_BorderBrush}" />
                    </PanelExt>
                </Border>
            </PanelExt>
            <TextBlock Classes="Title" Text="Flyout Colors" />
            <PanelExt Mode="WrapFull" Spacing="12">
                <Border Classes="ColorBlock" Background="{ThemeBrush Flyout_Background}" TextElement.Foreground="{ThemeBrush Flyout_Foreground}">
                    <PanelExt>
                        <TextBlock Text="Flyout_Background" />
                        <Label Content="{ThemeBrush Flyout_Background}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Flyout_Foreground}" TextElement.Foreground="{ThemeBrush Flyout_Background}">
                    <PanelExt>
                        <TextBlock Text="Flyout_Foreground" />
                        <Label Content="{ThemeBrush Flyout_Foreground}" />
                    </PanelExt>
                </Border>
                <Border Classes="ColorBlock" Background="{ThemeBrush Flyout_BorderBrush}" TextElement.Foreground="{ThemeBrush Flyout_Foreground}">
                    <PanelExt>
                        <TextBlock Text="Flyout_BorderBrush" />
                        <Label Content="{ThemeBrush Flyout_BorderBrush}" />
                    </PanelExt>
                </Border>
            </PanelExt>
        </PanelExt>
    </ScrollViewer>
</View>
