<LightView
    x:Class="AirKitDemo.Samples.Base.BaseListSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKitDemo.Samples.Base"
    x:DataType="local:BaseListSample_Model" Design.Width="600">
    <Design.DataContext>
        <local:BaseListSample_Model />
    </Design.DataContext>
    <LightScrollViewer>
        <LightPanel Mode="Wrap" Spacing="12" Margin="12">
            <LightPanel Mode="Vertical" Spacing="12">
                <TextBlock Classes="Title" Text="ItemsControl" />
                <ItemsControl ItemsSource="{Binding Items5}" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius Normal}" Padding="{ThemeThickness Padding}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}: {1}">
                                        <Binding Path="Id" />
                                        <Binding Path="Name" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </LightPanel>
            <LightPanel Mode="Vertical" Spacing="12">
                <TextBlock Classes="Title" Text="ListBox" />
                <ListBox ItemsSource="{Binding Items100}" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius Normal}"
                         Grid.IsSharedSizeScope="True" MaxHeight="200" Padding="{ThemeThickness Padding}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ListItemId" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat={}{0}:}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="3 0 0 0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </LightPanel>
        </LightPanel>
    </LightScrollViewer>
</LightView>
