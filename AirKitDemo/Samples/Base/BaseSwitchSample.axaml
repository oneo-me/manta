<LightView
    x:Class="AirKitDemo.Samples.Base.BaseSwitchSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKitDemo.Samples.Base"
    x:DataType="local:BaseSwitchSample_Model">
    <Design.DataContext>
        <local:BaseSwitchSample_Model />
    </Design.DataContext>
    <LightScrollViewer>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Classes="Title" Text="CheckBox" />
            <LightPanel Mode="Horizontal" Spacing="12">
                <CheckBox Content="CheckBox" />
                <CheckBox Content="CheckBox" IsChecked="True" />
                <CheckBox Content="CheckBox" IsChecked="{x:Null}" />
            </LightPanel>
        </LightPanel>
    </LightScrollViewer>
</LightView>
