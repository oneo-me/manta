<View
    x:Class="AirKitDemo.Samples.Controls.ButtonSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKitDemo.Samples.Controls"
    x:DataType="local:ButtonSample_Model">
    <Design.DataContext>
        <local:ButtonSample_Model />
    </Design.DataContext>
    <ScrollViewer>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Classes="Title" Text="Button" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <Button Content="Button" />
            </PanelExt>
            <TextBlock Classes="Title" Text="SplitButton" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <SplitButton Content="SplitButton">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Option 1" />
                            <MenuItem Header="Option 2" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </PanelExt>
            <TextBlock Classes="Title" Text="DropDownButton" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <DropDownButton Content="DropDownButton">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Option 1" />
                            <MenuItem Header="Option 2" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </PanelExt>
            <TextBlock Classes="Title" Text="RepeatButton" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <RepeatButton Content="RepeatButton" />
            </PanelExt>
            <TextBlock Classes="Title" Text="ButtonSpinner" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <ButtonSpinner Content="ButtonSpinner" />
                <ButtonSpinner Content="ButtonSpinner" ButtonSpinnerLocation="Left" />
                <ButtonSpinner Content="ButtonSpinner" ShowButtonSpinner="False" />
            </PanelExt>
            <TextBlock Classes="Title" Text="NumericUpDown" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <NumericUpDown Width="80" />
                <NumericUpDown Width="80" ButtonSpinnerLocation="Left" />
                <NumericUpDown Width="80" ShowButtonSpinner="False" />
            </PanelExt>
            <TextBlock Classes="Title" Text="HyperlinkButton" />
            <PanelExt Mode="Horizontal" Spacing="12">
                <HyperlinkButton Content="HyperlinkButton" NavigateUri="https://github.com" />
                <HyperlinkButton Content="HyperlinkButton" NavigateUri="https://github.com" IsVisited="True" />
            </PanelExt>
        </PanelExt>
    </ScrollViewer>
</View>
