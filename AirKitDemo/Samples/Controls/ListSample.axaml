<View
    x:Class="AirKitDemo.Samples.Controls.BaseListSample"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AirKitDemo.Samples.Controls"
    x:DataType="local:BaseListSample_Model" Design.Width="600">
    <Design.DataContext>
        <local:BaseListSample_Model />
    </Design.DataContext>
    <ScrollViewer>
        <PanelExt Mode="Wrap" Spacing="12" Margin="12">
            <PanelExt Mode="Vertical" Spacing="12">
                <TextBlock Classes="Title" Text="ItemsControl" />
                <ItemsControl ItemsSource="{Binding Items5}" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius Normal}" Padding="{ThemeThickness Padding}"
                              Width="160">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}: {1}">
                                        <Binding Path="Id" />
                                        <Binding Path="Name" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </PanelExt>
            <PanelExt Mode="Vertical" Spacing="12">
                <TextBlock Classes="Title" Text="ListBox" />
                <ListBox ItemsSource="{Binding Items100}" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius Normal}"
                         Grid.IsSharedSizeScope="True" Width="160" Height="200" Padding="{ThemeThickness Padding}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ListItemId" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat={}{0}:}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="3 0 0 0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </PanelExt>
            <PanelExt Mode="Vertical" Spacing="12">
                <TextBlock Classes="Title" Text="TreeView" />
                <TreeView ItemsSource="{Binding TreeItems30}" BorderThickness="{ThemeThickness Normal}" CornerRadius="{ThemeRadius Normal}"
                          Width="160" Height="200" Padding="{ThemeThickness Padding}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ListItemId" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat={}{0}:}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="3 0 0 0" />
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </PanelExt>
        </PanelExt>
    </ScrollViewer>
</View>
