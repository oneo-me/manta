<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical">
            <Button Classes="Button-Tab-Close" Content="Button" />
        </LightPanel>
    </Design.PreviewWith>
    <Style Selector="Button.Button-Tab-Close">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <PathIcon Classes="Icon-Close" Width="6" Height="6" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <Setter Property="CornerRadius" Value="{ThemeRadius Normal, Offset=-3}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{ThemeBrush Error, Opacity=0}" />
        <Setter Property="Foreground" Value="{ThemeBrush Foreground}" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{ThemeBrush Error}" />
            <Setter Property="Foreground" Value="{ThemeBrush Error_Foreground}" />
        </Style>
    </Style>
</Styles>
