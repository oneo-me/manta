<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="AirKitDemo.App"
    RequestedThemeVariant="Default">
    <Application.Styles>
        <LightThemeBase />
        <StyleInclude Source="Styles/_Icons.axaml" />
        <StyleInclude Source="Styles/Button-Mini.axaml" />
        <StyleInclude Source="Styles/Button-Tab-Close.axaml" />
        <StyleInclude Source="Styles/List-Logs.axaml" />
        <StyleInclude Source="Styles/List-Tab.axaml" />
        <StyleInclude Source="Styles/SampleInfo.axaml" />
    </Application.Styles>
</Application>
