<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="clr-namespace:Manta.DataGrid.Controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type md:MDataGridColumnHeader}" TargetType="md:MDataGridColumnHeader">
        <Setter Property="Padding" Value="{MThickness S2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,4">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Grid.Column="0"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="Left"
                                      VerticalContentAlignment="Center"
                                      FontWeight="SemiBold"
                                      Foreground="{MBrush Foreground}" />
                    <Rectangle Name="PART_ResizeGrip"
                               Grid.Column="1"
                               Fill="Transparent"
                               Cursor="SizeWestEast" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <!-- Hover: highlight resize grip -->
        <Style Selector="^:pointerover /template/ Rectangle#PART_ResizeGrip">
            <Setter Property="Fill" Value="{MBrush Border}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
