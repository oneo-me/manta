<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:md="clr-namespace:Manta.DataGrid.Controls"
    x:ClassModifier="internal">

    <ControlTheme x:Key="{x:Type md:MDataGridHeader}" TargetType="md:MDataGridHeader">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{MBrush Muted}"
                        BorderBrush="{MBrush Border}"
                        BorderThickness="0,0,0,1">
                    <Grid Name="PART_Grid" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
