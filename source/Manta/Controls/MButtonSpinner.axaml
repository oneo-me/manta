<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <!-- Button -->
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Text="ButtonSpinner does not require styles" />
            <MButtonSpinner CornerRadius="10" Height="30" Content="ButtonSpinner" />
            <MButtonSpinner CornerRadius="10" Height="30" Content="ButtonSpinner" AllowSpin="True" />
            <MButtonSpinner CornerRadius="10" Height="30" Content="ButtonSpinner" AllowSpin="False" />
            <MButtonSpinner CornerRadius="10" Height="30" Content="ButtonSpinner" ShowButtonSpinner="False" />
            <MButtonSpinner CornerRadius="10" Height="30" Content="ButtonSpinner" ButtonSpinnerLocation="Left" />
            <MButtonSpinner CornerRadius="10" Height="30" Content="ButtonSpinner" ButtonSpinnerLocation="Right" />
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MButtonSpinner}" TargetType="MButtonSpinner">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{TemplateBinding BoxShadow}">
                    <DockPanel>
                        <Border Name="PART_SpinnerPanel" IsVisible="{TemplateBinding ShowButtonSpinner}"
                                DockPanel.Dock="Right">
                            <Grid
                                TabIndex="2"
                                RowDefinitions="* 1 *">
                                <Border Grid.Row="1" Background="{Binding #PART_SpinnerPanel.BorderBrush}" />
                                <MRepeatButton Grid.Row="0" Name="PART_IncreaseButton"
                                               IsTabStop="{TemplateBinding IsTabStop}"
                                               Foreground="{TemplateBinding Foreground}">
                                    <MPathIcon />
                                </MRepeatButton>
                                <MRepeatButton Grid.Row="2" Name="PART_DecreaseButton"
                                               IsTabStop="{TemplateBinding IsTabStop}">
                                    <MPathIcon />
                                </MRepeatButton>
                            </Grid>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          TabIndex="1"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Content="{TemplateBinding Content}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="BorderBrush" Value="{MBrush Border}" />
        <Setter Property="BorderThickness" Value="{MThickness Px}" />
        <Style Selector="^ /template/ MRepeatButton">
            <Setter Property="Variant" Value="NoStyle" />
            <Setter Property="Padding" Value="{MThickness S1_5, Vertical=S0}" />
            <Setter Property="Background" Value="{MBrush Primary, Opacity=0}" />
            <Setter Property="Foreground" Value="{MBrush Foreground}" />
            <Setter Property="CornerRadius" Value="{MRadius None}" />
            <Setter Property="BoxShadow" Value="{MRing XL, BrushKey=Primary, BrushOpacity=0}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{MBrush Primary}" />
                <Setter Property="Foreground" Value="{MBrush PrimaryForeground}" />
                <Setter Property="BoxShadow" Value="{MRing XL, BrushKey=Primary, BrushOpacity=0.3}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="BoxShadow" Value="{MRing XS, BrushKey=Primary, BrushOpacity=0}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Background" Value="{MBrush Muted}" />
                <Setter Property="Foreground" Value="{MBrush MutedForeground}" />
            </Style>
            <Style Selector="^ MPathIcon">
                <Setter Property="Data" Value="M4.207 12.267a.75.75 0 0 1 .026-1.06l5.25-5.002a.75.75 0 0 1 1.035 0l5.25 5.001a.75.75 0 0 1-1.034 1.086L10 7.784l-4.734 4.508a.75.75 0 0 1-1.06-.025Z M 0 0 M 20 20" />
                <Setter Property="UseStroke" Value="False" />
                <Setter Property="Size" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="{MThickness S1, Reverse=True}" />
            </Style>
            <Style Selector="^#PART_DecreaseButton MPathIcon">
                <Setter Property="RenderTransform" Value="rotate(180deg)" />
            </Style>
        </Style>
        <Style Selector="^ /template/ Border#PART_SpinnerPanel">
            <Setter Property="BorderBrush" Value="{MBrush Border}" />
            <Setter Property="BorderThickness" Value="{MThickness Px, Filter=Left}" />
        </Style>
        <Style Selector="^:left /template/ Border#PART_SpinnerPanel">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="BorderThickness" Value="{MThickness Px, Filter=Right}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
