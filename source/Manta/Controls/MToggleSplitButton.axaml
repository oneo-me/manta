<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel.Styles>
                <Style Selector="MPathIcon.Checked">
                    <Setter Property="Foreground" Value="{MBrush Primary}" />
                </Style>
            </MPanel.Styles>
            <MPanel Mode="Wrap" Spacing="12">
                <MToggleSplitButton Content="Bookmark" HorizontalAlignment="Left" IsChecked="True">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                </MToggleSplitButton>
                <MToggleSplitButton HorizontalAlignment="Left" IsChecked="True">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                    <MPanel Mode="Horizontal" Spacing="8">
                        <MPathIcon Classes.Checked="{Binding $parent[MToggleSplitButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" VerticalAlignment="Center" />
                        <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                    </MPanel>
                </MToggleSplitButton>
                <MToggleSplitButton HorizontalAlignment="Left">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                    <MPathIcon Classes.Checked="{Binding $parent[MToggleSplitButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" />
                </MToggleSplitButton>
            </MPanel>
            <TextBlock Text="Ghost" />
            <MPanel Mode="Wrap" Spacing="12">
                <MToggleSplitButton Variant="Ghost" Content="Bookmark" HorizontalAlignment="Left" IsChecked="True">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                </MToggleSplitButton>
                <MToggleSplitButton Variant="Ghost" HorizontalAlignment="Left" IsChecked="True">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                    <MPanel Mode="Horizontal" Spacing="8">
                        <MPathIcon Classes.Checked="{Binding $parent[MToggleSplitButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" VerticalAlignment="Center" />
                        <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                    </MPanel>
                </MToggleSplitButton>
                <MToggleSplitButton Variant="Ghost" HorizontalAlignment="Left">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                    <MPathIcon Classes.Checked="{Binding $parent[MToggleSplitButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" />
                </MToggleSplitButton>
            </MPanel>
            <TextBlock Text="Disabled" />
            <MPanel Mode="Wrap" Spacing="12" IsEnabled="False">
                <MToggleSplitButton Content="Bookmark" HorizontalAlignment="Left" IsChecked="True">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                </MToggleSplitButton>
                <MToggleSplitButton HorizontalAlignment="Left" IsChecked="True">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                    <MPanel Mode="Horizontal" Spacing="8">
                        <MPathIcon Classes.Checked="{Binding $parent[MToggleSplitButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" VerticalAlignment="Center" />
                        <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                    </MPanel>
                </MToggleSplitButton>
                <MToggleSplitButton HorizontalAlignment="Left">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                    <MPathIcon Classes.Checked="{Binding $parent[MToggleSplitButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" />
                </MToggleSplitButton>
            </MPanel>
            <TextBlock Text="Ghost Disabled" />
            <MPanel Mode="Wrap" Spacing="12" IsEnabled="False">
                <MToggleSplitButton Variant="Ghost" Content="Bookmark" HorizontalAlignment="Left" IsChecked="True">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                </MToggleSplitButton>
                <MToggleSplitButton Variant="Ghost" HorizontalAlignment="Left" IsChecked="True">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                    <MPanel Mode="Horizontal" Spacing="8">
                        <MPathIcon Classes.Checked="{Binding $parent[MToggleSplitButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" VerticalAlignment="Center" />
                        <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                    </MPanel>
                </MToggleSplitButton>
                <MToggleSplitButton Variant="Ghost" HorizontalAlignment="Left">
                    <MToggleSplitButton.Flyout>
                        <MMenuFlyout Placement="BottomEdgeAlignedRight">
                            <MMenuItem Header="Option 1" />
                            <MMenuItem Header="Option 2" />
                        </MMenuFlyout>
                    </MToggleSplitButton.Flyout>
                    <MPathIcon Classes.Checked="{Binding $parent[MToggleSplitButton].IsChecked}" Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="8" />
                </MToggleSplitButton>
            </MPanel>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MToggleSplitButton}" TargetType="MToggleSplitButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Ring" CornerRadius="{TemplateBinding CornerRadius}" />
                    <Border Name="Background" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid ColumnDefinitions="* Auto">
                            <MButton Grid.Column="0" Name="PART_PrimaryButton"
                                     Padding="{TemplateBinding Padding}"
                                     Foreground="{TemplateBinding Foreground}"
                                     HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                     Command="{TemplateBinding Command}"
                                     CommandParameter="{TemplateBinding CommandParameter}"
                                     Content="{TemplateBinding Content}"
                                     ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Border Grid.Column="0" Name="Line">
                                <Border />
                            </Border>
                            <MDropDownButton Grid.Column="1" Name="PART_SecondaryButton">
                                <MPathIcon Name="DropDownIcon" />
                            </MDropDownButton>
                        </Grid>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <!-- Base -->
        <Setter Property="Padding" Value="{MThickness S4, Vertical=S2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{MRadius MD}" />
        <Setter Property="Transitions">
            <Transitions>
                <SmoothBrushTransition Property="Background" Duration="0:0:0.1" />
                <SmoothBrushTransition Property="BorderBrush" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <!-- Path -->
        <Style Selector="^ /template/ Border#Line">
            <Setter Property="ZIndex" Value="2" />
            <Setter Property="Width" Value="{MSize Px}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="{MThickness S2, Filter=Top|Bottom}" />
        </Style>
        <Style Selector="^ /template/ MPathIcon#DropDownIcon">
            <Setter Property="Data" Value="M6 9L12 15L18 9" />
            <Setter Property="UseStroke" Value="True" />
            <Setter Property="Size" Value="{MSize S2}" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:flyout-open /template/ MPathIcon#DropDownIcon">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <!-- Button -->
        <Style Selector="^ /template/ MButton">
            <Setter Property="CornerRadius" Value="{MRadius MD, Filter=Left}" />
        </Style>
        <Style Selector="^ /template/ MDropDownButton">
            <Setter Property="CornerRadius" Value="{MRadius MD, Filter=Right}" />
            <Setter Property="Padding" Value="{MThickness S3, Vertical=S2_5}" />
            <Setter Property="Margin" Value="-1 0 0 0" />
        </Style>
        <Style Selector="^ /template/ MButton:pointerover">
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="^ /template/ MDropDownButton:pointerover">
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <!-- Button -->
        <Style Selector="^ /template/ MButton">
            <Setter Property="Variant" Value="Flat" />
        </Style>
        <Style Selector="^ /template/ MDropDownButton">
            <Setter Property="Variant" Value="Flat" />
        </Style>
        <Style Selector="^ /template/ Border#Line">
            <Setter Property="Width" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <!-- <Setter Property="Background" Value="{MBrush Accent}" /> -->
            <Setter Property="Margin" Value="0 1 -1 1" />
            <Style Selector="^ > Border">
                <Setter Property="Width" Value="{MSize Px}" />
                <Setter Property="Background" Value="{MBrush Foreground, Opacity=0.1}" />
                <Setter Property="Margin" Value="{MThickness S2, Filter=Top|Bottom}" />
            </Style>
        </Style>
        <!-- Self -->
        <Style Selector="^[Variant=Outline]">
            <Setter Property="Padding" Value="{MThickness S4, Vertical=S2, OffsetNegative=Px}" />
            <Setter Property="BorderThickness" Value="{MThickness Px}" />
            <Setter Property="BorderBrush" Value="{MBrush Border}" />
            <Setter Property="Background" Value="{OnTheme {MBrush Background}, Dark={MBrush Accent}}" />
            <Setter Property="Foreground" Value="{MBrush Foreground}" />
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="BoxShadow" Value="{MShadow SM}" />
            </Style>
            <Style Selector="^ /template/ Border#Ring">
                <Setter Property="BoxShadow" Value="{MRing None, BrushKey=Shadow, BrushOpacity=0.1}" />
                <Setter Property="Transitions">
                    <Transitions>
                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.1" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:checked">
                <Setter Property="BorderBrush" Value="{MBrush Border, Opacity=0}" />
                <Style Selector="^ /template/ Border#Ring">
                    <Setter Property="BoxShadow" Value="{MRing MD, BrushOpacity=0.7}" />
                </Style>
            </Style>
            <Style Selector="^:disabled">
                <Style Selector="^:checked">
                    <Style Selector="^ /template/ Border#Ring">
                        <Setter Property="BoxShadow" Value="{MRing MD, BrushOpacity=0.3}" />
                    </Style>
                </Style>
            </Style>
        </Style>
        <Style Selector="^[Variant=Ghost]">
            <Setter Property="Padding" Value="{MThickness S3, Vertical=S2}" />
            <Setter Property="BorderBrush" Value="{MBrush Border}" />
            <Setter Property="Background" Value="{MBrush Foreground, Opacity=0}" />
            <Setter Property="Foreground" Value="{MBrush Foreground}" />
            <Setter Property="Transitions">
                <Transitions>
                    <SmoothBrushTransition Property="Background" Duration="0:0:0.1" />
                    <SmoothBrushTransition Property="Foreground" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ MButton">
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{MBrush Foreground, Opacity=0.1}" />
                </Style>
            </Style>
            <Style Selector="^ /template/ MDropDownButton">
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{MBrush Foreground, Opacity=0.1}" />
                </Style>
            </Style>
            <Style Selector="^:checked">
                <Style Selector="^ /template/ MButton">
                    <Setter Property="Foreground" Value="{MBrush Primary}" />
                    <Setter Property="Background" Value="{MBrush Primary, Opacity=0.1}" />
                </Style>
                <Style Selector="^ /template/ MDropDownButton">
                    <Setter Property="Foreground" Value="{MBrush Primary}" />
                    <Setter Property="Background" Value="{MBrush Primary, Opacity=0.1}" />
                </Style>
            </Style>
            <Style Selector="^:disabled">
                <Style Selector="^ /template/ MButton">
                    <Setter Property="Background" Value="{MBrush Foreground, Opacity=0}" />
                    <Setter Property="Foreground" Value="{MBrush Foreground, Opacity=0.5}" />
                </Style>
                <Style Selector="^ /template/ MDropDownButton">
                    <Setter Property="Background" Value="{MBrush Foreground, Opacity=0}" />
                    <Setter Property="Foreground" Value="{MBrush Foreground, Opacity=0.5}" />
                </Style>
                <Setter Property="Background" Value="{MBrush Foreground, Opacity=0}" />
                <Setter Property="Foreground" Value="{MBrush Foreground, Opacity=0.5}" />
                <Style Selector="^:checked">
                    <Setter Property="Background" Value="{MBrush Primary, Opacity=0.05}" />
                    <Setter Property="Foreground" Value="{MBrush Primary, Opacity=0.5}" />
                    <Style Selector="^ /template/ MButton">
                        <Setter Property="Background" Value="{MBrush Primary, Opacity=0.05}" />
                        <Setter Property="Foreground" Value="{MBrush Primary, Opacity=0.5}" />
                    </Style>
                    <Style Selector="^ /template/ MDropDownButton">
                        <Setter Property="Background" Value="{MBrush Primary, Opacity=0.05}" />
                        <Setter Property="Foreground" Value="{MBrush Primary, Opacity=0.5}" />
                    </Style>
                </Style>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
