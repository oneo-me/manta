<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <!-- Progress -->
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel Mode="Horizontal" Spacing="12">
                <MRingShape />
                <MRingShape Value="50" />
                <MRingShape Value="100" />
            </MPanel>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MRingShape}" TargetType="MRingShape">
        <Setter Property="Size" Value="{MSize S9}" />
        <Setter Property="StrokeSize" Value="2.5" />
        <Setter Property="Value" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                    <Ellipse StrokeThickness="{TemplateBinding StrokeSize}" Stroke="{TemplateBinding Background}" />
                    <Arc Name="PART_Arc" StartAngle="90" StrokeThickness="{TemplateBinding StrokeSize}" Stroke="{TemplateBinding Foreground}"
                         StrokeLineCap="Round" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
