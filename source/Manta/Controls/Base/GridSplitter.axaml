<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Margin" Value="-4" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Background" Value="{MBrush Foreground, Opacity=0}" />
        <Setter Property="PreviewContent">
            <Template>
                <Rectangle Fill="{MBrush Foreground, Opacity=0.15}" Margin="2" />
            </Template>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Rectangle Fill="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
