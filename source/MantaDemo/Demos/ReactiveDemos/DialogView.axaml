<MView
    x:Class="MantaDemo.Demos.ReactiveDemos.DialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.ReactiveDemos"
    x:DataType="local:DialogView_Model">
    <Design.DataContext>
        <local:DialogView_Model />
    </Design.DataContext>
    <MPanel Mode="Vertical" Spacing="12" Margin="12">
        <TextBlock Text="Normal" />
        <MPanel Mode="Horizontal" Spacing="12">
            <MButton Variant="Outline" Content="Alert" Command="{Binding AlertAsyncCommand}" />
            <MButton Variant="Outline" Content="Confirm" Command="{Binding ConfirmAsyncCommand}" />
        </MPanel>
        <TextBlock Text="File Dialog" />
        <MCheckBox IsChecked="{Binding AllowMultiple}" Header="Allow Multiple" />
        <MPanel Mode="Horizontal" Spacing="12">
            <MButton Variant="Outline" Content="Open File" Command="{Binding OpenFileAsyncCommand}" />
            <MButton Variant="Outline" Content="Save File" Command="{Binding SaveFileAsyncCommand}" />
            <MButton Variant="Outline" Content="Open Folder" Command="{Binding OpenFolderAsyncCommand}" />
        </MPanel>
    </MPanel>
</MView>
