<MView
    x:Class="MantaDemo.Demos.AutoDemos.RingShapeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:RingShapeView_Model">
    <Design.DataContext>
        <local:RingShapeView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel Mode="Horizontal" Spacing="12">
                <MRingShape />
                <MRingShape Value="50" />
                <MRingShape Value="100" />
            </MPanel>
        </MPanel>
    </Panel>
</MView>
