<MView
    x:Class="MantaDemo.Demos.AutoDemos.BadgeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:BadgeView_Model">
    <Design.DataContext>
        <local:BadgeView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel Mode="Horizontal" Spacing="8">
                <MBadge Content="Badge" />
                <MBadge Variant="Secondary" Content="Secondary" />
                <MBadge Variant="Destructive" Content="Destructive" />
                <MBadge Variant="Outline" Content="Outline" />
            </MPanel>
            <MPanel Mode="Horizontal" Spacing="8">
                <MBadge Background="{MBrush Primary}">
                    <MPanel Mode="Horizontal" Spacing="4">
                        <MPathIcon Size="12" StrokeThickness="1" UseStroke="True" Data="M9.388 4.29a4.302 4.302 0 0 0-6.127-.016c-1.688 1.705-1.68 4.476.016 6.189l6.277 6.34c.26.263.682.263.942 0l6.245-6.304a4.408 4.408 0 0 0-.017-6.187 4.305 4.305 0 0 0-6.135-.015l-.596.603-.605-.61Z M 0 0 M 20 20"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Verified" VerticalAlignment="Center" />
                    </MPanel>
                </MBadge>
                <MBadge Content="8" />
                <MBadge Variant="Destructive" Content="99" />
                <MBadge Variant="Outline" Content="20+" />
            </MPanel>
        </MPanel>
    </Panel>
</MView>
