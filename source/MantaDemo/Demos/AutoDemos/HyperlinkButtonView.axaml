<MView
    x:Class="MantaDemo.Demos.AutoDemos.HyperlinkButtonView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:HyperlinkButtonView_Model">
    <Design.DataContext>
        <local:HyperlinkButtonView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MHyperlinkButton Content="Default Hyperlink" NavigateUri="https://github.com" />
            <MHyperlinkButton Content="Hover to see underline" />
            <MHyperlinkButton Variant="Subtle" Content="Subtle Hyperlink" />
            <MPanel Mode="Horizontal" Spacing="8">
                <MHyperlinkButton Content="Link with Icon">
                    <MHyperlinkButton.ContentTemplate>
                        <DataTemplate>
                            <MPanel Mode="Horizontal" Spacing="6">
                                <MPathIcon Data="M7 7h10v10 M7 17 17 7" UseStroke="True" Size="6" VerticalAlignment="Center" />
                                <TextBlock Text="External Link" VerticalAlignment="Center" />
                            </MPanel>
                        </DataTemplate>
                    </MHyperlinkButton.ContentTemplate>
                </MHyperlinkButton>
            </MPanel>
        </MPanel>
    </Panel>
</MView>
