<MView
    x:Class="MantaDemo.Demos.AutoDemos.AspectRatioView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:AspectRatioView_Model">
    <Design.DataContext>
        <local:AspectRatioView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Column" ColumnSize="220" Spacing="12" Margin="12" Design.Width="400">
            <MAspectRatio Ratio="16 / 9">
                <Border Background="{MBrush Border}" CornerRadius="8">
                    <TextBlock Text="16 /9" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </MAspectRatio>
            <MAspectRatio Ratio="21 / 9">
                <Border Background="{MBrush Border}" CornerRadius="8">
                    <TextBlock Text="21 /9" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
            </MAspectRatio>
        </MPanel>
    </Panel>
</MView>
