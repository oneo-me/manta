<MView
    x:Class="MantaDemo.Demos.AutoDemos.DropDownButtonView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MantaDemo.Demos.AutoDemos"
    x:DataType="local:DropDownButtonView_Model">
    <Design.DataContext>
        <local:DropDownButtonView_Model />
    </Design.DataContext>
    <Panel HorizontalAlignment="Left" VerticalAlignment="Top">
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel Mode="Wrap" Spacing="12">
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Content="Button">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Secondary" Content="Secondary">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Destructive" Content="Destructive">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Outline" Content="Outline">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Ghost" Content="Ghost">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Flat" Content="Flat">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
            </MPanel>
            <TextBlock Text="Disabled" />
            <MPanel Mode="Wrap" Spacing="12" IsEnabled="False">
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Content="Button">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Secondary" Content="Secondary">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Destructive" Content="Destructive">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Outline" Content="Outline">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Ghost" Content="Ghost">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
                <MPanel Mode="Horizontal" Spacing="8">
                    <MDropDownButton Variant="Flat" Content="Flat">
                        <MDropDownButton.Flyout>
                            <MMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MMenuItem Header="Option 1" />
                                <MMenuItem Header="Option 2" />
                            </MMenuFlyout>
                        </MDropDownButton.Flyout>
                    </MDropDownButton>
                </MPanel>
            </MPanel>
        </MPanel>
    </Panel>
</MView>
