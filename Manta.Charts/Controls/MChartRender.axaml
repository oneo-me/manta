<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type MChartRender}" TargetType="MChartRender">
        <Setter Property="Background" Value="{MBrush Background}" />
        <Setter Property="Foreground" Value="{MBrush Foreground}" />
        <Setter Property="BorderBrush" Value="{MBrush Border}" />
    </ControlTheme>
</ResourceDictionary>
