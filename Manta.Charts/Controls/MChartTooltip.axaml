<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Manta.Charts.Controls"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="WrapFull" Width="400" Spacing="12" Margin="12">
            <controls:MChartTooltip Header="Category A">
                <controls:MChartTooltip.Lines>
                    <controls:ChartTooltipLine Label="Series 1" Value="1,234" Color="#60A34C" />
                    <controls:ChartTooltipLine Label="Series 2" Value="567" Color="#5285CC" />
                </controls:MChartTooltip.Lines>
            </controls:MChartTooltip>
            <controls:MChartTooltip Header="Slice Info">
                <controls:MChartTooltip.Lines>
                    <controls:ChartTooltipLine Label="" Value="45.6%" Color="#D482A3" />
                </controls:MChartTooltip.Lines>
            </controls:MChartTooltip>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type controls:MChartTooltip}" TargetType="controls:MChartTooltip">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:MChartTooltip">
                <Border Background="{MBrush Popover}"
                        BorderBrush="{MBrush Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        BoxShadow="{MShadow XL}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{TemplateBinding Header}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <MItems ItemsSource="{TemplateBinding Lines}">
                            <MItems.ItemTemplate>
                                <DataTemplate DataType="controls:ChartTooltipLine">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="12" Height="8" CornerRadius="8" Background="{Binding ColorBrush}" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}: {1}">
                                                    <Binding Path="Label" />
                                                    <Binding Path="Value" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </MItems.ItemTemplate>
                        </MItems>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type controls:MChartTooltipHost}" TargetType="controls:MChartTooltipHost">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:MChartTooltipHost">
                <ContentPresenter Content="{TemplateBinding Content}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
