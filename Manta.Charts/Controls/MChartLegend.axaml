<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Manta.Charts.Controls"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="WrapFull" Width="400" Spacing="12" Margin="12">
            <controls:MChartLegend Orientation="Horizontal">
                <controls:MChartLegend.Items>
                    <controls:ChartLegendItem Name="Series 1" Color="#60A34C" />
                    <controls:ChartLegendItem Name="Series 2" Color="#5285CC" />
                    <controls:ChartLegendItem Name="Series 3" Color="#D482A3" />
                </controls:MChartLegend.Items>
            </controls:MChartLegend>
            <controls:MChartLegend Orientation="Vertical">
                <controls:MChartLegend.Items>
                    <controls:ChartLegendItem Name="Category A" Color="#60A34C" />
                    <controls:ChartLegendItem Name="Category B" Color="#5285CC" />
                    <controls:ChartLegendItem Name="Category C" Color="#D482A3" />
                    <controls:ChartLegendItem Name="Category D" Color="#D4A346" />
                </controls:MChartLegend.Items>
            </controls:MChartLegend>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type controls:MChartLegend}" TargetType="controls:MChartLegend">
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:MChartLegend">
                <MItems ItemsSource="{TemplateBinding Items}">
                    <MItems.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel x:Name="PART_Panel" Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </MItems.ItemsPanel>
                    <MItems.ItemTemplate>
                        <DataTemplate DataType="controls:ChartLegendItem">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="8" CornerRadius="2" Background="{Binding ColorBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </MItems.ItemTemplate>
                </MItems>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Orientation=Vertical] /template/ StackPanel#PART_Panel">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Spacing" Value="4" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
