<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MCard Width="520" Height="380">
                <MChart />
            </MCard>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MChart}" TargetType="MChart" />
</ResourceDictionary>
