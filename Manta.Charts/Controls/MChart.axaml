<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MCard Width="520" Height="380">
                <MChart />
            </MCard>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MChart}" TargetType="MChart">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto * Auto">
                    <ContentPresenter Grid.Row="0" Content="{TemplateBinding Title}" ContentTemplate="{TemplateBinding TitleDataTemplate}"
                                      Margin="12 12 12 0" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Panel Grid.Row="1" Margin="12 12 12 0">
                        <Grid RowDefinitions="* Auto">
                            <MPanel Grid.Row="0" Name="PART_Background" Mode="VerticalUniform">
                                <Border />
                                <Border />
                                <Border />
                                <Border />
                            </MPanel>
                            <MItems Grid.Row="0" Name="PART_Columns" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Data.Columns}">
                                <MItems.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <MPanel Mode="HorizontalUniform" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </MItems.ItemsPanel>
                                <MItems.ItemTemplate>
                                    <DataTemplate DataType="MChartData+Column">
                                        <MChartColumn Data="{Binding}" />
                                    </DataTemplate>
                                </MItems.ItemTemplate>
                            </MItems>
                            <MItems Grid.Row="1" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Data.Columns}"
                                        Margin="0 12 0 0">
                                <MItems.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <MPanel Mode="HorizontalUniform" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </MItems.ItemsPanel>
                                <MItems.ItemTemplate>
                                    <DataTemplate DataType="MChartData+Column">
                                        <TextBlock Text="{Binding Name}" Opacity="0.5" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </MItems.ItemTemplate>
                            </MItems>
                        </Grid>
                    </Panel>
                    <MItems Grid.Row="2" ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Data.Legends}" IsVisible="{TemplateBinding ShowLegends}">
                        <MItems.ItemsPanel>
                            <ItemsPanelTemplate>
                                <MPanel Margin="12" Mode="Wrap" Spacing="8" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </MItems.ItemsPanel>
                        <MItems.ItemTemplate>
                            <DataTemplate DataType="MChartData+Legend">
                                <MChartLegend Brush="{Binding Brush}" Data="{Binding Data}" />
                            </DataTemplate>
                        </MItems.ItemTemplate>
                    </MItems>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ ContentPresenter:empty">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ MPanel#PART_Background Border">
            <Setter Property="BorderBrush" Value="{MBrush BorderBrush}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type MChartLegend}" TargetType="MChartLegend">
        <Setter Property="Template">
            <ControlTemplate>
                <MPanel>
                    <Border Background="{TemplateBinding Brush}" />
                    <TextBlock Text="{TemplateBinding Data}" />
                </MPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ MPanel">
            <Setter Property="Mode" Value="Horizontal" />
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style Selector="^ /template/ Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^ /template/ TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type MChartToolTip}" TargetType="MChartToolTip">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderBrush="{MBrush BorderBrush}" BoxShadow="{MShadow DropXL2, BrushOpacity=0.08}" Background="{MBrush Background}" CornerRadius="8" BorderThickness="1"
                        Padding="12 8">
                    <MPanel Mode="Vertical" Spacing="4" Grid.IsSharedSizeScope="True">
                        <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Data.Name}" FontWeight="SemiBold" />
                        <MItems ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Data.Data}">
                            <MItems.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <MPanel Mode="Vertical" Spacing="4" />
                                </ItemsPanelTemplate>
                            </MItems.ItemsPanel>
                            <MItems.ItemTemplate>
                                <DataTemplate DataType="MChartData+ColumnData">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="3" Background="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </MItems.ItemTemplate>
                        </MItems>
                    </MPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type MChartColumn}" TargetType="MChartColumn">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <MItems ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Data.Data}">
                        <MItems.ItemsPanel>
                            <ItemsPanelTemplate>
                                <MPanel Mode="HorizontalUniform" Spacing="4" />
                            </ItemsPanelTemplate>
                        </MItems.ItemsPanel>
                        <MItems.ItemTemplate>
                            <DataTemplate DataType="MChartData+ColumnData">
                                <MChartBarPanel Ratio="{Binding RenderRatio}">
                                    <Border CornerRadius="5" Background="{Binding Brush}" />
                                </MChartBarPanel>
                            </DataTemplate>
                        </MItems.ItemTemplate>
                    </MItems>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="BorderBrush" Value="{MBrush BorderBrush, Opacity=0}" />
        <Setter Property="Background" Value="{MBrush BorderBrush, Opacity=0}" />
        <Setter Property="Transitions">
            <Transitions>
                <SmoothBrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="-2 -2 -2 -4" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="BorderThickness" Value="1" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{MBrush BorderBrush, Opacity=0.8}" />
            <Setter Property="BorderBrush" Value="{MBrush BorderBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
