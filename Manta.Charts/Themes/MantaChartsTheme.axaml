<Styles
    x:Class="Manta.Charts.Themes.MantaChartsTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="../Controls/MChart.axaml" />
                <MergeResourceInclude Source="../Controls/MChartRender.axaml" />
                <MergeResourceInclude Source="../Controls/MChartLegend.axaml" />
                <MergeResourceInclude Source="../Controls/MChartTooltip.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
