    <system:Double x:Key="{ThemeFontHeightKey XL8}">60</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey XL9}">72</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey XL9}">72</system:Double>
    <!-- FontWeights -->
    <FontWeight x:Key="{ThemeFontWeightKey Thin}">Thin</FontWeight>
    <FontWeight x:Key="{ThemeFontWeightKey Extralight}">ExtraLight</FontWeight>
    <FontWeight x:Key="{ThemeFontWeightKey Light}">Light</FontWeight>
    <FontWeight x:Key="{ThemeFontWeightKey Normal}">Normal</FontWeight>
    <FontWeight x:Key="{ThemeFontWeightKey Medium}">Medium</FontWeight>
    <FontWeight x:Key="{ThemeFontWeightKey Semibold}">SemiBold</FontWeight>
    <FontWeight x:Key="{ThemeFontWeightKey Bold}">Bold</FontWeight>
    <FontWeight x:Key="{ThemeFontWeightKey Extrabold}">ExtraBold</FontWeight>
    <FontWeight x:Key="{ThemeFontWeightKey Black}">Black</FontWeight>
    <!-- FontTracking -->
    <system:Double x:Key="{ThemeFontSpacingKey Tighter}">-0.8</system:Double>
    <system:Double x:Key="{ThemeFontSpacingKey Tight}">-0.4</system:Double>
    <system:Double x:Key="{ThemeFontSpacingKey Normal}">0</system:Double>
    <system:Double x:Key="{ThemeFontSpacingKey Wide}">0.4</system:Double>
    <system:Double x:Key="{ThemeFontSpacingKey Wider}">0.8</system:Double>
    <system:Double x:Key="{ThemeFontSpacingKey Widest}">1.6</system:Double>
    <!-- Radius -->
    <system:Double x:Key="{ThemeRadiusKey XS}">2</system:Double>
    <system:Double x:Key="{ThemeRadiusKey SM}">4</system:Double>
    <system:Double x:Key="{ThemeRadiusKey MD}">6</system:Double>
    <system:Double x:Key="{ThemeRadiusKey LG}">8</system:Double>
    <system:Double x:Key="{ThemeRadiusKey XL}">12</system:Double>
    <system:Double x:Key="{ThemeRadiusKey XL2}">16</system:Double>
    <system:Double x:Key="{ThemeRadiusKey XL3}">24</system:Double>
    <system:Double x:Key="{ThemeRadiusKey XL4}">32</system:Double>
    <!-- Shadows -->
    <BoxShadows x:Key="{ThemeShadowKey XS2}">0 1 #0D000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey XS}">0 1 2 0 #0D000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey SM}">0 1 3 0 #1A000000, 0 1 2 -1 #1A000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey MD}">0 4 6 -1 #1A000000, 0 2 4 -2 #1A000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey LG}">0 10 15 -3 #1A000000, 0 4 6 -4 #1A000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey XL}">0 20 25 -5 #1A000000, 0 8 10 -6 #1A000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey XL2}">0 25 50 -12 #40000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InsetXS2}">inset 0 1 #0D000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InsetXS}">inset 0 1 1 #0D000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey InsetSM}">inset 0 2 4 #0D000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey DropXS}">0 1 1 #0D000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey DropSM}">0 1 2 #26000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey DropMD}">0 3 3 #1F000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey DropLG}">0 4 4 #26000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey DropXL}">0 9 7 #1A000000</BoxShadows>
    <BoxShadows x:Key="{ThemeShadowKey DropXL2}">0 25 25 #26000000</BoxShadows>
    <!-- Thicknesses -->
    <system:Double x:Key="{ThemeThicknessKey Normal}">1</system:Double>
