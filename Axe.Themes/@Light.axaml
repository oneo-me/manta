<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:values="clr-namespace:Axe.Themes.Values"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:ClassModifier="internal">
    <!-- Refs -->
    <values:ThemeRefValue x:Key="{ThemeBrushKey Window_Background}" Value="{ThemeBrush Gray50}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Background}" Value="{ThemeBrush Gray50, Opacity=0.9}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey BorderBrush}" Value="{ThemeBrush Gray400, Opacity=0.2}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Foreground}" Value="{ThemeBrush Gray800}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Primary}" Value="{ThemeBrush Teal400}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Primary_Foreground}" Value="{ThemeBrush White}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Success}" Value="{ThemeBrush Green400}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Success_Foreground}" Value="{ThemeBrush White}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Warning}" Value="{ThemeBrush Yellow400}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Warning_Foreground}" Value="{ThemeBrush White}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Error}" Value="{ThemeBrush Red400}" />
    <values:ThemeRefValue x:Key="{ThemeBrushKey Error_Foreground}" Value="{ThemeBrush White}" />
    <!-- FontSizes -->
    <system:Double x:Key="{ThemeFontSizeKey SM}">10</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey SM}">14</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey Base}">12</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey Base}">16</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey LG}">14</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey LG}">20</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey XL}">16</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey XL}">24</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey XL2}">18</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey XL2}">26</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey XL3}">20</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey XL3}">28</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey XL4}">24</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey XL4}">32</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey XL5}">30</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey XL5}">36</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey XL6}">36</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey XL6}">40</system:Double>
    <system:Double x:Key="{ThemeFontSizeKey XL7}">48</system:Double>
    <system:Double x:Key="{ThemeFontHeightKey XL7}">48</system:Double>
