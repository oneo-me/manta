<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <DevelopmentDependency>true</DevelopmentDependency>
        <BuildOutputTargetFolder>analyzers/dotnet/cs</BuildOutputTargetFolder>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>
    <PropertyGroup>
        <IsAotCompatible>false</IsAotCompatible>
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="YamlDotNet" GeneratePathProperty="true" />
        <Analyzer Include="$(PkgYamlDotNet)/lib/netstandard2.0/YamlDotNet.dll" />
    </ItemGroup>
    <ItemGroup>
        <None Include="build\$(AssemblyName).props" PackagePath="build" Pack="true" />
        <None Include="$(PkgYamlDotNet)/lib/netstandard2.0/YamlDotNet.dll" PackagePath="analyzers/dotnet/cs/netstandard2.0" Pack="true" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Manta\Globalization\Core\*.cs">
            <Link>LangKey\Globalization\Core\%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>
</Project>
