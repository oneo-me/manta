<Project>
    <ItemGroup>
        <AdditionalFiles Include="Langs\*.yml" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="YamlDotNet" PrivateAssets="all" ExcludeAssets="runtime" GeneratePathProperty="true" />
        <Analyzer Include="$(PkgYamlDotNet)/lib/netstandard2.0/YamlDotNet.dll" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)Manta.Generators/Manta.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>
</Project>
