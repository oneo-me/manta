<Project>
    <ItemGroup>
        <AdditionalFiles Include="Langs\*.yml" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="YamlDotNet" PrivateAssets="all" ExcludeAssets="runtime" GeneratePathProperty="true" />
        <ProjectReference Include="$(MSBuildThisFileDirectory)Manta.Generators/Manta.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <Analyzer Include="$(PkgYamlDotNet)/lib/netstandard2.0/YamlDotNet.dll" />
    </ItemGroup>
</Project>
