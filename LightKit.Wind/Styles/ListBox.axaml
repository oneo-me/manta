<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <ListBox Wind.ListBox="Sidebar">
            <ListBoxItem Content="ListBoxItem 1" />
            <ListBoxItem Content="ListBoxItem 2" />
            <ListBoxItem Content="ListBoxItem 3" />
        </ListBox>
    </Design.PreviewWith>
    <Style Selector="ListBox[(Wind.ListBox)=Sidebar]">
        <Setter Property="Padding" Value="12" />
        <Style Selector="^ ListBoxItem">
            <Setter Property="Wind.ListBox" Value="Sidebar" />
        </Style>
    </Style>
    <Style Selector="ListBoxItem[(Wind.ListBox)=Sidebar]">
        <Setter Property="Margin" Value="0 0 0 2" />
        <Setter Property="Padding" Value="12 9" />
        <Setter Property="CornerRadius" Value="{ThemeRadius LG}" />
        <Setter Property="Background" Value="{ThemeBrush Foreground, Opacity=0}" />
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{ThemeBrush Foreground, Opacity=0.1}" />
        </Style>
        <Style Selector="^:pointerover:not(:selected)">
            <Setter Property="Background" Value="{ThemeBrush Foreground, Opacity=0.05}" />
        </Style>
        <Style Selector="^:nth-last-child(1)">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Style>
</Styles>
