<Styles
    x:Class="LightKit.Wind.WindTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Default" Source="@Light.axaml" />
                <ResourceInclude x:Key="Light" Source="@Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="@Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <BaseTheme />
    <StyleInclude Source="../Styles/ListBox.axaml" />
    <StyleInclude Source="../Styles/TabStrip.axaml" />
</Styles>
