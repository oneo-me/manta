<LightView
    x:Class="Manta.Dialogs.DialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Dialogs"
    x:DataType="local:DialogView_Model" Design.DataContext="{x:Static local:DialogView_Model.Design}"
    Background="{ThemeColorSet Background, Opacity=0.8}">
    <LightPanel Mode="Vertical" Spacing="18" Margin="18">
        <LightText Text="{Lang {Binding Options.Title}}" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <LightSelectableText Text="{Lang {Binding Options.Message}}" TextAlignment="Center" HorizontalAlignment="Center" />
        <LightPanel Mode="Horizontal" Spacing="18" HorizontalAlignment="Center">
            <LightButton Size="Default" MinWidth="80" Theme.ColorScheme="{Binding Options.CancelColor}" IsCancel="True" Content="{Lang {Binding Options.CancelText}}" Command="{Binding OnCancel}" IsVisible="{Binding Options.ShowCancel}" />
            <LightButton Size="Default" MinWidth="80" Theme.ColorScheme="{Binding Options.ConfirmColor}" IsDefault="True" Content="{Lang {Binding Options.ConfirmText}}" Command="{Binding OnConfirm}" IsVisible="{Binding Options.ShowConfirm}" />
        </LightPanel>
    </LightPanel>
</LightView>
