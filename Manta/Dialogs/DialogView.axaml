<MView
    x:Class="Manta.Dialogs.DialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Dialogs"
    x:DataType="local:DialogView_Model" Design.DataContext="{x:Static local:DialogView_Model.Design}"
    Background="{MBrush Background, Opacity=0.8}">
    <MDialogTemplate Header="{Lang {Binding Options.Header}}"
                     CancelButton="{Lang {Binding Options.CancelButton}}"
                     CancelButtonVariant="{Lang {Binding Options.CancelButtonVariant}}"
                     ContinueButton="{Lang {Binding Options.ContinueButton}}"
                     ContinueButtonVariant="{Lang {Binding Options.ContinueButtonVariant}}"
                     IsShowCancelButton="{Binding IsShowCancelButton}"
                     IsShowContinueButton="{Binding IsShowContinueButton}"
                     CancelButtonCommand="{Binding OnCancel}"
                     ContinueButtonCommand="{Binding OnContinue}">
        <SelectableTextBlock Text="{Lang {Binding Options.Content}}" />
    </MDialogTemplate>
</MView>
