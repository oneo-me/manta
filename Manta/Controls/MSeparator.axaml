<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MItems>
                <MItems.ItemsPanel>
                    <ItemsPanelTemplate>
                        <MPanel Mode="Vertical" Spacing="8" />
                    </ItemsPanelTemplate>
                </MItems.ItemsPanel>
                <MItem Content="Item 1" Width="120" HorizontalContentAlignment="Center" />
                <MSeparator />
                <MItem Content="Item 2" Width="120" HorizontalContentAlignment="Center" />
                <MItem Content="Item 3" Width="120" HorizontalContentAlignment="Center" />
            </MItems>
            <MItems>
                <MItems.ItemsPanel>
                    <ItemsPanelTemplate>
                        <MPanel Mode="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </MItems.ItemsPanel>
                <MItem Content="Item 1" Height="120" VerticalContentAlignment="Center" />
                <MSeparator Orientation="Vertical" />
                <MItem Content="Item 2" Height="120" VerticalContentAlignment="Center" />
                <MItem Content="Item 3" Height="120" VerticalContentAlignment="Center" />
            </MItems>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MSeparator}" TargetType="MSeparator">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Margin}"
                        Height="{TemplateBinding Height}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{MBrush Border}" />
        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="{MSize Px}" />
            <Setter Property="Margin" Value="{MThickness S0, Vertical=S1}" />
        </Style>
        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Width" Value="{MSize Px}" />
            <Setter Property="Margin" Value="{MThickness S1, Vertical=S0}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
