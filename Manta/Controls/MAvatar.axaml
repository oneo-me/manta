<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel Mode="Horizontal">
                <MAvatar Content="ON" Source="https://github.com/shadcn-no.png" />
                <MAvatar Content="ON" Source="https://github.com/shadcn.png" />
            </MPanel>
            <MPanel Mode="Horizontal">
                <MAvatar Content="ON" Source="https://github.com/evilrabbit.png" CornerRadius="6" />
            </MPanel>
            <MPanel Mode="Horizontal" Spacing="-16">
                <MAvatar Content="ON" Source="https://github.com/shadcn.png" BorderThickness="2.5" />
                <MAvatar Content="ON" Source="https://github.com/maxleiter.png" BorderThickness="2.5" />
                <MAvatar Content="ON" Source="https://github.com/evilrabbit.png" BorderThickness="2.5" />
            </MPanel>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MAvatar}" TargetType="MAvatar">
        <Setter Property="LoadingSize" Value="14" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Size" Value="36" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="BorderBrush" Value="{MBrush Background}" />
        <Setter Property="Background" Value="{MBrush BorderBrush}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <MImage Width="{TemplateBinding Size}"
                        Height="{TemplateBinding Size}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="{TemplateBinding ClipToBounds}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        Content="{TemplateBinding Content}"
                        Source="{TemplateBinding Source}"
                        Padding="{TemplateBinding Padding}"
                        LoadingSize="{TemplateBinding LoadingSize}"
                        BlendMode="{TemplateBinding BlendMode}"
                        Stretch="{TemplateBinding Stretch}"
                        StretchDirection="{TemplateBinding StretchDirection}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
