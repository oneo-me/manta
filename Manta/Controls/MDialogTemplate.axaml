<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:langs="clr-namespace:Manta.Langs"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <MPanel.Styles>
                <Style Selector="MCard">
                    <Setter Property="MaxWidth" Value="520" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </MPanel.Styles>
            <MCard>
                <MDialogTemplate Header="Are you absolutely sure?">
                    <SelectableTextBlock Text="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
                                         TextWrapping="Wrap"
                                         Foreground="{MBrush MutedForeground}" />
                </MDialogTemplate>
            </MCard>
            <MCard>
                <MDialogTemplate Header="Are you absolutely sure?">
                    <MDialogTemplate.Footer>
                        <SelectableTextBlock Text="This Footer is custom!"
                                             Foreground="{MBrush MutedForeground}" />
                    </MDialogTemplate.Footer>
                    <SelectableTextBlock Text="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
                                         TextWrapping="Wrap"
                                         Foreground="{MBrush MutedForeground}" />
                </MDialogTemplate>
            </MCard>
            <MCard>
                <MDialogTemplate Header="Are you absolutely sure?" CancelButton="" ContinueButton="Delete Account" ContinueButtonVariant="Destructive">
                    <SelectableTextBlock Text="This action cannot be undone. This will permanently delete your account and remove your data from our servers."
                                         TextWrapping="Wrap"
                                         Foreground="{MBrush MutedForeground}" />
                </MDialogTemplate>
            </MCard>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MDialogTemplate}" TargetType="MDialogTemplate">
        <Setter Property="BorderBrush" Value="{MBrush Border}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid RowDefinitions="Auto * Auto" RowSpacing="{MSize S3}" Margin="{TemplateBinding Padding}">
                        <ContentPresenter Grid.Row="0" Name="PART_HeaderPresenter"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Content="{TemplateBinding Header}"
                                          HorizontalAlignment="{TemplateBinding HorizontalHeaderAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalHeaderAlignment}" />
                        <ContentPresenter Grid.Row="1" Name="PART_ContentPresenter"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Content="{TemplateBinding Content}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Grid Grid.Row="2" Name="Footer" ColumnDefinitions="* Auto Auto" ColumnSpacing="{MSize S3}">
                            <ContentPresenter Grid.Column="0" Name="PART_FooterPresenter"
                                              ContentTemplate="{TemplateBinding FooterTemplate}"
                                              Content="{TemplateBinding Footer}"
                                              HorizontalAlignment="{TemplateBinding HorizontalFooterAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalFooterAlignment}" />
                            <MButton Grid.Column="1"
                                     IsCancel="{TemplateBinding CancelButton, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     IsDefault="{TemplateBinding ContinueButton, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                     IsVisible="{TemplateBinding CancelButton, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Variant="{TemplateBinding CancelButtonVariant}"
                                     Command="{TemplateBinding CancelButtonCommand}"
                                     ContentTemplate="{TemplateBinding CancelButtonTemplate}"
                                     Content="{TemplateBinding CancelButton}"
                                     VerticalAlignment="{TemplateBinding VerticalFooterAlignment}" />
                            <MButton Grid.Column="2"
                                     IsDefault="{TemplateBinding ContinueButton, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     IsCancel="{TemplateBinding CancelButton, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                     IsVisible="{TemplateBinding ContinueButton, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                     Variant="{TemplateBinding ContinueButtonVariant}"
                                     Command="{TemplateBinding ContinueButtonCommand}"
                                     ContentTemplate="{TemplateBinding ContinueButtonTemplate}"
                                     Content="{TemplateBinding ContinueButton}"
                                     VerticalAlignment="{TemplateBinding VerticalFooterAlignment}" />
                        </Grid>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Padding" Value="{MThickness S6}" />
        <Setter Property="VerticalFooterAlignment" Value="Center" />
        <Setter Property="CancelButton" Value="{Lang {x:Static langs:InnerLangKey.Dialog_Cancel}}" />
        <Setter Property="ContinueButton" Value="{Lang {x:Static langs:InnerLangKey.Dialog_Continue}}" />
        <Setter Property="CancelButtonVariant" Value="Outline" />
        <Setter Property="ContinueButtonVariant" Value="Default" />
        <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{MSize S3_5}" />
        </Style>
        <Style Selector="^ /template/ Grid#Footer MButton">
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
