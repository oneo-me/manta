<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <!-- Text -->
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <LightText Mt.TextSize="ExtraSmall" Text="LightText" />
            <LightText Mt.TextSize="Small" Text="LightText" />
            <LightText Mt.TextSize="Normal" Text="LightText" />
            <LightText Mt.TextSize="Large" Text="LightText" />
            <LightText Mt.TextSize="ExtraLarge" Text="LightText" />
            <LightText Mt.TextSize="ExtraLarge2" Text="LightText" />
            <LightText Mt.TextSize="ExtraLarge3" Text="LightText" />
            <LightText Mt.TextSize="ExtraLarge4" Text="LightText" />
            <LightText Mt.TextSize="ExtraLarge5" Text="LightText" />
            <LightText Mt.TextSize="ExtraLarge6" Text="LightText" />
            <LightText Mt.TextSize="ExtraLarge7" Text="LightText" />
            <LightText Mt.TextSize="ExtraLarge8" Text="LightText" />
            <LightText Mt.TextSize="ExtraLarge9" Text="LightText" />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type LightText}" TargetType="LightText">
        <Style Selector="^[(Mt.TextSize)=ExtraSmall]">
            <Setter Property="FontSize" Value="8" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=Small]">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=Normal]">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=Large]">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge]">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge2]">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge3]">
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge4]">
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge5]">
            <Setter Property="FontSize" Value="30" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge6]">
            <Setter Property="FontSize" Value="36" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge7]">
            <Setter Property="FontSize" Value="48" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge8]">
            <Setter Property="FontSize" Value="60" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge9]">
            <Setter Property="FontSize" Value="72" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Primary]">
            <Setter Property="Foreground" Value="{MtBrush Primary}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Success]">
            <Setter Property="Foreground" Value="{MtBrush Success}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Warning]">
            <Setter Property="Foreground" Value="{MtBrush Warning}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Danger]">
            <Setter Property="Foreground" Value="{MtBrush Danger}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
