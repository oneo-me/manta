<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type MWindow}" TargetType="MWindow">
        <Setter Property="Title" Value="Manta" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="Foreground" Value="{MBrush Foreground}" />
        <Setter Property="BorderBrush" Value="#33000000" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Margin="{ TemplateBinding OffScreenMargin}">
                    <Border Name="Background"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Border Name="Clip">
                            <Panel>
                                <VisualLayerManager>
                                    <Grid Name="PART_WindowContent">
                                        <Border Name="PrimaryColor" />
                                        <ContentPresenter Name="PART_ContentPresenter"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Content="{TemplateBinding Content}" />
                                    </Grid>
                                </VisualLayerManager>
                                <Panel Name="PART_Decorations" />
                            </Panel>
                        </Border>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[(CurrentSystem.IsMacOS)=True]">
            <!-- Taken over by native code -->
            <!-- <Setter Property="TransparencyLevelHint" Value="AcrylicBlur,Blur,Mica,None" /> -->
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />
            <Setter Property="ExtendClientAreaChromeHints" Value="PreferSystemChrome,OSXThickTitleBar" />
            <Setter Property="Background" Value="{MBrush Background, Opacity=0.6}" />
            <Style Selector="^ /template/ Border#PrimaryColor">
                <Setter Property="Background" Value="{MBrush Primary, Opacity=0.05}" />
            </Style>
            <Style Selector="^[Variant=TrayWindow]">
                <Setter Property="Background" Value="{MBrush Background, Opacity=0}" />
                <Style Selector="^ /template/ Border#PrimaryColor">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </Style>
            <Style Selector="^[Variant=DialogWindow]">
                <Setter Property="Background" Value="{MBrush Background, Opacity=0}" />
                <Style Selector="^ /template/ Border#PrimaryColor">
                    <Setter Property="IsVisible" Value="False" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^[(CurrentSystem.IsWindows)=True]">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TransparencyLevelHint" Value="AcrylicBlur,Blur,Mica,None" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="3" />
            <Setter Property="ExtendClientAreaChromeHints" Value="SystemChrome" />
            <Setter Property="Background" Value="{MBrush Background, Opacity=0.6}" />
            <Style Selector="^ /template/ Border#PrimaryColor">
                <Setter Property="Background" Value="{MBrush Primary, Opacity=0.05}" />
            </Style>
            <Style Selector="^[WindowState=Maximized]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^[WindowState=FullScreen]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Style>
        <Style Selector="^[(CurrentSystem.IsLinux)=True]">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TransparencyLevelHint" Value="None" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />
            <Setter Property="ExtendClientAreaChromeHints" Value="NoChrome" />
            <Setter Property="SystemDecorations" Value="None" />
            <Setter Property="Background" Value="{MBrush Background}" />
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="BoxShadow" Value="{MShadow XL, BrushOpacity=0.1}" />
                <Setter Property="Margin" Value="{MShadow XL, ValueType=Margin}" />
                <Setter Property="CornerRadius" Value="{MRadius MD}" />
            </Style>
            <Style Selector="^ /template/ Border#Clip">
                <Setter Property="CornerRadius" Value="{MRadius MD, OffsetNegative=Px}" />
                <Setter Property="ClipToBounds" Value="True" />
            </Style>
            <Style Selector="^ /template/ Border#PrimaryColor">
                <Setter Property="Background" Value="{MBrush Primary, Opacity=0.05}" />
            </Style>
            <Style Selector="^[WindowState=Maximized]">
                <Setter Property="BorderThickness" Value="0" />
                <Style Selector="^ /template/ Border#Background">
                    <Setter Property="BoxShadow" Value="{MShadow None}" />
                    <Setter Property="Margin" Value="{MThickness S0}" />
                    <Setter Property="CornerRadius" Value="{MRadius None}" />
                </Style>
                <Style Selector="^ /template/ Border#Clip">
                    <Setter Property="CornerRadius" Value="{MRadius None}" />
                    <Setter Property="ClipToBounds" Value="False" />
                </Style>
            </Style>
            <Style Selector="^[WindowState=FullScreen]">
                <Setter Property="BorderThickness" Value="0" />
                <Style Selector="^ /template/ Border#Background">
                    <Setter Property="BoxShadow" Value="{MShadow None}" />
                    <Setter Property="Margin" Value="{MThickness S0}" />
                    <Setter Property="CornerRadius" Value="{MRadius None}" />
                </Style>
                <Style Selector="^ /template/ Border#Clip">
                    <Setter Property="CornerRadius" Value="{MRadius None}" />
                    <Setter Property="ClipToBounds" Value="False" />
                </Style>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
