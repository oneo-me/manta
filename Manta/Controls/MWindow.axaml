<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="MacBackground" Color="#00000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="MacBackground" Color="#00000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="MacBackground" Color="#666666" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <ControlTheme x:Key="{x:Type MWindow}" TargetType="MWindow">
        <Setter Property="Title" Value="Manta" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="Foreground" Value="{MBrush Foreground}" />
        <Setter Property="Background" Value="{MBrush Background}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="Root">
                    <Border Name="Background" Background="{TemplateBinding Background}" />
                    <Panel Margin="{ TemplateBinding OffScreenMargin}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Name="PART_WindowContent" Background="{MBrush Primary, Opacity=0.035}">
                                <VisualLayerManager>
                                    <ContentPresenter Name="PART_ContentPresenter"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Content="{TemplateBinding Content}" />
                                </VisualLayerManager>
                            </Grid>
                        </Border>
                        <Panel x:Name="PART_Decorations" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <!-- Windows -->
        <Style Selector="^[(CurrentSystem.IsWindows)=True]">
            <Setter Property="BorderThickness" Value="1" />
            <Style Selector="^[WindowState=Maximized]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^[WindowState=FullScreen]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Setter Property="TransparencyLevelHint" Value="AcrylicBlur,Blur,Mica,None" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="3" />
            <Setter Property="ExtendClientAreaChromeHints" Value="SystemChrome" />
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="Opacity" Value="0.9" />
            </Style>
        </Style>
        <!-- macOS -->
        <Style Selector="^[(CurrentSystem.IsMacOS)=True]">
            <Setter Property="TransparencyLevelHint" Value="AcrylicBlur,Blur,Mica,None" />
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaTitleBarHeightHint" Value="0" />
            <Setter Property="ExtendClientAreaChromeHints" Value="PreferSystemChrome,OSXThickTitleBar" />
            <Style Selector="^ /template/ Border#Background">
                <Setter Property="Opacity" Value="0.9" />
            </Style>
            <Style Selector="^[IsActive=False] /template/ Panel#Root">
                <Setter Property="Background" Value="{DynamicResource MacBackground}" />
            </Style>
        </Style>
        <!-- Linux -->
        <Style Selector="^[(CurrentSystem.IsLinux)=True]">
            <Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
            <Setter Property="ExtendClientAreaChromeHints" Value="NoChrome" />
            <Setter Property="SystemDecorations" Value="None" />
            <Setter Property="BorderThickness" Value="1" />
            <Style Selector="^[WindowState=Maximized]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^[WindowState=FullScreen]">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^ /template/ Panel#PART_Decorations">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^[CanResize=True][WindowState=Normal] /template/ Panel#PART_Decorations">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
