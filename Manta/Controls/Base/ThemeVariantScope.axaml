<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Horizontal" Spacing="12" Margin="12">
            <ThemeVariantScope Width="100" RequestedThemeVariant="Light">
                <Panel Background="{MBrush Background}">
                    <TextBlock Text="Text" Margin="33 11" />
                </Panel>
            </ThemeVariantScope>
            <ThemeVariantScope Width="100" RequestedThemeVariant="Dark">
                <Panel Background="{MBrush Background}">
                    <TextBlock Text="Text" Margin="33 11" />
                </Panel>
            </ThemeVariantScope>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type ThemeVariantScope}" TargetType="ThemeVariantScope">
        <Setter Property="TextElement.Foreground" Value="{MBrush Foreground}" />
    </ControlTheme>
</ResourceDictionary>
