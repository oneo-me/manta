<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <Menu />
            <MenuItem />
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
        <Setter Property="Template">
            <ControlTemplate>
                <SelectableTextBlock Foreground="{MBrush Destructive}" Text="The control 'Menu' is not supported" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
        <Setter Property="Template">
            <ControlTemplate>
                <SelectableTextBlock Foreground="{MBrush Destructive}" Text="The control 'MenuItem' is not supported" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
