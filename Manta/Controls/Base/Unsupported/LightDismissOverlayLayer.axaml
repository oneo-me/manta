<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <LightDismissOverlayLayer />
        </MtPanel>
    </Design.PreviewWith>
    <!-- The control 'LightDismissOverlayLayer' is not supported -->
    <ControlTheme x:Key="{x:Type LightDismissOverlayLayer}" TargetType="LightDismissOverlayLayer">
        <Setter Property="Mt.ColorScheme" Value="Danger" />
    </ControlTheme>
</ResourceDictionary>
