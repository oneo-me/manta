<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <TreeView />
            <TreeViewItem />
        </MtPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TreeView}" TargetType="TreeView">
        <Setter Property="Template">
            <ControlTemplate>
                <MtSelectableText Mt.ColorScheme="Danger" Text="The control 'TreeView' is not supported" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
        <Setter Property="Template">
            <ControlTemplate>
                <MtSelectableText Mt.ColorScheme="Danger" Text="The control 'TreeViewItem' is not supported" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
