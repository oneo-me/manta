<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <ExperimentalAcrylicBorder />
        </LightPanel>
    </Design.PreviewWith>
    <!-- The control 'ExperimentalAcrylicBorder' is not supported -->
    <ControlTheme x:Key="{x:Type ExperimentalAcrylicBorder}" TargetType="ExperimentalAcrylicBorder">
        <Setter Property="Mt.ColorScheme" Value="Danger" />
    </ControlTheme>
</ResourceDictionary>
