<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <NumericUpDown />
        </MtPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <MtSelectableText Mt.ColorScheme="Danger" Text="The control 'NumericUpDown' is not supported" />
                    <TextBox Name="PART_TextBox" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
