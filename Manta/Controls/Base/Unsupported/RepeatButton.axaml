<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <RepeatButton />
        </MtPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <MtSelectableText Mt.ColorScheme="Danger" Text="The control 'RepeatButton' is not supported" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
