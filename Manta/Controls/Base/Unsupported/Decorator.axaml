<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <Decorator />
        </MPanel>
    </Design.PreviewWith>
    <!-- The control 'Decorator' is not supported -->
    <ControlTheme x:Key="{x:Type Decorator}" TargetType="Decorator">
        <Setter Property="M.ColorScheme" Value="Danger" />
    </ControlTheme>
</ResourceDictionary>
