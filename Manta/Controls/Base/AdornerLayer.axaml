<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
        <Setter Property="DefaultFocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderThickness="{MThickness Px}"
                        BorderBrush="{MBrush Primary, Type=Light2}"
                        Background="{MBrush Primary, Type=Light2, Opacity=0.05}"
                        IsHitTestVisible="False" />
            </FocusAdornerTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
