<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <AdornerLayer />
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type AdornerLayer}" TargetType="AdornerLayer">
        <Setter Property="DefaultFocusAdorner">
            <FocusAdornerTemplate>
                <Border BorderThickness="{MThickness Px}"
                        CornerRadius="{MRadius MD}"
                        BorderBrush="{MBrush Focus}"
                        Background="{MBrush Focus, Opacity=0.05}"
                        IsHitTestVisible="False" />
            </FocusAdornerTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
