<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <CaptionButtons />
            <TitleBar />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type CaptionButtons}" TargetType="CaptionButtons">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Mt.ColorScheme="Danger" Text="Please use the 'LightTitleBarButtons'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TitleBar}" TargetType="TitleBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <LightSelectableText Mt.ColorScheme="Danger" Text="Please use the 'LightTitleBar'" />
                    <CaptionButtons Name="PART_CaptionButtons" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
