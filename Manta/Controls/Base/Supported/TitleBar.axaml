<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <CaptionButtons />
            <TitleBar />
        </MtPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type CaptionButtons}" TargetType="CaptionButtons">
        <Setter Property="Template">
            <ControlTemplate>
                <MtSelectableText Mt.ColorScheme="Danger" Text="Please use the 'MtTitleBarButtons'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TitleBar}" TargetType="TitleBar">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <MtSelectableText Mt.ColorScheme="Danger" Text="Please use the 'MtTitleBar'" />
                    <CaptionButtons Name="PART_CaptionButtons" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
