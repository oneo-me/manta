<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock />
        </MtPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TextBlock}" TargetType="TextBlock">
        <Setter Property="Mt.ColorScheme" Value="Danger" />
        <Setter Property="Text" Value="Please use the 'MtText'" />
    </ControlTheme>
</ResourceDictionary>
