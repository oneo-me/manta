<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <TabControl />
            <TabItem />
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Template">
            <ControlTemplate>
                <SelectableTextBlock Foreground="{MBrush Warning}" Text="Please use the 'MTabControl' control instead" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="Template">
            <ControlTemplate>
                <SelectableTextBlock Foreground="{MBrush Warning}" Text="Please use the 'MTabItem' control instead" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
