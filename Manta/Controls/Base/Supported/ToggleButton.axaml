<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <ToggleButton />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Mt.ColorScheme="Danger" Text="Please use the 'LightToggleButton'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
