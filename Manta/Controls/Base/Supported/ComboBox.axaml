<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <ComboBox />
            <ComboBoxItem />
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <MSelectableText M.ColorScheme="Danger" Text="Please use the 'MComboBox'" />
                    <Popup Name="PART_Popup" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
        <Setter Property="Template">
            <ControlTemplate>
                <MSelectableText M.ColorScheme="Danger" Text="Please use the 'MComboBoxItem'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
