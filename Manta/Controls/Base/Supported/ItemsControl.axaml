<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <ItemsControl />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type ItemsControl}" TargetType="ItemsControl">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Mt.ColorScheme="Danger" Text="Please use the 'LightItems'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
