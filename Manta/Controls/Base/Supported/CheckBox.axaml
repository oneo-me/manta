<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <CheckBox />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Template">
            <ControlTemplate>
                <LightSelectableText Theme.ColorScheme="Danger" Text="Please use the 'LightCheckBox'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
