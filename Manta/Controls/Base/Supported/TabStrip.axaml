<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <TabStrip />
            <TabStripItem />
        </MtPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">
        <Setter Property="Template">
            <ControlTemplate>
                <MtSelectableText Mt.ColorScheme="Danger" Text="Please use the 'MtTabStrip'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type TabStripItem}" TargetType="TabStripItem">
        <Setter Property="Template">
            <ControlTemplate>
                <MtSelectableText Mt.ColorScheme="Danger" Text="Please use the 'MtTabStripItem'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
