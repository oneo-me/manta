<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <TextBox />
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TextBox}" TargetType="TextBox">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <SelectableTextBlock Foreground="{MBrush Destructive}" Text="Please use the 'MTextBox'" />
                    <TextPresenter Name="PART_TextPresenter" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
