<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <Label />
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type Label}" TargetType="Label">
        <Setter Property="Template">
            <ControlTemplate>
                <MSelectableText M.ColorScheme="Danger" Text="Please use the 'MLabel'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
