<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <ScrollViewer />
            <ScrollBar />
        </MtPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
        <Setter Property="Template">
            <ControlTemplate>
                <MtSelectableText Mt.ColorScheme="Danger" Text="Please use the 'MtScrollViewer'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Template">
            <ControlTemplate>
                <MtSelectableText Mt.ColorScheme="Danger" Text="Please use the 'MtScrollBar'" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
