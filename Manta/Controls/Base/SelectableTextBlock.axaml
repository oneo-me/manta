<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type SelectableTextBlock}" TargetType="SelectableTextBlock">
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="SelectionBrush" Value="{MBrush Primary, Opacity=0.3}" />
        <Setter Property="SelectionForegroundBrush" Value="{MBrush Foreground}" />
    </ControlTheme>
</ResourceDictionary>
