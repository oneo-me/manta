<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <Panel Background="{MtBrush Background}">
            <MtPanel Mode="Horizontal" Spacing="12" Margin="12">
                <Border BorderThickness="1">
                    <MtPixelGrid Width="100" Height="100" />
                </Border>
                <Border BorderThickness="1">
                    <MtPixelGrid Width="100" Height="100" Foreground="Red" />
                </Border>
                <Border BorderThickness="1">
                    <MtPixelGrid Width="100" Height="100" Foreground="Blue" Opacity="0.5" />
                </Border>
            </MtPanel>
        </Panel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MtPixelGrid}" TargetType="MtPixelGrid">
        <Setter Property="Background" Value="{MtBrush Background}" />
        <Setter Property="Opacity" Value="0.1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Panel.Background>
                        <VisualBrush TileMode="Tile" DestinationRect="0 0 20 20">
                            <VisualBrush.Visual>
                                <Grid ColumnDefinitions="10 10" RowDefinitions="10 10">
                                    <Border Grid.Column="0" Grid.Row="0" Background="{Binding ElementName=Black, Path=BorderBrush}" />
                                    <Border Grid.Column="1" Grid.Row="0" Background="{Binding ElementName=White, Path=BorderBrush}" />
                                    <Border Grid.Column="0" Grid.Row="1" Background="{Binding ElementName=White, Path=BorderBrush}" />
                                    <Border Grid.Column="1" Grid.Row="1" Background="{Binding ElementName=Black, Path=BorderBrush}" />
                                </Grid>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Panel.Background>
                    <Border Name="Black" BorderBrush="{TemplateBinding Background}" />
                    <Border Name="White" BorderBrush="{TemplateBinding Foreground}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
