<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type MIcon}" TargetType="MIcon">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Viewbox Name="PART_ViewBox" ClipToBounds="False" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Variant=Default]">
            <Setter Property="Background" Value="{MBrush Primary, Type=Light2, Opacity=0.3}" />
        </Style>
        <Style Selector="^[Variant=Secondary]">
            <Setter Property="Background" Value="{MBrush Foreground, Type=Light2, Opacity=0.3}" />
        </Style>
        <Style Selector="^[Variant=Destructive]">
            <Setter Property="Background" Value="{MBrush Destructive, Type=Light2, Opacity=0.3}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
