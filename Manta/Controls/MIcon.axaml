<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type MIcon}" TargetType="MIcon">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Viewbox Name="PART_ViewBox" ClipToBounds="False" />
            </ControlTemplate>
        </Setter>
        <Setter Property="Opacity" Value="{OnTheme {Double 1}, Dark={Double 0.8}}" />
        <Style Selector="^[Variant=Default]">
            <Setter Property="Background" Value="{OnTheme {MBrush Primary, Type=Light2, Opacity=0.3}, Dark={MBrush Primary, Type=Light2, Opacity=0.45}}" />
        </Style>
        <Style Selector="^[Variant=Secondary]">
            <Setter Property="Background" Value="{OnTheme {MBrush Foreground, Type=Light2, Opacity=0.3}, Dark={MBrush Foreground, Type=Light2, Opacity=0.45}}" />
        </Style>
        <Style Selector="^[Variant=Destructive]">
            <Setter Property="Background" Value="{OnTheme {MBrush Destructive, Type=Light2, Opacity=0.3}, Dark={MBrush Destructive, Type=Light2, Opacity=0.45}}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
