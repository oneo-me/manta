<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <!-- Window -->
        <MtPanel Mode="Vertical" Width="320" Spacing="12" Margin="12">
            <MtPanel.Styles>
                <Style Selector="Border.Box">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Background" Value="{MtBrush Background}" />
                </Style>
                <Style Selector="MtPanel.MacOS">
                    <Setter Property="IsVisible" Value="False" />
                    <Style Selector="^[Tag=False][(CurrentSystem.IsMacOS)=True]">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                </Style>
            </MtPanel.Styles>
            <Border Classes="Box">
                <Panel>
                    <MtPanel Classes="MacOS" Mode="Horizontal" VerticalAlignment="Center"
                                Spacing="8" Margin="12 0"
                                Tag="{x:Static Design.IsDesignMode}">
                        <Ellipse Width="12" Height="12" Fill="#ED6A5E" />
                        <Ellipse Width="12" Height="12" Fill="#F4BF4F" />
                        <Ellipse Width="12" Height="12" Fill="#61C554" />
                    </MtPanel>
                    <MtTitleBar />
                </Panel>
            </Border>
            <Border Classes="Box">
                <Panel>
                    <MtPanel Classes="MacOS" Mode="Horizontal" VerticalAlignment="Center"
                                Spacing="8" Margin="12 0"
                                Tag="{x:Static Design.IsDesignMode}">
                        <Ellipse Width="12" Height="12" Fill="#ED6A5E" />
                        <Ellipse Width="12" Height="12" Fill="#F4BF4F" />
                        <Ellipse Width="12" Height="12" Fill="#61C554" />
                    </MtPanel>
                    <MtTitleBar>
                        <MtTabStrip Type="RootTab">
                            <MtTabStripItem Content="TabItem 1" />
                            <MtTabStripItem Content="TabItem 2" />
                            <MtTabStripItem Content="TabItem 3" />
                        </MtTabStrip>
                    </MtTitleBar>
                </Panel>
            </Border>
            <Border Classes="Box">
                <Panel>
                    <MtPanel Classes="MacOS" Mode="Horizontal" VerticalAlignment="Center"
                                Spacing="8" Margin="12 0"
                                Tag="{x:Static Design.IsDesignMode}">
                        <Ellipse Width="12" Height="12" Fill="#ED6A5E" />
                        <Ellipse Width="12" Height="12" Fill="#F4BF4F" />
                        <Ellipse Width="12" Height="12" Fill="#61C554" />
                    </MtPanel>
                    <MtTitleBar>
                        <Grid ColumnDefinitions="* Auto" ColumnSpacing="12">
                            <MtScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                               BorderThickness="1 0" Padding="-1 0">
                                <MtTabStrip Type="RootTab">
                                    <MtTabStripItem Content="TabItem 1" />
                                    <MtTabStripItem Content="TabItem 2" />
                                    <MtTabStripItem Content="TabItem 3" />
                                    <MtTabStripItem Content="TabItem 4" />
                                    <MtTabStripItem Content="TabItem 5" />
                                    <MtTabStripItem Content="TabItem 6" />
                                </MtTabStrip>
                            </MtScrollViewer>
                            <MtPanel Grid.Column="1" Mode="Horizontal">
                                <MtTitleBarButton Content="Button" />
                            </MtPanel>
                        </Grid>
                    </MtTitleBar>
                </Panel>
            </Border>
            <Border Classes="Box">
                <MtTitleBarButtons HorizontalAlignment="Right" />
            </Border>
            <Border Classes="Box">
                <MtPanel Mode="Horizontal" HorizontalAlignment="Right">
                    <MtTitleBarButton Content="Button" />
                </MtPanel>
            </Border>
            <Border Classes="Box">
                <MtPanel Mode="Horizontal" HorizontalAlignment="Right">
                    <MtTitleBarButton Content="Button" />
                    <MtTitleBarButton Type="ExitFullScreen" />
                    <MtTitleBarButton Type="FullScreen" />
                    <MtTitleBarButton Type="Minimize" />
                    <MtTitleBarButton Type="Restore" />
                    <MtTitleBarButton Type="Maximize" />
                    <MtTitleBarButton Type="Close" />
                </MtPanel>
            </Border>
        </MtPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MtTitleBar}" TargetType="MtTitleBar">
        <Setter Property="Height" Value="38" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Event" Background="#00000000">
                    <Grid ColumnDefinitions="* Auto">
                        <Panel Name="PART_Content" Grid.Column="0">
                            <MtText Name="PART_Title"
                                       IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Panel>
                        <MtTitleBarButtons Name="PART_Buttons" Grid.Column="1" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ MtText#PART_Title">
            <Setter Property="Padding" Value="12 0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type MtTitleBarButtons}" TargetType="MtTitleBarButtons">
        <Setter Property="Template">
            <ControlTemplate>
                <MtPanel Mode="Horizontal">
                    <MtTitleBarButton Name="PART_FullScreenButton" Type="FullScreen" />
                    <MtTitleBarButton Name="PART_MinimizeButton" Type="Minimize" />
                    <MtTitleBarButton Name="PART_MaximizeRestoreButton" Type="Maximize" />
                    <MtTitleBarButton Name="PART_CloseButton" Type="Close" />
                </MtPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type MtTitleBarButton}" TargetType="MtTitleBarButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Border" Background="#00000000">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <MtPanel Name="Panel" Mode="Horizontal"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <MtPathIcon Name="Icon" Data="{TemplateBinding IconData}"
                                           IsVisible="{TemplateBinding IconData, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True" />
                        </MtPanel>
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Border">
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0 4 4 4" />
        </Style>
        <Style Selector="^ /template/ MtPanel#Panel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^ /template/ MtPathIcon#Icon">
            <Setter Property="Size" Value="10" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter:empty">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Setter Property="Transitions">
            <Transitions>
                <SmoothBrushTransition Property="Foreground" Duration="0:0:0.1" />
                <SmoothBrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <Setter Property="Background" Value="{MtBrush Foreground, Opacity=0}" />
        <Setter Property="Foreground" Value="{MtBrush Foreground}" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{MtBrush Foreground, Opacity=0.1}" />
        </Style>
        <Style Selector="^[Type=None]">
            <Setter Property="Padding" Value="10 0" />
        </Style>
        <Style Selector="^[Type=ExitFullScreen]">
            <Setter Property="IconData" Value="M205 1024h819v-819h-205v469l-674 -674l-145 145l674 674h-469v205zM1374 1229h469v-205h-819v819h205v-469l674 674l145 -145z" />
        </Style>
        <Style Selector="^[Type=FullScreen]">
            <Setter Property="IconData" Value="M2048 2048v-819h-205v469l-1493 -1493h469v-205h-819v819h205v-469l1493 1493h-469v205h819z" />
        </Style>
        <Style Selector="^[Type=Minimize]">
            <Setter Property="IconData" Value="M2048 1229v-205h-2048v205h2048z" />
        </Style>
        <Style Selector="^[Type=Restore]">
            <Setter Property="IconData" Value="M2048 410h-410v-410h-1638v1638h410v410h1638v-1638zM1434 1434h-1229v-1229h1229v1229zM1843 1843h-1229v-205h1024v-1024h205v1229z" />
        </Style>
        <Style Selector="^[Type=Maximize]">
            <Setter Property="IconData" Value="M2048 2048v-2048h-2048v2048h2048zM1843 1843h-1638v-1638h1638v1638z" />
        </Style>
        <Style Selector="^[Type=Close]">
            <Setter Property="IconData" Value="M1169 1024l879 -879l-145 -145l-879 879l-879 -879l-145 145l879 879l-879 879l145 145l879 -879l879 879l145 -145z" />
            <Setter Property="Background" Value="{MtBrush Danger, Opacity=0}" />
            <Setter Property="Foreground" Value="{MtBrush Foreground}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{MtBrush Danger}" />
                <Setter Property="Foreground" Value="{MtBrush ColorForeground}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
