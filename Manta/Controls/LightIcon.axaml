<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type LightIcon}" TargetType="LightIcon">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Viewbox Name="PART_ViewBox" ClipToBounds="False" />
            </ControlTemplate>
        </Setter>
        <Setter Property="Foreground" Value="{MtBrush Foreground, Opacity=0.6}" />
        <Style Selector="^[(Mt.ColorScheme)=Normal]">
            <Setter Property="Background" Value="{MtBrush Foreground, Opacity=0.2}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Primary]">
            <Setter Property="Background" Value="{MtBrush Primary, Opacity=0.2}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Success]">
            <Setter Property="Background" Value="{MtBrush Success, Opacity=0.2}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Warning]">
            <Setter Property="Background" Value="{MtBrush Warning, Opacity=0.2}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Danger]">
            <Setter Property="Background" Value="{MtBrush Danger, Opacity=0.2}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
