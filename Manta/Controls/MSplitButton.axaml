<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Wrap" Spacing="12" Margin="12">
            <MSplitButton Content="Default" HorizontalAlignment="Left">
                <MSplitButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Copy" />
                        <MenuItem Header="Paste" />
                        <MenuItem Header="-" />
                        <MenuItem Header="Delete" />
                    </MenuFlyout>
                </MSplitButton.Flyout>
            </MSplitButton>
            <MSplitButton Variant="Outline" Content="Outline" HorizontalAlignment="Left">
                <MSplitButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Option 1" />
                        <MenuItem Header="Option 2" />
                    </MenuFlyout>
                </MSplitButton.Flyout>
            </MSplitButton>
            <MSplitButton Variant="Secondary" Content="Secondary" HorizontalAlignment="Left">
                <MSplitButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Option 1" />
                        <MenuItem Header="Option 2" />
                    </MenuFlyout>
                </MSplitButton.Flyout>
            </MSplitButton>
            <MSplitButton Variant="Ghost" Content="Ghost" HorizontalAlignment="Left">
                <MSplitButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Option 1" />
                        <MenuItem Header="Option 2" />
                    </MenuFlyout>
                </MSplitButton.Flyout>
            </MSplitButton>
            <MSplitButton Variant="Destructive" Content="Destructive" HorizontalAlignment="Left">
                <MSplitButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Option 1" />
                        <MenuItem Header="Option 2" />
                    </MenuFlyout>
                </MSplitButton.Flyout>
            </MSplitButton>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MSplitButton}" TargetType="MSplitButton">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="* Auto">
                    <MButton Grid.Column="0" Name="PART_PrimaryButton"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                             Command="{TemplateBinding Command}"
                             CommandParameter="{TemplateBinding CommandParameter}"
                             Content="{TemplateBinding Content}"
                             ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <Border Grid.Column="0" Name="Line">
                        <Border />
                    </Border>
                    <MDropDownButton Grid.Column="1" Name="PART_SecondaryButton">
                        <MPathIcon Name="DropDownIcon" />
                    </MDropDownButton>
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#Line">
            <Setter Property="ZIndex" Value="2" />
            <Setter Property="Width" Value="{MSize Px}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="{MThickness S2, Filter=Top|Bottom}" />
        </Style>
        <Style Selector="^ /template/ MPathIcon#DropDownIcon">
            <Setter Property="Data" Value="M6 9L12 15L18 9" />
            <Setter Property="UseStroke" Value="True" />
            <Setter Property="Size" Value="{MSize S2}" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:flyout-open /template/ MPathIcon#DropDownIcon">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^ /template/ MButton">
            <Setter Property="CornerRadius" Value="{MRadius MD, Filter=Left}" />
        </Style>
        <Style Selector="^ /template/ MDropDownButton">
            <Setter Property="CornerRadius" Value="{MRadius MD, Filter=Right}" />
            <Setter Property="Padding" Value="{MThickness S3, Vertical=S2_5}" />
        </Style>
        <Style Selector="^ /template/ MButton:pointerover">
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="^ /template/ MDropDownButton:pointerover">
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <Style Selector="^[Variant=Default]">
            <Style Selector="^ /template/ MButton">
                <Setter Property="Variant" Value="Default" />
            </Style>
            <Style Selector="^ /template/ MDropDownButton">
                <Setter Property="Variant" Value="Default" />
            </Style>
            <Style Selector="^ /template/ Border#Line">
                <Setter Property="Background" Value="{MBrush PrimaryForeground, Opacity=0.3}" />
            </Style>
        </Style>
        <Style Selector="^[Variant=Secondary]">
            <Style Selector="^ /template/ MButton">
                <Setter Property="Variant" Value="Secondary" />
            </Style>
            <Style Selector="^ /template/ MDropDownButton">
                <Setter Property="Variant" Value="Secondary" />
            </Style>
            <Style Selector="^ /template/ Border#Line">
                <Setter Property="Background" Value="{MBrush SecondaryForeground, Opacity=0.1}" />
            </Style>
        </Style>
        <Style Selector="^[Variant=Destructive]">
            <Style Selector="^ /template/ MButton">
                <Setter Property="Variant" Value="Destructive" />
            </Style>
            <Style Selector="^ /template/ MDropDownButton">
                <Setter Property="Variant" Value="Destructive" />
            </Style>
            <Style Selector="^ /template/ Border#Line">
                <Setter Property="Background" Value="{MBrush DestructiveForeground, Opacity=0.3}" />
            </Style>
        </Style>
        <Style Selector="^[Variant=Outline]">
            <Style Selector="^ /template/ MButton">
                <Setter Property="Variant" Value="Outline" />
            </Style>
            <Style Selector="^ /template/ MDropDownButton">
                <Setter Property="Padding" Value="{MThickness S3, Vertical=S2_5}" />
                <Setter Property="Variant" Value="Outline" />
            </Style>
            <!-- TODO setting BorderThickness causes inability to render BoxShadow, temporarily resolved this way -->
            <Style Selector="^ /template/ Border#Line">
                <Setter Property="Width" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Background" Value="{MBrush Background}" />
                <Setter Property="Margin" Value="0 1 -1 1" />
                <Style Selector="^ > Border">
                    <Setter Property="Width" Value="{MSize Px}" />
                    <Setter Property="Background" Value="{MBrush Foreground, Opacity=0.1}" />
                    <Setter Property="Margin" Value="{MThickness S2, Filter=Top|Bottom}" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^[Variant=Ghost]">
            <Style Selector="^ /template/ MButton">
                <Setter Property="Variant" Value="Ghost" />
            </Style>
            <Style Selector="^ /template/ MDropDownButton">
                <Setter Property="Variant" Value="Ghost" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
