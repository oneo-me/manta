<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <!-- Default variant -->
            <MPanel Mode="Horizontal" Spacing="12">
                <MButtonSpinner Variant="Default" Size="Small" Content="Small" />
                <MButtonSpinner Variant="Default" Size="Default" Content="Default" />
                <MButtonSpinner Variant="Default" Size="Large" Content="Large" />
            </MPanel>
            <!-- Outline variant -->
            <MPanel Mode="Horizontal" Spacing="12">
                <MButtonSpinner Variant="Outline" Size="Small" Content="Small" />
                <MButtonSpinner Variant="Outline" Size="Default" Content="Default" />
                <MButtonSpinner Variant="Outline" Size="Large" Content="Large" />
            </MPanel>
            <!-- With TextBox content -->
            <MPanel Mode="Horizontal" Spacing="12">
                <MButtonSpinner Variant="Outline" Content="100" />
            </MPanel>
            <!-- ButtonSpinnerLocation -->
            <MPanel Mode="Horizontal" Spacing="12">
                <MButtonSpinner Variant="Outline" ButtonSpinnerLocation="Left" Content="Left" />
                <MButtonSpinner Variant="Outline" ButtonSpinnerLocation="Right" Content="Right" />
            </MPanel>
            <!-- AllowSpin and ShowButtonSpinner -->
            <MPanel Mode="Horizontal" Spacing="12">
                <MButtonSpinner Variant="Outline" AllowSpin="False" Content="AllowSpin=False" />
                <MButtonSpinner Variant="Outline" ShowButtonSpinner="False" Content="ShowButtonSpinner=False" />
            </MPanel>
            <!-- Disabled -->
            <MPanel Mode="Horizontal" Spacing="12">
                <MButtonSpinner Variant="Default" IsEnabled="False" Content="Disabled" />
                <MButtonSpinner Variant="Outline" IsEnabled="False" Content="Disabled" />
            </MPanel>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MButtonSpinner}" TargetType="MButtonSpinner">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Left spinner buttons -->
                        <MPanel Name="PART_LeftSpinnerButtons"
                                Grid.Column="0"
                                Mode="Horizontal"
                                Spacing="0">
                            <MRepeatButton Name="PART_DecreaseButton"
                                           Variant="Ghost"
                                           VerticalAlignment="Stretch"
                                           CornerRadius="0"
                                           Focusable="False">
                                <MPathIcon Data="m15 18-6-6 6-6" UseStroke="True" />
                            </MRepeatButton>
                        </MPanel>
                        <!-- Content -->
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <!-- Right spinner buttons -->
                        <MPanel Name="PART_RightSpinnerButtons"
                                Grid.Column="2"
                                Mode="Horizontal"
                                Spacing="0">
                            <MRepeatButton Name="PART_IncreaseButton"
                                           Variant="Ghost"
                                           VerticalAlignment="Stretch"
                                           CornerRadius="0"
                                           Focusable="False">
                                <MPathIcon Data="m9 18 6-6-6-6" UseStroke="True" />
                            </MRepeatButton>
                        </MPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <SmoothBrushTransition Property="Background" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <!-- Size styles -->
        <Style Selector="^[Size=Small]">
            <Setter Property="Padding" Value="12 6" />
            <Style Selector="^ /template/ MRepeatButton">
                <Setter Property="Padding" Value="6" />
            </Style>
            <Style Selector="^ /template/ MPathIcon">
                <Setter Property="Size" Value="12" />
            </Style>
        </Style>
        <Style Selector="^[Size=Default]">
            <Setter Property="Padding" Value="16 8" />
            <Style Selector="^ /template/ MRepeatButton">
                <Setter Property="Padding" Value="8" />
            </Style>
            <Style Selector="^ /template/ MPathIcon">
                <Setter Property="Size" Value="14" />
            </Style>
        </Style>
        <Style Selector="^[Size=Large]">
            <Setter Property="Padding" Value="20 10" />
            <Style Selector="^ /template/ MRepeatButton">
                <Setter Property="Padding" Value="10" />
            </Style>
            <Style Selector="^ /template/ MPathIcon">
                <Setter Property="Size" Value="16" />
            </Style>
        </Style>
        <!-- Default variant -->
        <Style Selector="^[Variant=Default]">
            <Setter Property="Background" Value="{MBrush Foreground}" />
            <Setter Property="Foreground" Value="{MBrush Background}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{MBrush Foreground, Opacity=0.8}" />
            </Style>
        </Style>
        <!-- Outline variant -->
        <Style Selector="^[Variant=Outline]">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{MBrush BorderBrush}" />
            <Setter Property="Background" Value="{MBrush Background}" />
            <Setter Property="Foreground" Value="{MBrush Foreground}" />
            <Style Selector="^ /template/ Border#PART_Border">
                <Setter Property="BoxShadow" Value="{MShadow MD}" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{MBrush BorderBrush}" />
                <Setter Property="BorderBrush" Value="{MBrush BorderBrush, Opacity=0.6}" />
                <Style Selector="^ /template/ Border#PART_Border">
                    <Setter Property="BoxShadow" Value="{MShadow XS}" />
                </Style>
            </Style>
        </Style>
        <!-- ButtonSpinnerLocation -->
        <Style Selector="^[ButtonSpinnerLocation=Left]">
            <Style Selector="^ /template/ MPanel#PART_LeftSpinnerButtons">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ MPanel#PART_RightSpinnerButtons">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ MRepeatButton#PART_DecreaseButton">
                <Style Selector="^ /template/ MPathIcon">
                    <Setter Property="Data" Value="m15 18-6-6 6-6" />
                </Style>
            </Style>
        </Style>
        <Style Selector="^[ButtonSpinnerLocation=Right]">
            <Style Selector="^ /template/ MPanel#PART_LeftSpinnerButtons">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ MPanel#PART_RightSpinnerButtons">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <!-- ShowButtonSpinner=False -->
        <Style Selector="^:not(:showspinner)">
            <Style Selector="^ /template/ MPanel#PART_LeftSpinnerButtons">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ MPanel#PART_RightSpinnerButtons">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <!-- Disabled state -->
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
