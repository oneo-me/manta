<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MCanvas Design.Width="600" Design.Height="360">
            <Canvas>
                <MCard Canvas.Left="40" Canvas.Top="30" Width="140" Padding="12">
                    <MPanel Mode="Vertical" Spacing="4">
                        <TextBlock Text="Component A" FontWeight="SemiBold" />
                        <TextBlock Text="Drag the background to pan" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    </MPanel>
                </MCard>
                <MCard Canvas.Left="240" Canvas.Top="120" Width="140" Padding="12">
                    <MPanel Mode="Vertical" Spacing="4">
                        <TextBlock Text="Component B" FontWeight="SemiBold" />
                        <TextBlock Text="Scroll wheel to zoom" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    </MPanel>
                </MCard>
                <MCard Canvas.Left="120" Canvas.Top="240" Width="140" Padding="12">
                    <MPanel Mode="Vertical" Spacing="4">
                        <TextBlock Text="Component C" FontWeight="SemiBold" />
                        <TextBlock Text="Cmd+1 to reset view" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    </MPanel>
                </MCard>
                <Border Canvas.Left="430" Canvas.Top="60"
                        Width="100" Height="100"
                        Background="#304488CC" BorderBrush="#FF4488CC"
                        BorderThickness="1" CornerRadius="50" />
                <Border Canvas.Left="400" Canvas.Top="200"
                        Width="160" Height="80"
                        Background="#3044CC88" BorderBrush="#FF44CC88"
                        BorderThickness="1" CornerRadius="8" />
            </Canvas>
        </MCanvas>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MCanvas}" TargetType="MCanvas">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="GridBrush" Value="{MBrush Border, Opacity=0.3}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Grid renders in screen coordinates, outside the transform -->
                    <MCanvasGrid Name="PART_Grid"
                                 GridSize="{TemplateBinding GridSize}"
                                 ShowGrid="{TemplateBinding ShowGrid}"
                                 GridBrush="{TemplateBinding GridBrush}" />
                    <!-- Content is transformed (scale + translate) -->
                    <Panel Name="PART_TransformContainer">
                        <ContentPresenter Name="PART_Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
