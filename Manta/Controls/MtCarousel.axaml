<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <MtText Text="PageSlide" />
            <MtPanel Mode="Vertical" Spacing="12">
                <MtCarousel Name="Carousel1" Width="300" Height="120">
                    <MtCarousel.PageTransition>
                        <PageSlide Duration="0:00:0.3" Orientation="Horizontal" />
                    </MtCarousel.PageTransition>
                    <MtCard>
                        <MtText Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MtCard>
                    <MtCard>
                        <MtText Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MtCard>
                    <MtCard>
                        <MtText Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MtCard>
                </MtCarousel>
                <MtPanel Mode="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <MtButton Variant="Outline" Content="Previous" Command="{Binding ElementName=Carousel1, Path=Previous}" />
                    <MtButton Variant="Outline" Content="Next" Command="{Binding ElementName=Carousel1, Path=Next}" />
                </MtPanel>
            </MtPanel>
            <MtText Text="Rotate3DTransition" />
            <MtPanel Mode="Vertical" Spacing="12">
                <MtCarousel Name="Carousel2" Width="300" Height="120">
                    <MtCarousel.PageTransition>
                        <Rotate3DTransition Duration="0:0:0.3" />
                    </MtCarousel.PageTransition>
                    <MtCard>
                        <MtText Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MtCard>
                    <MtCard>
                        <MtText Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MtCard>
                    <MtCard>
                        <MtText Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </MtCard>
                </MtCarousel>
                <MtPanel Mode="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <MtButton Variant="Outline" Content="Previous" Command="{Binding ElementName=Carousel2, Path=Previous}" />
                    <MtButton Variant="Outline" Content="Next" Command="{Binding ElementName=Carousel2, Path=Next}" />
                </MtPanel>
            </MtPanel>
        </MtPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MtCarousel}" TargetType="MtCarousel">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <MtScrollViewer Name="PART_ScrollViewer"
                                   Background="{TemplateBinding Background}"
                                   BorderBrush="{TemplateBinding BorderBrush}"
                                   BorderThickness="{TemplateBinding BorderThickness}"
                                   BringIntoViewOnFocusChange="False"
                                   HorizontalScrollBarVisibility="Hidden"
                                   VerticalScrollBarVisibility="Hidden"
                                   ClipToBounds="{TemplateBinding ClipToBounds}">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    Margin="{TemplateBinding Padding}" />
                </MtScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
