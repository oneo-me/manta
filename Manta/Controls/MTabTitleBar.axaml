<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <!-- Window -->
        <MPanel Mode="Vertical" Width="360" Spacing="12" Margin="12">
            <MPanel.Styles>
                <Style Selector="Border.Box">
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="Background" Value="{MBrush Background}" />
                    <Style Selector="^ > Border">
                        <Setter Property="CornerRadius" Value="12" />
                        <Setter Property="ClipToBounds" Value="True" />
                    </Style>
                </Style>
                <Style Selector="MPanel.MacOS">
                    <Setter Property="IsVisible" Value="False" />
                    <Style Selector="^[Tag=False][(CurrentSystem.IsMacOS)=True]">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                </Style>
                <Style Selector="MTabTitleBar">
                    <Setter Property="Background" Value="{OnTheme {MBrush Primary, Opacity=0.05}, Dark={MBrush Primary, Opacity=0.08}}" />
                </Style>
            </MPanel.Styles>
            <Border Classes="Box">
                <Border>
                    <Grid RowDefinitions="Auto *" Height="100">
                        <Panel Grid.Row="0">
                            <MPanel Classes="MacOS" Mode="Horizontal" VerticalAlignment="Center"
                                    Spacing="8" Margin="12 0"
                                    Tag="{x:Static Design.IsDesignMode}">
                                <Ellipse Width="12" Height="12" Fill="#ED6A5E" />
                                <Ellipse Width="12" Height="12" Fill="#F4BF4F" />
                                <Ellipse Width="12" Height="12" Fill="#61C554" />
                            </MPanel>
                            <MTabTitleBar Name="TitleBar">
                                <MTabTitleBarItem Content="TabItem 1" IsSelected="True" />
                                <MTabTitleBarItem Content="TabItem 2" />
                                <MTabTitleBarItem Content="TabItem 3" />
                            </MTabTitleBar>
                        </Panel>
                        <TextBlock Grid.Row="1" Margin="12" Text="{Binding ElementName=TitleBar, Path=Bounds.Height}" />
                    </Grid>
                </Border>
            </Border>
            <Border Classes="Box">
                <Border>
                    <Grid RowDefinitions="Auto *" Height="100">
                        <Panel Grid.Row="0">
                            <MPanel Classes="MacOS" Mode="Horizontal" VerticalAlignment="Center"
                                    Spacing="8" Margin="12 0"
                                    Tag="{x:Static Design.IsDesignMode}">
                                <Ellipse Width="12" Height="12" Fill="#ED6A5E" />
                                <Ellipse Width="12" Height="12" Fill="#F4BF4F" />
                                <Ellipse Width="12" Height="12" Fill="#61C554" />
                            </MPanel>
                            <MTabTitleBar>
                                <MTabTitleBar.RightContent>
                                    <MPanel Mode="Horizontal">
                                        <MTitleBarButton Content="Button" />
                                    </MPanel>
                                </MTabTitleBar.RightContent>
                                <MTabTitleBarItem Content="TabItem 1" IsSelected="True" />
                                <MTabTitleBarItem Content="TabItem 2" />
                                <MTabTitleBarItem Content="TabItem 3" />
                                <MTabTitleBarItem Content="TabItem 4" />
                                <MTabTitleBarItem Content="TabItem 5" />
                                <MTabTitleBarItem Content="TabItem 6" />
                            </MTabTitleBar>
                        </Panel>
                    </Grid>
                </Border>
            </Border>
        </MPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type MTabTitleBar}" TargetType="MTabTitleBar">
        <Setter Property="BorderBrush" Value="{MBrush Border}" />
        <Setter Property="BorderThickness" Value="0 0 0 1" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <MPanel Mode="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <MTitleBar Name="TitleBar" Background="{TemplateBinding Background}"
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}"
                               CornerRadius="{TemplateBinding CornerRadius}"
                               ShowContentBorder="False">
                        <Grid ColumnDefinitions="* Auto">
                            <DockPanel Grid.Column="0">
                                <MScrollViewer Name="ScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" ClipToBounds="True">
                                    <Panel Name="PART_BorderHost" Margin="-1 0">
                                        <Border Name="PART_Border" />
                                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </Panel>
                                </MScrollViewer>
                                <Border BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" />
                            </DockPanel>
                            <Border Grid.Column="1" Padding="4 0 0 0"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter Name="PART_RightContentPresenter"
                                                  Content="{TemplateBinding RightContent}"
                                                  ContentTemplate="{TemplateBinding RightContentTemplate}" />
                            </Border>
                        </Grid>
                    </MTitleBar>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ MScrollViewer#ScrollViewer">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="{MBrush Border}" />
            <Setter Property="BorderThickness" Value="{MThickness Px, Filter=Left|Right}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{MBrush Border}" />
            <Setter Property="Background" Value="{OnTheme {MBrush Background, Opacity=0.8}, Dark={MBrush Background, Opacity=0.3}}" />
            <Setter Property="BorderThickness" Value="{MThickness Px, Filter=Left}" />
            <Setter Property="Width" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.1" />
                    <ThicknessTransition Property="Margin" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type MTabTitleBarItem}" TargetType="MTabTitleBarItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  CornerRadius="{TemplateBinding CornerRadius}" />
            </ControlTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <SmoothBrushTransition Property="Foreground" Duration="0:0:0.1" />
                <SmoothBrushTransition Property="BorderBrush" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <Setter Property="Background" Value="#00000000" />
        <Setter Property="Padding" Value="14 0" />
        <Setter Property="BorderBrush" Value="{MBrush Border}" />
        <Setter Property="BorderThickness" Value="{MThickness Px, Filter=Left|Bottom}" />
        <Setter Property="Foreground" Value="{MBrush Foreground, Opacity=0.5}" />
        <Style Selector="^:selected">
            <Setter Property="BorderBrush" Value="{MBrush Border, Opacity=0}" />
            <Setter Property="Foreground" Value="{MBrush Foreground}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
