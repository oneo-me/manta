<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <!-- Switch -->
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <LightCheckBox Header="Accept terms and conditions" />
            <LightCheckBox IsChecked="True" Header="Accept terms and conditions" Content="By clicking this checkbox, you agree to the terms and conditions." />
            <LightCheckBox Header="Enable notifications" IsEnabled="False" />
            <LightCheckBox Variant="Bordered" IsChecked="True" Header="Enable notifications" Content="You can enable or disable notifications at any time." />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type LightCheckBox}" TargetType="LightCheckBox">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto *" RowDefinitions="Auto *" ColumnSpacing="12" RowSpacing="6">
                        <Border Name="Icon" Grid.Column="0" Grid.Row="0">
                            <LightPathIcon />
                        </Border>
                        <ContentPresenter Grid.Column="1" Grid.Row="0" Name="PART_HeaderPresenter"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Content="{TemplateBinding Header}" />
                        <ContentPresenter Grid.Column="1" Grid.Row="1" Name="PART_ContentPresenter"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Content="{TemplateBinding Content}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="#00000000" />
        <Setter Property="Transitions">
            <Transitions>
                <SmoothBrushTransition Property="Background" Duration="0:0:0.1" />
                <SmoothBrushTransition Property="BorderBrush" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
        <Style Selector="^ /template/ Border#Icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="{ThemeColorSet Background}" />
            <Setter Property="BorderBrush" Value="{ThemeColorSet BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BoxShadow" Value="{ThemeShadow MD}" />
            <Style Selector="^ LightPathIcon">
                <Setter Property="Data" Value="M20 6 9 17l-5-5" />
                <Setter Property="UseStroke" Value="True" />
                <Setter Property="Size" Value="8" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="Foreground" Value="{ThemeColorSet Background}" />
            </Style>
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^[Variant=Default]">
            <Style Selector="^:checked">
                <Style Selector="^ /template/ Border#Icon">
                    <Setter Property="Background" Value="{ThemeColorSet Foreground}" />
                    <Setter Property="BorderBrush" Value="{ThemeColorSet Foreground}" />
                    <Setter Property="BoxShadow" Value="{ThemeShadow MD, BrushOpacity=0}" />
                    <Style Selector="^ LightPathIcon">
                        <Setter Property="Opacity" Value="1" />
                    </Style>
                </Style>
            </Style>
        </Style>
        <Style Selector="^[Variant=Bordered]">
            <Setter Property="Background" Value="{ThemeColorSet Foreground, Opacity=0}" />
            <Setter Property="BorderBrush" Value="{ThemeColorSet BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{ThemeColorSet Primary, Opacity=0.05}" />
                <Setter Property="BorderBrush" Value="{ThemeColorSet Primary}" />
                <Style Selector="^ /template/ Border#Icon">
                    <Setter Property="Background" Value="{ThemeColorSet Primary}" />
                    <Setter Property="BorderBrush" Value="{ThemeColorSet Primary}" />
                    <Setter Property="BoxShadow" Value="{ThemeShadow MD, BrushOpacity=0}" />
                    <Style Selector="^ LightPathIcon">
                        <Setter Property="Opacity" Value="1" />
                    </Style>
                </Style>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
