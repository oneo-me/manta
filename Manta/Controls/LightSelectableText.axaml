<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <!-- Text -->
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <LightSelectableText Mt.TextSize="ExtraSmall" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="Small" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="Normal" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="Large" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="ExtraLarge" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="ExtraLarge2" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="ExtraLarge3" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="ExtraLarge4" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="ExtraLarge5" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="ExtraLarge6" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="ExtraLarge7" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="ExtraLarge8" Text="LightSelectableText" />
            <LightSelectableText Mt.TextSize="ExtraLarge9" Text="LightSelectableText" />
        </LightPanel>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type LightSelectableText}" TargetType="LightSelectableText">
        <Setter Property="Background" Value="#00000000" />
        <Style Selector="^[(Mt.TextSize)=ExtraSmall]">
            <Setter Property="FontSize" Value="8" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=Small]">
            <Setter Property="FontSize" Value="10" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=Normal]">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=Large]">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge]">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge2]">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge3]">
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge4]">
            <Setter Property="FontSize" Value="24" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge5]">
            <Setter Property="FontSize" Value="30" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge6]">
            <Setter Property="FontSize" Value="36" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge7]">
            <Setter Property="FontSize" Value="48" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge8]">
            <Setter Property="FontSize" Value="60" />
        </Style>
        <Style Selector="^[(Mt.TextSize)=ExtraLarge9]">
            <Setter Property="FontSize" Value="72" />
        </Style>
        <Setter Property="Cursor" Value="Ibeam" />
        <Setter Property="SelectionBrush" Value="{MtBrush Primary, Opacity=0.3}" />
        <Style Selector="^[(Mt.ColorScheme)=Primary]">
            <Setter Property="Foreground" Value="{MtBrush Primary}" />
            <Setter Property="SelectionBrush" Value="{MtBrush Primary, Opacity=0.3}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Success]">
            <Setter Property="Foreground" Value="{MtBrush Success}" />
            <Setter Property="SelectionBrush" Value="{MtBrush Success, Opacity=0.3}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Warning]">
            <Setter Property="Foreground" Value="{MtBrush Warning}" />
            <Setter Property="SelectionBrush" Value="{MtBrush Warning, Opacity=0.3}" />
        </Style>
        <Style Selector="^[(Mt.ColorScheme)=Danger]">
            <Setter Property="Foreground" Value="{MtBrush Danger}" />
            <Setter Property="SelectionBrush" Value="{MtBrush Danger, Opacity=0.3}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
