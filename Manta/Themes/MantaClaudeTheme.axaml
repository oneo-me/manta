<Styles
    x:Class="Manta.Themes.MantaClaudeTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Default" Source="Claude/@Light.axaml" />
                <ResourceInclude x:Key="Light" Source="Claude/@Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="Claude/@Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
