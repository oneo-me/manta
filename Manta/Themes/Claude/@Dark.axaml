<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:values="clr-namespace:Manta.Themes.Values"
    x:ClassModifier="internal">
    <values:RgbColor x:Key="{MBrushKey Background}" R="20" G="20" B="19" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Foreground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Card}" R="48" G="48" B="46" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey CardForeground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Popover}" R="48" G="48" B="46" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey PopoverForeground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Primary}" R="201" G="100" B="66" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey PrimaryForeground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Secondary}" R="48" G="48" B="46" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey SecondaryForeground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Muted}" R="61" G="61" B="58" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey MutedForeground}" R="176" G="174" B="165" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Accent}" R="94" G="93" B="89" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey AccentForeground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Destructive}" R="181" G="51" B="51" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey DestructiveForeground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Border}" R="94" G="93" B="89" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Input}" R="77" G="76" B="72" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Ring}" R="56" G="152" B="236" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Chart1}" R="217" G="119" B="87" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Chart2}" R="201" G="100" B="66" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Chart3}" R="144" G="158" B="132" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Chart4}" R="176" G="174" B="165" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Chart5}" R="240" G="238" B="230" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey SidebarBackground}" R="48" G="48" B="46" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey SidebarForeground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey SidebarPrimary}" R="217" G="119" B="87" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey SidebarPrimaryForeground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey SidebarAccent}" R="61" G="61" B="58" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey SidebarAccentForeground}" R="250" G="249" B="245" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey SidebarBorder}" R="94" G="93" B="89" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey SidebarRing}" R="56" G="152" B="236" Opacity="1" />
    <values:RgbColor x:Key="{MBrushKey Shadow}" R="20" G="20" B="19" Opacity="1" />
</ResourceDictionary>
