<Styles
    x:Class="Manta.Themes.MantaTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceInclude x:Key="Default" Source="@Light.axaml" />
                <ResourceInclude x:Key="Light" Source="@Light.axaml" />
                <ResourceInclude x:Key="Dark" Source="@Dark.axaml" />
            </ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary.MergedDictionaries>
                <!-- Design -->
                <MergeResourceInclude Source="../Controls/Design/Window.axaml" />
                <!-- Supported Controls -->
                <MergeResourceInclude Source="../Controls/Base/Supported/Button.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/Carousel.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/CheckBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/ComboBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/Expander.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/HyperlinkButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/ItemsControl.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/ListBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/PathIcon.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/RadioButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/ScrollViewer.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/TabStrip.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/TextBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/TitleBar.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/ToggleButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Supported/ToggleSwitch.axaml" />
                <!-- Unsupported Controls -->
                <MergeResourceInclude Source="../Controls/Base/Unsupported/AutoCompleteBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ButtonSpinner.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Calendar.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/CalendarDatePicker.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ContextMenu.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/DataValidationErrors.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/DatePicker.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/DatePickerPresenter.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/DropDownButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/EmbeddableControlRoot.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/FlyoutPresenter.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/MaskedTextBox.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Menu.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/MenuFlyoutPresenter.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/NativeMenuBar.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/NotificationCard.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/NumericUpDown.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ProgressBar.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/RepeatButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Separator.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/Slider.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/SplitButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/SplitView.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TabControl.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TimePicker.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TimePickerPresenter.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ToggleSplitButton.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/ToolTip.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TransitioningContentControl.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/TreeView.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Unsupported/WindowNotificationManager.axaml" />
                <!-- Base Controls -->
                <MergeResourceInclude Source="../Controls/Base/AccessText.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Border.axaml" />
                <MergeResourceInclude Source="../Controls/Base/GridSplitter.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Label.axaml" />
                <MergeResourceInclude Source="../Controls/Base/PopupRoot.axaml" />
                <MergeResourceInclude Source="../Controls/Base/SelectableTextBlock.axaml" />
                <MergeResourceInclude Source="../Controls/Base/TextBlock.axaml" />
                <MergeResourceInclude Source="../Controls/Base/ThemeVariantScope.axaml" />
                <MergeResourceInclude Source="../Controls/Base/Thumb.axaml" />
                <!-- Controls -->
                <MergeResourceInclude Source="../Controls/MAlert.axaml" />
                <MergeResourceInclude Source="../Controls/MAspectRatio.axaml" />
                <MergeResourceInclude Source="../Controls/MAvatar.axaml" />
                <MergeResourceInclude Source="../Controls/MBadge.axaml" />
                <MergeResourceInclude Source="../Controls/MBreadcrumb.axaml" />
                <MergeResourceInclude Source="../Controls/MButton.axaml" />
                <MergeResourceInclude Source="../Controls/MCard.axaml" />
                <MergeResourceInclude Source="../Controls/MCarousel.axaml" />
                <MergeResourceInclude Source="../Controls/MCheckBox.axaml" />
                <MergeResourceInclude Source="../Controls/MClipContentControl.axaml" />
                <MergeResourceInclude Source="../Controls/MComboBox.axaml" />
                <MergeResourceInclude Source="../Controls/MCommand.axaml" />
                <MergeResourceInclude Source="../Controls/MExpander.axaml" />
                <MergeResourceInclude Source="../Controls/MHyperlinkButton.axaml" />
                <MergeResourceInclude Source="../Controls/MIcon.axaml" />
                <MergeResourceInclude Source="../Controls/MItems.axaml" />
                <MergeResourceInclude Source="../Controls/MListBox.axaml" />
                <MergeResourceInclude Source="../Controls/MPathIcon.axaml" />
                <MergeResourceInclude Source="../Controls/MPixelGrid.axaml" />
                <MergeResourceInclude Source="../Controls/MProgressRing.axaml" />
                <MergeResourceInclude Source="../Controls/MRadioButton.axaml" />
                <MergeResourceInclude Source="../Controls/MRing.axaml" />
                <MergeResourceInclude Source="../Controls/MScrollViewer.axaml" />
                <MergeResourceInclude Source="../Controls/MTabStrip.axaml" />
                <MergeResourceInclude Source="../Controls/MTabTitleBar.axaml" />
                <MergeResourceInclude Source="../Controls/MTextBox.axaml" />
                <MergeResourceInclude Source="../Controls/MTitleBar.axaml" />
                <MergeResourceInclude Source="../Controls/MToggleButton.axaml" />
                <MergeResourceInclude Source="../Controls/MToggleSwitch.axaml" />
                <MergeResourceInclude Source="../Controls/MWindow.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
