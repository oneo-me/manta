<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:values="clr-namespace:Manta.Themes.Values"
    x:ClassModifier="internal">
    <!-- ColorSets -->
    <values:RgbColor x:Key="{MBrushKey Background}" R="255" G="255" B="255" />
    <values:RgbColor x:Key="{MBrushKey BorderBrush}" R="55" G="55" B="55" Opacity="0.08" />
    <values:RgbColor x:Key="{MBrushKey Foreground}" R="55" G="55" B="55" />
    <values:RgbColor x:Key="{MBrushKey ColorForeground}" R="255" G="255" B="255" />
    <values:ColorSet x:Key="{MBrushKey Primary}" H="243" />
    <values:ColorSet x:Key="{MBrushKey Success}" H="151" />
    <values:ColorSet x:Key="{MBrushKey Warning}" H="93" />
    <values:ColorSet x:Key="{MBrushKey Danger}" H="14" />
    <!-- Shadows -->
    <BoxShadows x:Key="{MShadowKey XS2}">0 1 #0D000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey XS}">0 1 2 0 #0D000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey SM}">0 1 3 0 #1A000000, 0 1 2 -1 #1A000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey MD}">0 4 6 -1 #1A000000, 0 2 4 -2 #1A000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey LG}">0 10 15 -3 #1A000000, 0 4 6 -4 #1A000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey XL}">0 20 25 -5 #1A000000, 0 8 10 -6 #1A000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey XL2}">0 25 50 -12 #40000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey InsetXS2}">inset 0 1 #0D000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey InsetXS}">inset 0 1 1 #0D000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey InsetSM}">inset 0 2 4 #0D000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey DropXS}">0 1 1 #0D000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey DropSM}">0 1 2 #26000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey DropMD}">0 3 3 #1F000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey DropLG}">0 4 4 #26000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey DropXL}">0 9 7 #1A000000</BoxShadows>
    <BoxShadows x:Key="{MShadowKey DropXL2}">0 25 25 #26000000</BoxShadows>
    <!-- Menu Shadow -->
    <BoxShadows x:Key="{MShadowKey Menu}">0 0 5 #26000000</BoxShadows>
</ResourceDictionary>
