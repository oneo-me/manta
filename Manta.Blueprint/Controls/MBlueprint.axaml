<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Manta.Blueprint.Controls"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <controls:MBlueprint Width="800" Height="600" />
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type controls:MBlueprint}" TargetType="controls:MBlueprint">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Grid background with zoom/pan support -->
                    <controls:MBlueprintGridBackground Name="PART_GridBackground" />

                    <!-- Transform container for both connections and nodes -->
                    <Panel Name="PART_TransformContainer">
                        <!-- Connection layer (rendered behind nodes) -->
                        <controls:MBlueprintConnectionLayer Name="PART_ConnectionLayer" />

                        <!-- Node canvas -->
                        <Canvas Name="PART_Canvas" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
