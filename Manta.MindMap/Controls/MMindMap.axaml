<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Manta.MindMap.Controls"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <controls:MMindMap />
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type controls:MMindMap}" TargetType="controls:MMindMap">
        <Setter Property="Background" Value="{MBrush Background}" />
        <Setter Property="NodeBackground" Value="{MBrush Secondary}" />
        <Setter Property="NodeForeground" Value="{MBrush SecondaryForeground}" />
        <Setter Property="RootNodeBackground" Value="{MBrush Primary}" />
        <Setter Property="RootNodeForeground" Value="{MBrush PrimaryForeground}" />
        <Setter Property="EdgeBrush" Value="{MBrush Border}" />
        <Setter Property="SelectedBrush" Value="{MBrush Accent}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" ClipToBounds="True">
                    <Panel Name="PART_TransformContainer">
                        <Canvas Name="PART_Canvas" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
