<MView
    x:Class="Manta.Demo.Views.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Views"
    x:DataType="local:Main_Model" Design.DataContext="{x:Static local:Main_Model.Design}" Design.Height="500">
    <Grid RowDefinitions="Auto *">
        <MViewHost Grid.Row="1" Background="{OnTheme {MBrush Background, Opacity=0.8}, Dark={MBrush Background, Opacity=0.3}}" ViewModel="{Binding RegionManager.SelectedItem}" />
        <MTabTitleBar Grid.Row="0" ItemsSource="{Binding RegionManager.Items}" SelectedItem="{Binding RegionManager.SelectedItem}">
            <MTabTitleBar.RightContent>
                <MPanel Mode="Horizontal">
                    <MTitleBarButton Command="{Binding OpenTweakcnTool}">
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MIcon IconSize="18" IconSource="{Binding TweakcnToolIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </MPanel>
                    </MTitleBarButton>
                    <MTitleBarButton>
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MIcon IconSize="18" IconSource="{Binding ThemeSystemIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </MPanel>
                    </MTitleBarButton>
                    <MTitleBarButton Command="{Binding OpenSettings}">
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MIcon IconSize="18" IconSource="{Binding SettingsIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </MPanel>
                    </MTitleBarButton>
                </MPanel>
            </MTabTitleBar.RightContent>
            <MTabTitleBar.ItemTemplate>
                <DataTemplate>
                    <MPanel Mode="Horizontal" Spacing="8">
                        <MIcon IconSize="18" IconSource="{Binding Icon}" Margin="0 -10" VerticalAlignment="Center" />
                        <TextBlock Text="{Lang {Binding Header}}" VerticalAlignment="Center" />
                    </MPanel>
                </DataTemplate>
            </MTabTitleBar.ItemTemplate>
        </MTabTitleBar>
    </Grid>
</MView>
