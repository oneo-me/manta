<MView
    x:Class="Manta.Demo.Views.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Views"
    x:DataType="local:Main_Model" Design.DataContext="{x:Static local:Main_Model.Design}">
    <Grid RowDefinitions="Auto *">
        <MViewHost Grid.Row="1" Background="{MBrush Background}" ViewModel="{Binding RegionManager.SelectedItem}" />
        <MTitleBar Grid.Row="0" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="* Auto" ColumnSpacing="4">
                <MScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                               ClipToBounds="True" Padding="-1 0" Margin="-1 0 -1 -1">
                    <MTabStrip Type="RootTab" ItemsSource="{Binding RegionManager.Items}" SelectedItem="{Binding RegionManager.SelectedItem}">
                        <MTabStrip.ItemTemplate>
                            <DataTemplate>
                                <MPanel Mode="Horizontal" Spacing="8">
                                    <MIcon M.ColorScheme="Primary" IconSize="18" IconSource="{Binding Icon}" Margin="0 -10" VerticalAlignment="Center" />
                                    <MText Text="{Lang {Binding Header}}" VerticalAlignment="Center" />
                                </MPanel>
                            </DataTemplate>
                        </MTabStrip.ItemTemplate>
                    </MTabStrip>
                </MScrollViewer>
                <Border Grid.Column="0" BorderThickness="1 0" />
                <MPanel Grid.Column="1" Mode="Horizontal">
                    <MTitleBarButton>
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MIcon M.ColorScheme="Primary" IconSize="18" IconSource="{Binding ThemeSystemIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </MPanel>
                    </MTitleBarButton>
                    <MTitleBarButton Command="{Binding OpenSettings}">
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MIcon M.ColorScheme="Primary" IconSize="18" IconSource="{Binding SettingsIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </MPanel>
                    </MTitleBarButton>
                </MPanel>
            </Grid>
        </MTitleBar>
    </Grid>
</MView>
