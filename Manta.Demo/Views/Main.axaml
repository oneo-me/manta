<MView
    x:Class="Manta.Demo.Views.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Views"
    x:DataType="local:Main_Model" Design.DataContext="{x:Static local:Main_Model.Design}">
    <Grid RowDefinitions="Auto *">
        <MViewHost Grid.Row="1" Background="{MBrush Background}" ViewModel="{Binding RegionManager.SelectedItem}" />
        <MTitleBar Grid.Row="0" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="* Auto" ColumnSpacing="4">
                <Panel Grid.Column="0" HorizontalAlignment="Left" Margin="-1 0 -1 -1" ClipToBounds="True">
                    <MScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                   Padding="-1 0" HorizontalAlignment="Left">
                        <MTabStrip Type="RootTab" ItemsSource="{Binding RegionManager.Items}" SelectedItem="{Binding RegionManager.SelectedItem}">
                            <MTabStrip.ItemTemplate>
                                <DataTemplate>
                                    <MPanel Mode="Horizontal" Spacing="8">
                                        <MIcon IconSize="18" IconSource="{Binding Icon}" Margin="0 -10" VerticalAlignment="Center" />
                                        <TextBlock Text="{Lang {Binding Header}}" VerticalAlignment="Center" />
                                    </MPanel>
                                </DataTemplate>
                            </MTabStrip.ItemTemplate>
                        </MTabStrip>
                    </MScrollViewer>
                    <Border BorderThickness="1 0" />
                </Panel>
                <MPanel Grid.Column="1" Mode="Horizontal">
                    <MTitleBarButton>
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MIcon IconSize="18" IconSource="{Binding ThemeSystemIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </MPanel>
                    </MTitleBarButton>
                    <MTitleBarButton Command="{Binding OpenSettings}">
                        <MPanel Mode="Horizontal" Spacing="8">
                            <MIcon IconSize="18" IconSource="{Binding SettingsIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </MPanel>
                    </MTitleBarButton>
                </MPanel>
            </Grid>
        </MTitleBar>
    </Grid>
</MView>
