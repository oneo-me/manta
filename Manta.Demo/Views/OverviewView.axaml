<MtView
    x:Class="Manta.Demo.Views.OverviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Views"
    x:DataType="local:OverviewView_Model" Design.DataContext="{x:Static local:OverviewView_Model.Design}"
    Name="View">
    <MtPanel Mode="Vertical" Spacing="12" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <MtText Text="{Lang {x:Static LangKey.Title}}" FontWeight="ExtraLight" Mt.TextSize="ExtraLarge6" HorizontalAlignment="Center" />
        <MtText Text="{Lang {x:Static LangKey.Description}}" />
        <MtItems ItemsSource="{Binding Items}">
            <MtItems.ItemsPanel>
                <ItemsPanelTemplate>
                    <MtPanel Mode="Horizontal" Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </MtItems.ItemsPanel>
            <MtItems.ItemTemplate>
                <DataTemplate>
                    <MtButton Size="Small" Mt.ColorScheme="Primary"
                                 Content="{Lang {Binding Header}}"
                                 Command="{Binding ElementName=View, Path=DataContext.OpenRegion}"
                                 CommandParameter="{Binding}" />
                </DataTemplate>
            </MtItems.ItemTemplate>
        </MtItems>
        <MtItems ItemsSource="{Binding SupportedLanguages}">
            <MtItems.ItemsPanel>
                <ItemsPanelTemplate>
                    <MtPanel Mode="Horizontal" Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </MtItems.ItemsPanel>
            <MtItems.ItemTemplate>
                <DataTemplate>
                    <MtButton Variant="Outline" Size="Small"
                                 Command="{Binding ElementName=View, Path=DataContext.ChangeLanguage}"
                                 CommandParameter="{Binding}">
                        <MtPanel Mode="Horizontal" Spacing="6">
                            <MtText Text="{LangEmoji {Binding}}" VerticalAlignment="Center" />
                            <MtText Text="{LangName {Binding}}" VerticalAlignment="Center" />
                        </MtPanel>
                    </MtButton>
                </DataTemplate>
            </MtItems.ItemTemplate>
        </MtItems>
    </MtPanel>
</MtView>
