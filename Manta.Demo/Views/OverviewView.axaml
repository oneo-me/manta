<MView
    x:Class="Manta.Demo.Views.OverviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Views"
    x:DataType="local:OverviewView_Model" Design.DataContext="{x:Static local:OverviewView_Model.Design}"
    Name="View">
    <MPanel Mode="Vertical" Spacing="12" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Lang {x:Static LangKey.Title}}" FontWeight="ExtraLight" FontSize="72" HorizontalAlignment="Center" />
        <TextBlock Text="{Lang {x:Static LangKey.Description}}" />
        <MItems ItemsSource="{Binding Items}">
            <MItems.ItemsPanel>
                <ItemsPanelTemplate>
                    <MPanel Mode="Horizontal" Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </MItems.ItemsPanel>
            <MItems.ItemTemplate>
                <DataTemplate>
                    <MButton Size="Small"
                             Content="{Lang {Binding Header}}"
                             Command="{Binding ElementName=View, Path=DataContext.OpenRegion}"
                             CommandParameter="{Binding}" />
                </DataTemplate>
            </MItems.ItemTemplate>
        </MItems>
        <MItems ItemsSource="{Binding SupportedLanguages}">
            <MItems.ItemsPanel>
                <ItemsPanelTemplate>
                    <MPanel Mode="Horizontal" Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </MItems.ItemsPanel>
            <MItems.ItemTemplate>
                <DataTemplate>
                    <MButton Variant="Outline" Size="Small"
                             Command="{Binding ElementName=View, Path=DataContext.ChangeLanguage}"
                             CommandParameter="{Binding}">
                        <MPanel Mode="Horizontal" Spacing="6">
                            <TextBlock Text="{LangEmoji {Binding}}" VerticalAlignment="Center" />
                            <TextBlock Text="{LangName {Binding}}" VerticalAlignment="Center" />
                        </MPanel>
                    </MButton>
                </DataTemplate>
            </MItems.ItemTemplate>
        </MItems>
    </MPanel>
</MView>
