<LightView
    x:Class="Manta.Demo.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Views"
    x:DataType="local:SettingsView_Model" Design.DataContext="{x:Static local:SettingsView_Model.Design}">
    <Grid ColumnDefinitions="180 *">
        <Border Grid.Column="0" BorderThickness="0 0 1 0">
            <Panel>
                <Border Name="SidebarBackground" />
                <LightListBox Name="Sidebar" Type="Sidebar" VerticalAlignment="Top">
                    <LightListBox.Styles>
                        <Style Selector="LightListBox[Type=Sidebar]">
                            <Setter Property="Padding" Value="7" />
                        </Style>
                        <Style Selector="LightListBoxItem[Type=Sidebar]">
                            <Setter Property="Padding" Value="12 7" />
                        </Style>
                    </LightListBox.Styles>
                    <LightListBoxItem>
                        <LightPanel Mode="Horizontal" Spacing="4">
                            <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                            <LightText Text="Group Item 1" VerticalAlignment="Center" />
                        </LightPanel>
                    </LightListBoxItem>
                    <LightListBoxItem>
                        <LightPanel Mode="Horizontal" Spacing="4">
                            <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                            <LightText Text="Group Item 2" VerticalAlignment="Center" />
                        </LightPanel>
                    </LightListBoxItem>
                    <LightListBoxItem>
                        <LightPanel Mode="Horizontal" Spacing="4">
                            <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                            <LightText Text="Group Item 3" VerticalAlignment="Center" />
                        </LightPanel>
                    </LightListBoxItem>
                    <LightListBoxItem>
                        <LightPanel Mode="Horizontal" Spacing="4">
                            <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                            <LightText Text="Group Item 4" VerticalAlignment="Center" />
                        </LightPanel>
                    </LightListBoxItem>
                </LightListBox>
            </Panel>
        </Border>
        <Border Grid.Column="1" Background="{ThemeColorSet Background}">
            <Grid RowDefinitions="Auto *">
                <Border Grid.Row="0" Name="TitleBar" Height="39" BorderThickness="0 0 0 1">
                    <Grid ColumnDefinitions="* Auto">
                        <LightText Grid.Column="0" Text="Group Item 1" FontWeight="SemiBold" Margin="12 0" VerticalAlignment="Center" />
                        <LightTitleBarButtons Grid.Column="1" Name="TitleBarButtons" />
                    </Grid>
                </Border>
                <Border Grid.Row="1">
                    <Grid ColumnDefinitions="160 *">
                        <Border Grid.Column="0" BorderThickness="0 0 1 0">
                            <Grid RowDefinitions="* Auto">
                                <LightListBox Grid.Row="0" Type="Sidebar" BorderThickness="0 0 0 1">
                                    <LightListBox.Styles>
                                        <Style Selector="LightListBox[Type=Sidebar]">
                                            <Setter Property="Padding" Value="6" />
                                        </Style>
                                        <Style Selector="LightListBoxItem[Type=Sidebar]">
                                            <Setter Property="Padding" Value="12 6" />
                                        </Style>
                                    </LightListBox.Styles>
                                    <LightListBoxItem Content="Item 1" />
                                    <LightListBoxItem Content="Item 2" />
                                    <LightListBoxItem Content="Item 3" />
                                    <LightListBoxItem Content="Item 4" />
                                    <LightListBoxItem Content="Item 5" />
                                </LightListBox>
                                <Grid Grid.Row="1" ColumnDefinitions="* Auto">
                                    <LightPanel Grid.Column="0" Mode="Horizontal" Spacing="3" Margin="3">
                                        <LightButton Variant="Ghost" Padding="4">
                                            <LightIcon IconSize="14" IconSource="{Binding TestIcon}" />
                                        </LightButton>
                                        <LightButton Variant="Ghost" Padding="4">
                                            <LightIcon IconSize="14" IconSource="{Binding TestIcon}" />
                                        </LightButton>
                                    </LightPanel>
                                    <LightPanel Grid.Column="1" Mode="Horizontal" Spacing="3" Margin="3">
                                        <LightButton Variant="Ghost" Padding="4">
                                            <LightIcon IconSize="14" IconSource="{Binding TestIcon}" />
                                        </LightButton>
                                    </LightPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" RowDefinitions="Auto *">
                            <Border Grid.Row="0" BorderThickness="0 0 0 1" Background="{ThemeColorSet BorderBrush, Opacity=0.6}">
                                <LightText Text="Item 1" FontWeight="SemiBold" Margin="12 6" />
                            </Border>
                            <LightScrollViewer Grid.Row="1">
                                <LightPanel Mode="Vertical" Spacing="12" Margin="12">
                                    <LightText Text="About" FontWeight="SemiBold" />
                                    <LightPanel Mode="Vertical" Spacing="12" TextBlock.TextAlignment="Center">
                                        <LightIcon Theme.ColorScheme="Primary" IconSize="62" IconSource="{Binding TestIcon}" />
                                        <LightPanel Mode="Vertical" Spacing="3">
                                            <LightText Text="Manta" FontSize="14" FontWeight="SemiBold" />
                                            <LightText Text="v1.0.0" />
                                            <LightText Text="2025/10/31" Opacity="0.5" />
                                            <LightPanel Mode="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                <LightText Text="Website" Opacity="0.5" />
                                                <LightText Text="Copy Debug Info" Opacity="0.5" />
                                            </LightPanel>
                                        </LightPanel>
                                        <LightPanel Mode="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <LightButton Size="Small" Variant="Ghost">
                                                <LightPanel Mode="Horizontal" Spacing="4">
                                                    <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                                                    <LightText Text="Issues" VerticalAlignment="Center" />
                                                </LightPanel>
                                            </LightButton>
                                            <LightButton Size="Small" Variant="Ghost">
                                                <LightPanel Mode="Horizontal" Spacing="4">
                                                    <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                                                    <LightText Text="Discord" VerticalAlignment="Center" />
                                                </LightPanel>
                                            </LightButton>
                                            <LightButton Size="Small" Variant="Ghost">
                                                <LightPanel Mode="Horizontal" Spacing="4">
                                                    <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                                                    <LightText Text="Twitter" VerticalAlignment="Center" />
                                                </LightPanel>
                                            </LightButton>
                                            <LightButton Size="Small" Variant="Ghost">
                                                <LightPanel Mode="Horizontal" Spacing="4">
                                                    <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                                                    <LightText Text="Github" VerticalAlignment="Center" />
                                                </LightPanel>
                                            </LightButton>
                                        </LightPanel>
                                        <LightPanel Mode="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <LightButton Theme.ColorScheme="Primary" Size="Small" Content="Update log" />
                                            <LightButton Theme.ColorScheme="Primary" Size="Small" Content="check for updates" />
                                        </LightPanel>
                                    </LightPanel>
                                    <LightText Text="Group format" FontWeight="SemiBold" />
                                    <LightItems>
                                        <LightItems.Styles>
                                            <Style Selector="LightItems">
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Setter Property="Background" Value="{ThemeColorSet BorderBrush, Opacity=0.2}" />
                                            </Style>
                                            <Style Selector="LightItem">
                                                <Setter Property="BorderBrush" Value="{ThemeColorSet BorderBrush}" />
                                                <Setter Property="BorderThickness" Value="0 1 0 0" />
                                                <Setter Property="Margin" Value="8 0" />
                                                <Setter Property="Padding" Value="8" />
                                                <Style Selector="^:nth-child(1)">
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </Style>
                                        </LightItems.Styles>
                                        <LightItem>
                                            <Grid ColumnDefinitions="* Auto">
                                                <LightPanel Grid.Column="0" Mode="Vertical" VerticalAlignment="Center">
                                                    <LightText Text="Language" />
                                                    <LightText Text="Change the display language of the interface" Opacity="0.5" />
                                                </LightPanel>
                                                <Panel Grid.Column="1" Margin="12 0 0 0" VerticalAlignment="Center">
                                                    <LightButton Content="Button" />
                                                </Panel>
                                            </Grid>
                                        </LightItem>
                                        <LightItem>
                                            <Grid ColumnDefinitions="* Auto">
                                                <LightPanel Grid.Column="0" Mode="Vertical" VerticalAlignment="Center">
                                                    <LightText Text="Network proxy" />
                                                    <LightText Text="Supports HTTP and SOCKS5 proxies" Opacity="0.5" />
                                                </LightPanel>
                                                <Panel Grid.Column="1" Margin="12 0 0 0" VerticalAlignment="Center">
                                                    <LightTextBox Width="160" Padding="8 4" Watermark="http://127.0.0.1:7897" />
                                                </Panel>
                                            </Grid>
                                        </LightItem>
                                    </LightItems>
                                    <LightText Text="Direct format" FontWeight="SemiBold" />
                                    <LightText Text="OpenAI-compatible provider" Opacity="0.5" />
                                    <LightPanel Mode="Vertical" Spacing="3">
                                        <LightText Text="Provider name" />
                                        <Grid ColumnDefinitions="Auto *">
                                            <LightButton Grid.Column="0" Variant="Outline" Padding="6 4">
                                                <LightIcon IconSize="14" IconSource="{Binding TestIcon}" />
                                            </LightButton>
                                            <LightTextBox Grid.Column="1" Margin="5 0 0 0" Padding="8 4" Watermark="OpenAI" />
                                        </Grid>
                                    </LightPanel>
                                    <LightPanel Mode="Vertical" Spacing="3">
                                        <LightText Text="API Base URL" />
                                        <LightText Text="Do NOT include /chat/completions in the URL" Opacity="0.5" />
                                        <LightTextBox Padding="8 4" Watermark="https://api.openai.com/v1" />
                                    </LightPanel>
                                    <LightPanel Mode="Vertical" Spacing="3">
                                        <LightText Text="API Key" />
                                        <LightTextBox Padding="8 4" Text="https://api.openai.com/v1" IsPasswordBox="True" />
                                    </LightPanel>
                                    <LightPanel Mode="Vertical" Spacing="3">
                                        <Grid ColumnDefinitions="* Auto">
                                            <LightText Grid.Column="0" Text="Models" VerticalAlignment="Center" />
                                            <LightPanel Grid.Column="1" Mode="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <LightButton Variant="Ghost" Padding="4 2">
                                                    <LightPanel Mode="Horizontal" Spacing="4">
                                                        <LightIcon IconSize="14" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                                                        <LightText Text="Delete all" VerticalAlignment="Center" />
                                                    </LightPanel>
                                                </LightButton>
                                                <LightButton Variant="Ghost" Padding="4 2">
                                                    <LightPanel Mode="Horizontal" Spacing="4">
                                                        <LightIcon IconSize="14" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                                                        <LightText Text="New" VerticalAlignment="Center" />
                                                    </LightPanel>
                                                </LightButton>
                                                <LightButton Variant="Ghost" Padding="4 2">
                                                    <LightPanel Mode="Horizontal" Spacing="4">
                                                        <LightIcon IconSize="14" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                                                        <LightText Text="Fetch models" VerticalAlignment="Center" />
                                                    </LightPanel>
                                                </LightButton>
                                            </LightPanel>
                                        </Grid>
                                        <Border BorderThickness="1" CornerRadius="8">
                                            <LightPanel Mode="Vertical" Spacing="6" Margin="6" Grid.IsSharedSizeScope="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Setting" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Delete" />
                                                    </Grid.ColumnDefinitions>
                                                    <LightText Grid.Column="0" Text="Nick name" Margin="6 0" />
                                                    <LightText Grid.Column="1" Text="Model Id" Margin="6 0" />
                                                </Grid>
                                                <LightItems BorderThickness="0 1 0 0">
                                                    <LightItems.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <LightPanel Mode="Vertical" Spacing="6" Margin="0 6 0 0" />
                                                        </ItemsPanelTemplate>
                                                    </LightItems.ItemsPanel>
                                                    <LightItem>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Setting" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Delete" />
                                                            </Grid.ColumnDefinitions>
                                                            <LightTextBox Grid.Column="0" Watermark="optional" Width="180" Padding="8 4" Margin="0 0 8 0" />
                                                            <LightTextBox Grid.Column="1" Text="gpt-5-nano" Padding="8 4" />
                                                            <LightButton Grid.Column="2" Variant="Ghost" Padding="4" Margin="8 0">
                                                                <LightIcon IconSize="14" IconSource="{Binding TestIcon}" />
                                                            </LightButton>
                                                            <LightButton Grid.Column="3" Variant="Ghost" Padding="4">
                                                                <LightIcon IconSize="14" IconSource="{Binding TestIcon}" />
                                                            </LightButton>
                                                        </Grid>
                                                    </LightItem>
                                                </LightItems>
                                            </LightPanel>
                                        </Border>
                                    </LightPanel>
                                </LightPanel>
                            </LightScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</LightView>
