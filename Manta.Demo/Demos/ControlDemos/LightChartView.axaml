<MtView
    x:Class="Manta.Demo.Demos.ControlDemos.MtChartView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Demos.ControlDemos"
    x:DataType="local:LightChartView_Model" Design.DataContext="{x:Static local:LightChartView_Model.Design}">
    <MtScrollViewer>
        <MtPanel Mode="Vertical" Spacing="12" Margin="12">
            <MtCard Width="320" Height="180" HorizontalAlignment="Left">
                <MtChart Data="{Binding Data1}" ShowLegends="False" />
            </MtCard>
            <MtCard Width="520" Height="380" HorizontalAlignment="Left">
                <MtChart Title="{Binding Title}" Data="{Binding Data2}" />
            </MtCard>
        </MtPanel>
    </MtScrollViewer>
</MtView>
