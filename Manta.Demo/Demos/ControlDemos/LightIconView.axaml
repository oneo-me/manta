<MtView
    x:Class="Manta.Demo.Demos.ControlDemos.MtIconView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Demos.ControlDemos"
    x:DataType="local:LightIconView_Model" Design.DataContext="{x:Static local:LightIconView_Model.Design}">
    <MtPanel Mode="Vertical" Spacing="12" Margin="12">
        <MtPanel Mode="Horizontal" Spacing="12">
            <MtIcon IconSize="80" IconSource="{Binding TestIcon}" />
            <MtIcon IconSize="80" IconStyle="OnlyBorder" IconSource="{Binding TestIcon}" />
        </MtPanel>
        <MtPanel Mode="Horizontal" Spacing="12">
            <MtIcon IconSize="50" IconSource="{Binding TestIcon}" Background="{MtBrush Primary, Opacity=0.1}" Foreground="{MtBrush Primary}" />
            <MtIcon IconSize="50" IconStyle="OnlyBorder" IconSource="{Binding TestIcon}" Foreground="{MtBrush Primary}" />
        </MtPanel>
    </MtPanel>
</MtView>
