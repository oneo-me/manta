<MView
    x:Class="Manta.Demo.Demos.ReactiveDemos.DialogView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Demos.ReactiveDemos"
    x:DataType="local:DialogView_Model" Design.DataContext="{x:Static local:DialogView_Model.Design}">
    <MPanel Mode="Vertical" Spacing="12" Margin="12">
        <TextBlock Text="Normal" />
        <MPanel Mode="Horizontal" Spacing="12">
            <MButton Variant="Outline" Content="Alert" Command="{Binding AlertAsync}" />
            <MButton Variant="Outline" Content="Confirm" Command="{Binding ConfirmAsync}" />
        </MPanel>
        <TextBlock Text="CommandWarper" />
        <MPanel Mode="Horizontal" Spacing="12">
            <MButton Variant="Outline" Content="Alert" Command="{Binding AlertAsyncCommand}" />
            <MButton Variant="Outline" Content="Confirm" Command="{Binding ConfirmAsyncCommand}" />
        </MPanel>
    </MPanel>
</MView>
