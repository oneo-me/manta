<MtView
    x:Class="Manta.Demo.Demos.StyleDemos.ColorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Demos.StyleDemos"
    x:DataType="local:ColorView_Model" Design.DataContext="{x:Static local:ColorView_Model.Design}">
    <MtView.Styles>
        <Style Selector="MtText.Key">
            <Setter Property="Margin" Value="0 0 8 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Color">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="MtPanel.ColorBox">
            <Setter Property="Spacing" Value="6" />
            <Setter Property="Mode" Value="Horizontal" />
        </Style>
    </MtView.Styles>
    <MtScrollViewer HorizontalScrollBarVisibility="Auto">
        <MtPanel Mode="Vertical" Spacing="12" Margin="12" Grid.IsSharedSizeScope="True">
            <MtText Text="ColorTest" FontWeight="SemiBold" />
            <MtPanel Mode="Vertical" Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Tests" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="{Binding H, StringFormat=H: {0}}" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="360" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding H}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Tests" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="Colors" VerticalAlignment="Center" />
                    <MtItems Grid.Column="1" ItemsSource="{Binding Colors}">
                        <MtItems.ItemsPanel>
                            <ItemsPanelTemplate>
                                <MtPanel Mode="Horizontal" Classes="ColorBox" />
                            </ItemsPanelTemplate>
                        </MtItems.ItemsPanel>
                        <MtItems.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="Color" Background="{Binding}" />
                            </DataTemplate>
                        </MtItems.ItemTemplate>
                    </MtItems>
                </Grid>
            </MtPanel>
            <MtText Text="ColorSet" FontWeight="SemiBold" />
            <MtPanel Mode="Vertical" Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColorSet" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="Background" />
                    <MtPanel Grid.Column="1" Classes="ColorBox">
                        <Border Classes="Color" Background="{MtBrush Background, Type=Light3}" />
                        <Border Classes="Color" Background="{MtBrush Background, Type=Light2}" />
                        <Border Classes="Color" Background="{MtBrush Background, Type=Light1}" />
                        <Border Classes="Color" Background="{MtBrush Background}" />
                        <Border Classes="Color" Background="{MtBrush Background, Type=Dark1}" />
                        <Border Classes="Color" Background="{MtBrush Background, Type=Dark2}" />
                        <Border Classes="Color" Background="{MtBrush Background, Type=Dark3}" />
                    </MtPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColorSet" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="BorderBrush" />
                    <MtPanel Grid.Column="1" Classes="ColorBox">
                        <Border Classes="Color" Background="{MtBrush BorderBrush, Type=Light3}" />
                        <Border Classes="Color" Background="{MtBrush BorderBrush, Type=Light2}" />
                        <Border Classes="Color" Background="{MtBrush BorderBrush, Type=Light1}" />
                        <Border Classes="Color" Background="{MtBrush BorderBrush}" />
                        <Border Classes="Color" Background="{MtBrush BorderBrush, Type=Dark1}" />
                        <Border Classes="Color" Background="{MtBrush BorderBrush, Type=Dark2}" />
                        <Border Classes="Color" Background="{MtBrush BorderBrush, Type=Dark3}" />
                    </MtPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColorSet" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="Foreground" />
                    <MtPanel Grid.Column="1" Classes="ColorBox">
                        <Border Classes="Color" Background="{MtBrush Foreground, Type=Light3}" />
                        <Border Classes="Color" Background="{MtBrush Foreground, Type=Light2}" />
                        <Border Classes="Color" Background="{MtBrush Foreground, Type=Light1}" />
                        <Border Classes="Color" Background="{MtBrush Foreground}" />
                        <Border Classes="Color" Background="{MtBrush Foreground, Type=Dark1}" />
                        <Border Classes="Color" Background="{MtBrush Foreground, Type=Dark2}" />
                        <Border Classes="Color" Background="{MtBrush Foreground, Type=Dark3}" />
                    </MtPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColorSet" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="ColorForeground" />
                    <MtPanel Grid.Column="1" Classes="ColorBox">
                        <Border Classes="Color" Background="{MtBrush ColorForeground, Type=Light3}" />
                        <Border Classes="Color" Background="{MtBrush ColorForeground, Type=Light2}" />
                        <Border Classes="Color" Background="{MtBrush ColorForeground, Type=Light1}" />
                        <Border Classes="Color" Background="{MtBrush ColorForeground}" />
                        <Border Classes="Color" Background="{MtBrush ColorForeground, Type=Dark1}" />
                        <Border Classes="Color" Background="{MtBrush ColorForeground, Type=Dark2}" />
                        <Border Classes="Color" Background="{MtBrush ColorForeground, Type=Dark3}" />
                    </MtPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColorSet" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="Primary" />
                    <MtPanel Grid.Column="1" Classes="ColorBox">
                        <Border Classes="Color" Background="{MtBrush Primary, Type=Light3}" />
                        <Border Classes="Color" Background="{MtBrush Primary, Type=Light2}" />
                        <Border Classes="Color" Background="{MtBrush Primary, Type=Light1}" />
                        <Border Classes="Color" Background="{MtBrush Primary}" />
                        <Border Classes="Color" Background="{MtBrush Primary, Type=Dark1}" />
                        <Border Classes="Color" Background="{MtBrush Primary, Type=Dark2}" />
                        <Border Classes="Color" Background="{MtBrush Primary, Type=Dark3}" />
                    </MtPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColorSet" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="Success" />
                    <MtPanel Grid.Column="1" Classes="ColorBox">
                        <Border Classes="Color" Background="{MtBrush Success, Type=Light3}" />
                        <Border Classes="Color" Background="{MtBrush Success, Type=Light2}" />
                        <Border Classes="Color" Background="{MtBrush Success, Type=Light1}" />
                        <Border Classes="Color" Background="{MtBrush Success}" />
                        <Border Classes="Color" Background="{MtBrush Success, Type=Dark1}" />
                        <Border Classes="Color" Background="{MtBrush Success, Type=Dark2}" />
                        <Border Classes="Color" Background="{MtBrush Success, Type=Dark3}" />
                    </MtPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColorSet" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="Warning" />
                    <MtPanel Grid.Column="1" Classes="ColorBox">
                        <Border Classes="Color" Background="{MtBrush Warning, Type=Light3}" />
                        <Border Classes="Color" Background="{MtBrush Warning, Type=Light2}" />
                        <Border Classes="Color" Background="{MtBrush Warning, Type=Light1}" />
                        <Border Classes="Color" Background="{MtBrush Warning}" />
                        <Border Classes="Color" Background="{MtBrush Warning, Type=Dark1}" />
                        <Border Classes="Color" Background="{MtBrush Warning, Type=Dark2}" />
                        <Border Classes="Color" Background="{MtBrush Warning, Type=Dark3}" />
                    </MtPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColorSet" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <MtText Grid.Column="0" Classes="Key" Text="Error" />
                    <MtPanel Grid.Column="1" Classes="ColorBox">
                        <Border Classes="Color" Background="{MtBrush Danger, Type=Light3}" />
                        <Border Classes="Color" Background="{MtBrush Danger, Type=Light2}" />
                        <Border Classes="Color" Background="{MtBrush Danger, Type=Light1}" />
                        <Border Classes="Color" Background="{MtBrush Danger}" />
                        <Border Classes="Color" Background="{MtBrush Danger, Type=Dark1}" />
                        <Border Classes="Color" Background="{MtBrush Danger, Type=Dark2}" />
                        <Border Classes="Color" Background="{MtBrush Danger, Type=Dark3}" />
                    </MtPanel>
                </Grid>
            </MtPanel>
        </MtPanel>
    </MtScrollViewer>
</MtView>
