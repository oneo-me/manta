<MView
    x:Class="Manta.Demo.Demos.StyleDemos.ShadowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Manta.Demo.Demos.StyleDemos"
    x:DataType="local:ShadowView_Model" Design.DataContext="{x:Static local:ShadowView_Model.Design}">
    <MScrollViewer>
        <MPanel Mode="Vertical" Spacing="12" Margin="12">
            <TextBlock Text="Shadows" FontWeight="SemiBold" />
            <MPanel Mode="Wrap" Spacing="12">
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow XXS}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XS2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow XS}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XS" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow MD}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="MD" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow LG}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="LG" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow XL}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XL" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow XXL}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XL2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
            </MPanel>
            <TextBlock Text="Insert Shadows" FontWeight="SemiBold" />
            <MPanel Mode="Wrap" Spacing="12">
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow InsetXXS}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XS2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow InsetXS}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XS" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow InsetMD}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="MD" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow InsetLG}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="LG" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow InsetXL}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XL" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow InsetXXL}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XL2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
            </MPanel>
            <TextBlock Text="Custom Color or Opacity" FontWeight="SemiBold" />
            <MPanel Mode="Wrap" Spacing="12">
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow XXS, ColorKey=Primary}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XS2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow XS, ColorKey=Primary}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XS" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow MD, ColorKey=Primary}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="MD" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow LG, ColorKey=Primary}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="LG" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow XL, ColorKey=Primary}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XL" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
                <Border Width="100" Height="100" BorderThickness="1" BoxShadow="{MShadow XXL, ColorKey=Primary}" CornerRadius="12" Background="{MBrush Background}">
                    <TextBlock Text="XL2" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Border>
            </MPanel>
        </MPanel>
    </MScrollViewer>
</MView>
