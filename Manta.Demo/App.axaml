<MApp
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Manta.Demo.App" RequestedThemeVariant="Default">
    <MApp.Styles>
        <MantaTheme />
        <MantaChartsTheme />
        <MantaWebViewTheme />
        <MantaMarkdownTheme />
        <MantaChatTheme />
        <MantaBlueprintTheme />
        <StyleInclude Source="Styles/@Styles.axaml" />
    </MApp.Styles>
</MApp>
