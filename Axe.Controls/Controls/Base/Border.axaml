<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <Border Width="100" Height="100" BorderThickness="1" />
        </PanelExt>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type Border}" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeBrush BorderBrush}" />
    </ControlTheme>
</ResourceDictionary>
