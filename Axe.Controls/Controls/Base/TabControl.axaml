<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <PanelExt Mode="Horizontal" Spacing="12" Margin="12">
            <AutoGrid Definitions="*,*" Spacing="12">
                <TabControl TabStripPlacement="Top" BorderThickness="{ThemeThickness Normal}" CornerRadius="11">
                    <TabItem Header="TabItem 1">
                        <TextBlock Text="Content 1" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 2">
                        <TextBlock Text="Content 2" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 3">
                        <TextBlock Text="Content 3" Margin="12 50" />
                    </TabItem>
                </TabControl>
                <TabControl TabStripPlacement="Bottom" BorderThickness="{ThemeThickness Normal}" CornerRadius="11">
                    <TabItem Header="TabItem 1">
                        <TextBlock Text="Content 1" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 2">
                        <TextBlock Text="Content 2" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 3">
                        <TextBlock Text="Content 3" Margin="12 50" />
                    </TabItem>
                </TabControl>
                <TabControl TabStripPlacement="Left" BorderThickness="{ThemeThickness Normal}" CornerRadius="11">
                    <TabItem Header="TabItem 1">
                        <TextBlock Text="Content 1" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 2">
                        <TextBlock Text="Content 2" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 3">
                        <TextBlock Text="Content 3" Margin="12 50" />
                    </TabItem>
                </TabControl>
                <TabControl TabStripPlacement="Bottom" BorderThickness="{ThemeThickness Normal}" CornerRadius="11">
                    <TabItem Header="TabItem 1">
                        <TextBlock Text="Content 1" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 2">
                        <TextBlock Text="Content 2" Margin="12 50" />
                    </TabItem>
                    <TabItem Header="TabItem 3">
                        <TextBlock Text="Content 3" Margin="12 50" />
                    </TabItem>
                </TabControl>
            </AutoGrid>
        </PanelExt>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Background" Value="{ThemeBrush Background, Opacity=0}" />
        <Setter Property="BorderBrush" Value="{ThemeBrush BorderBrush}" />
        <Setter Property="Padding" Value="{ThemeThickness Normal}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <ItemsPresenter x:Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <PanelExt Mode="WrapFull" />
            </ItemsPanelTemplate>
        </Setter>
        <Style Selector="^[TabStripPlacement=Top] /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="DockPanel.Dock" Value="Top" />
        </Style>
        <Style Selector="^[TabStripPlacement=Bottom] /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="DockPanel.Dock" Value="Bottom" />
        </Style>
        <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style Selector="^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
        <Style Selector="^[TabStripPlacement=Left] /template/ ItemsPresenter#PART_ItemsPresenter > PanelExt">
            <Setter Property="Mode" Value="Vertical" />
        </Style>
        <Style Selector="^[TabStripPlacement=Right] /template/ ItemsPresenter#PART_ItemsPresenter > PanelExt">
            <Setter Property="Mode" Value="Vertical" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
