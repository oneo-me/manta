<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <PanelExt Mode="Vertical" Spacing="12" Margin="12">
            <Carousel Width="100" Height="100">
                <Carousel.PageTransition>
                    <PageSlide Duration="0:0:0.1" />
                </Carousel.PageTransition>
                <Border Background="{ThemeBrush Primary}" TextElement.Foreground="{ThemeBrush Primary_Foreground}">
                    <TextBlock Text="Page 1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="{ThemeBrush Success}" TextElement.Foreground="{ThemeBrush Success_Foreground}">
                    <TextBlock Text="Page 2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Background="{ThemeBrush Error}" TextElement.Foreground="{ThemeBrush Error_Foreground}">
                    <TextBlock Text="Page 3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Carousel>
        </PanelExt>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type Carousel}" TargetType="Carousel">
        <Setter Property="BorderBrush" Value="{ThemeBrush BorderBrush}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <ScrollViewer x:Name="PART_ScrollViewer"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              BringIntoViewOnFocusChange="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsPresenter x:Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    Margin="{TemplateBinding Padding}" />
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
