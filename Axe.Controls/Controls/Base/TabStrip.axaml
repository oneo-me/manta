<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <PanelExt Mode="Horizontal" Spacing="12" Margin="12">
            <TabStrip BorderThickness="{ThemeThickness Normal}" CornerRadius="11">
                <TabStripItem Content="TabItem 1" />
                <TabStripItem Content="TabItem 2" />
                <TabStripItem Content="TabItem 3" />
            </TabStrip>
        </PanelExt>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">
        <Setter Property="Background" Value="{ThemeBrush Background, Opacity=0}" />
        <Setter Property="BorderBrush" Value="{ThemeBrush BorderBrush}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <PanelExt Mode="WrapFull" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
