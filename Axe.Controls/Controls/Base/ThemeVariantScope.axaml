<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal">
    <Design.PreviewWith>
        <PanelExt Mode="Horizontal" Spacing="12" Margin="12">
            <ThemeVariantScope Width="100" RequestedThemeVariant="Light">
                <Panel Background="{ThemeCommonBrush Background}">
                    <TextBlock Text="TextBlock" Margin="{ThemeThickness Padding}" />
                </Panel>
            </ThemeVariantScope>
            <ThemeVariantScope Width="100" RequestedThemeVariant="Dark">
                <Panel Background="{ThemeCommonBrush Background}">
                    <TextBlock Text="TextBlock" Margin="{ThemeThickness Padding}" />
                </Panel>
            </ThemeVariantScope>
        </PanelExt>
    </Design.PreviewWith>
    <ControlTheme x:Key="{x:Type ThemeVariantScope}" TargetType="ThemeVariantScope">
        <Setter Property="TextElement.Foreground" Value="{ThemeCommonBrush Foreground}" />
    </ControlTheme>
</ResourceDictionary>
