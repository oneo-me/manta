<MView
    x:Class="MantaSample.Views.LocalizationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Manta.Globalization.Core;assembly=Manta"
    xmlns:langs="clr-namespace:MantaSample.Langs"
    xmlns:local="clr-namespace:MantaSample.Views"
    x:DataType="local:LocalizationPage_Model"
    Name="View">
    <Design.DataContext>
        <local:LocalizationPage_Model />
    </Design.DataContext>
    <MPanel Mode="Vertical" Spacing="20" Margin="24" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="{Lang {x:Static langs:LangKey.Localization_Title}}"
                   FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Lang {x:Static langs:LangKey.Localization_Description}}"
                   Foreground="{MBrush MutedForeground}" TextWrapping="Wrap" />
        <TextBlock Text="{Lang {x:Static langs:LangKey.Localization_Select}}" FontWeight="SemiBold" />
        <MItems ItemsSource="{Binding SupportedLanguages}">
            <MItems.ItemsPanel>
                <ItemsPanelTemplate>
                    <MPanel Mode="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </MItems.ItemsPanel>
            <MItems.ItemTemplate>
                <DataTemplate x:DataType="core:LangType">
                    <MButton Variant="Outline"
                             Command="{Binding ElementName=View, Path=DataContext.ChangeLanguageCommand}"
                             CommandParameter="{Binding}">
                        <MPanel Mode="Horizontal" Spacing="6">
                            <TextBlock Text="{LangEmoji {Binding}}" VerticalAlignment="Center" />
                            <TextBlock Text="{LangName {Binding}}" VerticalAlignment="Center" />
                        </MPanel>
                    </MButton>
                </DataTemplate>
            </MItems.ItemTemplate>
        </MItems>
        <MPanel Mode="Horizontal" Spacing="6">
            <TextBlock Text="{Lang {x:Static langs:LangKey.Localization_Current}}" />
            <TextBlock Text="{LangName {Binding CurrentLanguage}}" />
        </MPanel>
    </MPanel>
</MView>
