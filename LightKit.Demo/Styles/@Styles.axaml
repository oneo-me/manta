<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="ListBox.DemoGroupList">
        <Setter Property="Padding" Value="12" />
        <Style Selector="^ ListBoxItem">
            <Setter Property="Margin" Value="0 0 0 2" />
            <Setter Property="Padding" Value="12 9" />
            <Setter Property="CornerRadius" Value="{ThemeRadius LG}" />
            <Setter Property="Background" Value="{ThemeBrush Foreground, Opacity=0}" />
            <Style Selector="^:selected">
                <Setter Property="Background" Value="{ThemeBrush Foreground, Opacity=0.1}" />
            </Style>
            <Style Selector="^:pointerover:not(:selected)">
                <Setter Property="Background" Value="{ThemeBrush Foreground, Opacity=0.05}" />
            </Style>
            <Style Selector="^:nth-last-child(1)">
                <Setter Property="Margin" Value="0" />
            </Style>
        </Style>
    </Style>
    <Style Selector="LightPanel.DemoPan">
        <Setter Property="Mode" Value="Vertical" />
        <Setter Property="Spacing" Value="24" />
        <Setter Property="Margin" Value="24" />
    </Style>
    <Style Selector="LightPanel.DemoPanChild">
        <Setter Property="Mode" Value="Vertical" />
        <Setter Property="Spacing" Value="12" />
    </Style>
    <Style Selector="TextBlock.DemoInfo">
        <Setter Property="FontWeight" Value="{ThemeFontWeight Semibold}" />
    </Style>
    <Style Selector="Run.DemoInfoKey">
        <Setter Property="FontWeight" Value="{ThemeFontWeight Semibold}" />
    </Style>
</Styles>
