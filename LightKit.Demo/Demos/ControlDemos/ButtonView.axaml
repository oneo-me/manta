<LightView
    x:Class="LightKit.Demo.Demos.ControlDemos.ButtonView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Demos.ControlDemos"
    x:DataType="local:ButtonView_Model" Design.DataContext="{x:Static local:ButtonView_Model.Design}">
    <LightScrollViewer HorizontalScrollBarVisibility="Auto">
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <LightText Text="Buttons" FontWeight="SemiBold" />
            <LightPanel Mode="Horizontal" Spacing="12">
                <LightButton Content="Button" Type="Filled" Size="Small" />
                <LightButton Content="Button" Type="Outlined" Size="Small" />
                <LightButton Content="Button" Type="Ghost" Size="Small" />
            </LightPanel>
            <LightPanel Mode="Horizontal" Spacing="12">
                <LightButton Content="Button" Type="Filled" Size="Normal" />
                <LightButton Content="Button" Type="Outlined" Size="Normal" />
                <LightButton Content="Button" Type="Ghost" Size="Normal" />
            </LightPanel>
            <LightPanel Mode="Horizontal" Spacing="12" Theme.ColorScheme="Primary">
                <LightButton Content="Button" Type="Filled" Size="Small" />
                <LightButton Content="Button" Type="Outlined" Size="Small" />
                <LightButton Content="Button" Type="Ghost" Size="Small" />
            </LightPanel>
            <LightPanel Mode="Horizontal" Spacing="12" Theme.ColorScheme="Success">
                <LightButton Content="Button" Type="Filled" Size="Small" />
                <LightButton Content="Button" Type="Outlined" Size="Small" />
                <LightButton Content="Button" Type="Ghost" Size="Small" />
            </LightPanel>
            <LightPanel Mode="Horizontal" Spacing="12" Theme.ColorScheme="Warning">
                <LightButton Content="Button" Type="Filled" Size="Small" />
                <LightButton Content="Button" Type="Outlined" Size="Small" />
                <LightButton Content="Button" Type="Ghost" Size="Small" />
            </LightPanel>
            <LightPanel Mode="Horizontal" Spacing="12" Theme.ColorScheme="Danger">
                <LightButton Content="Button" Type="Filled" Size="Small" />
                <LightButton Content="Button" Type="Outlined" Size="Small" />
                <LightButton Content="Button" Type="Ghost" Size="Small" />
            </LightPanel>
            <LightText Text="Custom Icons" FontWeight="SemiBold" />
            <LightPanel Mode="Horizontal" Spacing="12">
                <LightButton Type="Filled" Size="Small">
                    <LightPanel Mode="Horizontal" Spacing="4">
                        <LightIcon IconSize="14" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        <LightText Text="Button" VerticalAlignment="Center" />
                    </LightPanel>
                </LightButton>
                <LightButton Type="Outlined" Size="Small">
                    <LightPanel Mode="Horizontal" Spacing="4">
                        <LightIcon IconSize="14" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        <LightText Text="Button" VerticalAlignment="Center" />
                    </LightPanel>
                </LightButton>
                <LightButton Type="Ghost" Size="Small">
                    <LightPanel Mode="Horizontal" Spacing="4">
                        <LightIcon IconSize="14" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        <LightText Text="Button" VerticalAlignment="Center" />
                    </LightPanel>
                </LightButton>
            </LightPanel>
            <LightPanel Mode="Horizontal" Spacing="12">
                <LightButton Type="Filled" Size="Normal">
                    <LightPanel Mode="Horizontal" Spacing="4">
                        <LightIcon IconSize="14" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        <LightText Text="Button" VerticalAlignment="Center" />
                    </LightPanel>
                </LightButton>
                <LightButton Type="Outlined" Size="Normal">
                    <LightPanel Mode="Horizontal" Spacing="4">
                        <LightIcon IconSize="14" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        <LightText Text="Button" VerticalAlignment="Center" />
                    </LightPanel>
                </LightButton>
                <LightButton Type="Ghost" Size="Normal">
                    <LightPanel Mode="Horizontal" Spacing="4">
                        <LightIcon IconSize="14" IconSource="{Binding TestIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        <LightText Text="Button" VerticalAlignment="Center" />
                    </LightPanel>
                </LightButton>
            </LightPanel>
        </LightPanel>
    </LightScrollViewer>
</LightView>
