<LightView
    x:Class="LightKit.Demo.Demos.ControlDemos.SelectableTextView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Demos.ControlDemos"
    x:DataType="local:SelectableTextView_Model" Design.DataContext="{x:Static local:SelectableTextView_Model.Design}">
    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <LightPanel Mode="Vertical" Spacing="12" Margin="12">
            <LightSelectableText Theme.TextSize="ExtraSmall" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="Small" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="Normal" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="Large" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="ExtraLarge" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="ExtraLarge2" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="ExtraLarge3" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="ExtraLarge4" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="ExtraLarge5" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="ExtraLarge6" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="ExtraLarge7" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="ExtraLarge8" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
            <LightSelectableText Theme.TextSize="ExtraLarge9" Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
        </LightPanel>
    </ScrollViewer>
</LightView>
