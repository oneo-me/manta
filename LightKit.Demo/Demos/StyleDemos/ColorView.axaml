<LightView
    x:Class="LightKit.Demo.Demos.StyleDemos.ColorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Demos.StyleDemos"
    x:DataType="local:ColorView_Model" Design.DataContext="{x:Static local:ColorView_Model.Design}">
    <LightView.Styles>
        <Style Selector="LightPanel.CompactColors">
            <Setter Property="Mode" Value="Vertical" />
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="Grid.ColorBoxs">
            <Style Selector="^ TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0 0 12 0" />
            </Style>
            <Style Selector="^ LightPanel">
                <Setter Property="Spacing" Value="6" />
                <Setter Property="Mode" Value="Horizontal" />
            </Style>
            <Style Selector="^ Border">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="26" />
                <Setter Property="CornerRadius" Value="{ThemeRadius SM}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Style>
    </LightView.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <LightPanel Classes="DemoPan" Grid.IsSharedSizeScope="True">
            <TextBlock Classes="DemoInfo" Text="Refs" />
            <LightPanel Classes="CompactColors">
                <Grid Classes="ColorBoxs">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Refs" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Background" />
                    <LightPanel Grid.Column="1">
                        <Border Background="{ThemeBrush Background}" />
                    </LightPanel>
                </Grid>
                <Grid Classes="ColorBoxs">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Refs" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Primary" />
                    <LightPanel Grid.Column="1">
                        <Border Background="{ThemeBrush Primary}" />
                        <Border Background="{ThemeBrush Primary_Foreground}" />
                    </LightPanel>
                </Grid>
                <Grid Classes="ColorBoxs">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Refs" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Success" />
                    <LightPanel Grid.Column="1">
                        <Border Background="{ThemeBrush Success}" />
                        <Border Background="{ThemeBrush Success_Foreground}" />
                    </LightPanel>
                </Grid>
                <Grid Classes="ColorBoxs">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Refs" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Warning" />
                    <LightPanel Grid.Column="1">
                        <Border Background="{ThemeBrush Warning}" />
                        <Border Background="{ThemeBrush Warning_Foreground}" />
                    </LightPanel>
                </Grid>
                <Grid Classes="ColorBoxs">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Refs" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Error" />
                    <LightPanel Grid.Column="1">
                        <Border Background="{ThemeBrush Error}" />
                        <Border Background="{ThemeBrush Error_Foreground}" />
                    </LightPanel>
                </Grid>
            </LightPanel>
            <TextBlock Classes="DemoInfo" Text="Base" />
            <LightPanel Classes="CompactColors">
                <Grid Classes="ColorBoxs">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Base" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Black" />
                    <LightPanel Grid.Column="1">
                        <Border Background="{ThemeBrush Black}" />
                    </LightPanel>
