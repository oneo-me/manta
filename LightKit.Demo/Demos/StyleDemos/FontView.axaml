<View
    x:Class="LightKit.Demo.Demos.StyleDemos.FontView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Demos.StyleDemos"
    x:DataType="local:FontView_Model" Design.DataContext="{x:Static local:FontView_Model.Design}">
    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <PanelExt Classes="DemoPan">
            <TextBlock Classes="DemoInfo" Text="FontSpacings" />
            <PanelExt Classes="DemoPanChild">
                <TextBlock LetterSpacing="{ThemeFontSpacing Tighter}">
                    <Run Classes="DemoInfoKey" Text="Tighter: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock LetterSpacing="{ThemeFontSpacing Tight}">
                    <Run Classes="DemoInfoKey" Text="Tight: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock LetterSpacing="{ThemeFontSpacing Normal}">
                    <Run Classes="DemoInfoKey" Text="Normal: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock LetterSpacing="{ThemeFontSpacing Wide}">
                    <Run Classes="DemoInfoKey" Text="Wide: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock LetterSpacing="{ThemeFontSpacing Wider}">
                    <Run Classes="DemoInfoKey" Text="Wider: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock LetterSpacing="{ThemeFontSpacing Widest}">
                    <Run Classes="DemoInfoKey" Text="Widest: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
            </PanelExt>
            <TextBlock Classes="DemoInfo" Text="FontWeights" />
            <PanelExt Classes="DemoPanChild">
                <TextBlock FontWeight="{ThemeFontWeight Thin}">
                    <Run Classes="DemoInfoKey" Text="Thin: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontWeight="{ThemeFontWeight Extralight}">
                    <Run Classes="DemoInfoKey" Text="Extralight: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontWeight="{ThemeFontWeight Light}">
                    <Run Classes="DemoInfoKey" Text="Light: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontWeight="{ThemeFontWeight Normal}">
                    <Run Classes="DemoInfoKey" Text="Normal: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontWeight="{ThemeFontWeight Medium}">
                    <Run Classes="DemoInfoKey" Text="Medium: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontWeight="{ThemeFontWeight Semibold}">
                    <Run Classes="DemoInfoKey" Text="Semibold: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontWeight="{ThemeFontWeight Bold}">
                    <Run Classes="DemoInfoKey" Text="Bold: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontWeight="{ThemeFontWeight Extrabold}">
                    <Run Classes="DemoInfoKey" Text="Extrabold: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontWeight="{ThemeFontWeight Black}">
                    <Run Classes="DemoInfoKey" Text="Black: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
            </PanelExt>
            <TextBlock Classes="DemoInfo" Text="FontSizes" />
            <PanelExt Classes="DemoPanChild">
                <TextBlock FontSize="{ThemeFontSize SM}" LineHeight="{ThemeFontHeight SM}">
                    <Run Classes="DemoInfoKey" Text="SM: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize Base}" LineHeight="{ThemeFontHeight Base}">
                    <Run Classes="DemoInfoKey" Text="Base: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize LG}" LineHeight="{ThemeFontHeight LG}">
                    <Run Classes="DemoInfoKey" Text="LG: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize XL}" LineHeight="{ThemeFontHeight XL}">
                    <Run Classes="DemoInfoKey" Text="XL: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize XL2}" LineHeight="{ThemeFontHeight XL2}">
                    <Run Classes="DemoInfoKey" Text="XL2: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize XL3}" LineHeight="{ThemeFontHeight XL3}">
                    <Run Classes="DemoInfoKey" Text="XL3: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize XL4}" LineHeight="{ThemeFontHeight XL4}">
                    <Run Classes="DemoInfoKey" Text="XL4: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize XL5}" LineHeight="{ThemeFontHeight XL5}">
                    <Run Classes="DemoInfoKey" Text="XL5: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize XL6}" LineHeight="{ThemeFontHeight XL6}">
                    <Run Classes="DemoInfoKey" Text="XL6: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize XL7}" LineHeight="{ThemeFontHeight XL7}">
                    <Run Classes="DemoInfoKey" Text="XL7: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize XL8}" LineHeight="{ThemeFontHeight XL8}">
                    <Run Classes="DemoInfoKey" Text="XL8: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
                <TextBlock FontSize="{ThemeFontSize XL9}" LineHeight="{ThemeFontHeight XL9}">
                    <Run Classes="DemoInfoKey" Text="XL9: " />
                    <Run Text="{Lang {x:Static LangKey.Demo_Style_Font_TestText}}" />
                </TextBlock>
            </PanelExt>
        </PanelExt>
    </ScrollViewer>
</View>
