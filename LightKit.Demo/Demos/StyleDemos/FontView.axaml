<LightView
    x:Class="LightKit.Demo.Demos.StyleDemos.FontView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Demos.StyleDemos"
    x:DataType="local:FontView_Model" Design.DataContext="{x:Static local:FontView_Model.Design}">
    <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <LightPanel Classes="DemoPan" />
    </ScrollViewer>
</LightView>
