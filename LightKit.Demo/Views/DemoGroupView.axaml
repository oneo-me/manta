<LightView
    x:Class="LightKit.Demo.Views.DemoGroupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Views"
    x:DataType="local:DemoGroupView_Model" Design.DataContext="{x:Static local:DemoGroupView_Model.Design}">
    <Grid ColumnDefinitions="200 1 *">
        <LightListBox Grid.Column="0" Type="Sidebar" ItemsSource="{Binding Demos}" SelectedItem="{Binding CurrentDemo}">
            <LightListBox.Styles>
                <Style Selector="LightListBoxItem">
                    <Setter Property="IsEnabled" Value="{Binding !IsGroup}" x:DataType="local:IDemoItem" />
                    <Style Selector="^:disabled">
                        <Setter Property="Padding" Value="0 6" />
                        <Setter Property="Opacity" Value="0.5" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </Style>
            </LightListBox.Styles>
            <LightListBox.DataTemplates>
                <DataTemplate DataType="local:DemoGroupItem">
                    <LightText Text="{Lang {Binding GroupName}}" />
                </DataTemplate>
                <DataTemplate DataType="local:DemoItem">
                    <LightPanel Mode="Horizontal" Spacing="8">
                        <LightIcon Opacity="0.8" IconSize="16" IconStyle="OnlyBorder" IconSource="{Binding ViewModel.Icon}" Margin="0 -10" VerticalAlignment="Center"
                                   IsVisible="{Binding ViewModel.Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <LightText Text="{Lang {Binding ViewModel.Header}}" VerticalAlignment="Center" />
                    </LightPanel>
                </DataTemplate>
            </LightListBox.DataTemplates>
        </LightListBox>
        <Panel Grid.Column="1" Background="{ThemeColorSet BorderBrush}" Margin="0 12" />
        <LightViewHost Grid.Column="2" ViewModel="{Binding CurrentViewModel}" />
    </Grid>
</LightView>
