<LightView
    x:Class="LightKit.Demo.Views.OverviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Views"
    x:DataType="local:OverviewView_Model" Design.DataContext="{x:Static local:OverviewView_Model.Design}"
    x:Name="View">
    <LightView.Styles>
        <Style Selector="Button.Button">
            <Setter Property="Padding" Value="12 6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeBrush BorderBrush}" />
            <Setter Property="CornerRadius" Value="{ThemeRadius MD}" />
            <Setter Property="Background" Value="{ThemeBrush Primary, Opacity=0.1}" />
            <Setter Property="Foreground" Value="{ThemeBrush Foreground}" />
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="{ThemeBrush Primary}" />
                <Setter Property="Background" Value="{ThemeBrush Primary, Opacity=0.6}" />
                <Setter Property="Foreground" Value="{ThemeBrush Primary_Foreground}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="BorderBrush" Value="{ThemeBrush Primary, Opacity=0.8}" />
                <Setter Property="Background" Value="{ThemeBrush Primary, Opacity=0.3}" />
            </Style>
        </Style>
    </LightView.Styles>
    <LightPanel Mode="Vertical" Spacing="12" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="{Lang {x:Static LangKey.Title}}" HorizontalAlignment="Center"
                   FontWeight="{ThemeFontWeight Extralight}" />
        <TextBlock Text="{Lang {x:Static LangKey.Description}}" />
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <LightPanel Mode="Horizontal" Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Classes="Button" Content="{Lang {Binding Header}}"
                            Command="{Binding ElementName=View, Path=DataContext.OpenRegion}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding SupportedLanguages}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <LightPanel Mode="Horizontal" Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Classes="Button"
                            Command="{Binding ElementName=View, Path=DataContext.ChangeLanguage}"
                            CommandParameter="{Binding}">
                        <LightPanel Mode="Horizontal" Spacing="6">
                            <TextBlock Text="{LangEmoji {Binding}}" VerticalAlignment="Center" />
                            <TextBlock Text="{LangName {Binding}}" VerticalAlignment="Center" />
                        </LightPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </LightPanel>
</LightView>
