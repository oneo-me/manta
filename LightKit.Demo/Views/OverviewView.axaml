<LightView
    x:Class="LightKit.Demo.Views.OverviewView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Views"
    x:DataType="local:OverviewView_Model" Design.DataContext="{x:Static local:OverviewView_Model.Design}"
    x:Name="View">
    <LightPanel Mode="Vertical" Spacing="12" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <LightText Text="{Lang {x:Static LangKey.Title}}" FontWeight="ExtraLight" Custom="ExtraLarge6" HorizontalAlignment="Center" />
        <LightText Text="{Lang {x:Static LangKey.Description}}" />
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <LightPanel Mode="Horizontal" Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <LightButton Custom="Filled" Size="Small" Theme.ColorScheme="Primary"
                                 Content="{Lang {Binding Header}}"
                                 Command="{Binding ElementName=View, Path=DataContext.OpenRegion}"
                                 CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding SupportedLanguages}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <LightPanel Mode="Horizontal" Spacing="12" HorizontalAlignment="Center" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <LightButton Custom="Outlined" Size="Small"
                                 Command="{Binding ElementName=View, Path=DataContext.ChangeLanguage}"
                                 CommandParameter="{Binding}">
                        <LightPanel Mode="Horizontal" Spacing="6">
                            <LightText Text="{LangEmoji {Binding}}" VerticalAlignment="Center" />
                            <LightText Text="{LangName {Binding}}" VerticalAlignment="Center" />
                        </LightPanel>
                    </LightButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </LightPanel>
</LightView>
