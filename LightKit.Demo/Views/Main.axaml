<LightView
    x:Class="LightKit.Demo.Views.Main"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Views"
    x:DataType="local:Main_Model" Design.DataContext="{x:Static local:Main_Model.Design}">
    <Grid RowDefinitions="Auto *">
        <LightViewHost Grid.Row="1" Background="{ThemeColorSet Background}" ViewModel="{Binding RegionManager.SelectedItem}" />
        <Border Grid.Row="0" x:Name="TitleBar" Background="{ThemeColorSet Primary, Opacity=0.03}" BorderBrush="{ThemeColorSet BorderBrush}" BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="* Auto Auto">
                <LightTabStrip Grid.Column="0" Custom="RootTab" ItemsSource="{Binding RegionManager.Items}" SelectedItem="{Binding RegionManager.SelectedItem}">
                    <LightTabStrip.ItemTemplate>
                        <DataTemplate>
                            <LightPanel Mode="Horizontal" Spacing="8">
                                <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding Icon}" Margin="0 -10" VerticalAlignment="Center" />
                                <LightText Text="{Lang {Binding Header}}" VerticalAlignment="Center" />
                            </LightPanel>
                        </DataTemplate>
                    </LightTabStrip.ItemTemplate>
                </LightTabStrip>
                <LightPanel Grid.Column="1" Mode="Horizontal">
                    <LightTitleBarButton>
                        <LightPanel Mode="Horizontal" Spacing="8">
                            <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding ThemeSystemIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </LightPanel>
                    </LightTitleBarButton>
                    <LightTitleBarButton Command="{Binding OpenSettings}">
                        <LightPanel Mode="Horizontal" Spacing="8">
                            <LightIcon Theme.ColorScheme="Primary" IconSize="18" IconSource="{Binding SettingsIcon}" Margin="0 -10" VerticalAlignment="Center" />
                        </LightPanel>
                    </LightTitleBarButton>
                </LightPanel>
                <LightTitleBarButtons x:Name="TitleBarButtons" Grid.Column="2" />
            </Grid>
        </Border>
    </Grid>
</LightView>
