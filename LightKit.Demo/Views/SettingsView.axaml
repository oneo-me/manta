<LightView
    x:Class="LightKit.Demo.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:LightKit.Demo.Views"
    x:DataType="local:SettingsView_Model" Design.DataContext="{x:Static local:SettingsView_Model.Design}">
    <LightPanel Mode="Vertical" Spacing="18" Margin="18">
        <LightText Text="{Lang {Binding Title}}" />
        <LightPanel Mode="Horizontal" Spacing="18">
            <LightText Text="{Lang {Binding Title}}" />
            <LightText Text="{Lang {Binding Title}}" />
            <LightText Text="{Lang {Binding Title}}" />
        </LightPanel>
    </LightPanel>
</LightView>
